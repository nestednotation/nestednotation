#!/usr/bin/env node

/**
 * Module dependencies.
 */

const app = require("../app");
const debug = require("debug")("first-app:server");
const http = require("http");
const WebSocketServer = require("websocket").server;
const fs = require("fs");
const os = require("os");
const BMDatabase = require("../database.js");
const { MESSAGES } = require("../constants.js");
// Session Lines: pure connection routing (line selection / late-join policy).
// Two filtered views, and the difference matters: POPULATION is who can act on
// a line — every count, tally, wait and membership decision runs over that, so
// it excludes both map-view tabs and riders (spectators, owner) — while
// `performerLineConnections` keeps riders and exists for the display counts
// the operator reads.
const {
  lineConnections,
  performerLineConnections,
  populationLineConnections,
  isSpectatorConn,
  isBoundToSession,
  canPerform,
  smallestLineId,
  spectatorLandingLineId,
  lineIdNum,
  lastVacatedLineId,
} = require("../lib/session-lines/routing");
// Session Lines: orchestration (split / barrier / rejoin / track-group). All of
// this is inert unless session.hasSessionLines.
const { createOrchestrator } = require("../lib/session-lines/orchestrator");
const {
  BMLine,
  landingHoldElapsed,
  holdPendingAtFrame,
} = require("../lib/session-lines/line");
const {
  structuralEventSummaries,
  structuralProjectionKey,
  structuralProjectionVersion,
} = require("../lib/session-lines/map-payload");
const { buildAdminSnapshots } = require("../lib/session-lines/admin-snapshot");

let prefixDir = ".";
const testPrefixFile = prefixDir + "/account/admin.dat";
if (!fs.existsSync(testPrefixFile)) {
  prefixDir = "..";
}

const accountDir = prefixDir + "/account";
const env = process.env.NODE_ENV || "development";
let hostaddress = "nestednotation.com";
if (env == "development") {
  require("dotenv").config({
    path: ".env.development",
  });
} else {
  require("dotenv").config({
    path: ".env.production",
  });
}
/**
 * Get port from environment and store in Express.
 */
//sudo iptables -t nat -A PREROUTING -p tcp --dport 80 -j REDIRECT --to-ports 3000

var port = normalizePort(process.env.PORT || "3000");
var networkInterfaces = os.networkInterfaces();

if (typeof networkInterfaces["en0"] !== "undefined") {
  var listInterfaces = networkInterfaces["en0"];
  if (listInterfaces.length > 1) {
    for (var i = 0; i < listInterfaces.length; i++) {
      var candidate = listInterfaces[i]["address"];
      if (candidate.startsWith("192.168")) {
        hostaddress = candidate;
      }
    }
  }
}

app.set("port", port);

//networkInterfaces['en0'][1]['address'];
console.log("myip = " + hostaddress);
/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  const bind = typeof port === "string" ? `Pipe ${port}` : `Port ${port}`;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(`${bind} requires elevated privileges`);
      process.exit(1);
    case "EADDRINUSE":
      console.error(`${bind} is already in use`);
      process.exit(1);
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  const addr = server.address();
  const bind = typeof addr === "string" ? `pipe ${addr}` : `port ${addr.port}`;
  debug(`Listening on ${bind}`);
}

/**
 * Websocket
 */
const httpServerForSocket = http.createServer();
httpServerForSocket.listen(process.env.WS_PORT);

console.log(`Websocket is running on port ${process.env.WS_PORT}`);

// Liveness: the websocket package's own protocol keepalive, spelled out rather
// than inherited so a dependency bump cannot quietly change it. Ping a
// connection after 20s of silence, drop it if no pong arrives within 10s — a
// peer that stops answering leaves wsServer.connections (and runs the close
// handler below) in ~30s. It cannot see a tab frozen into the back/forward
// cache, whose NETWORK STACK answers the ping while its JS is suspended; that
// one is closed at the source by the pagehide handler in ws-client.js.
const wsServer = new WebSocketServer({
  httpServer: httpServerForSocket,
  keepalive: true,
  keepaliveInterval: 20000,
  dropConnectionOnKeepaliveTimeout: true,
  keepaliveGracePeriod: 10000,
});

wsServer.on("request", function (request) {
  const connection = request.accept(null, request.origin);
  connection.lastSeen = Date.now();

  connection.on("message", function (message) {
    // messageHandle is async — an uncaught throw would be an unhandled
    // rejection (fatal on Node >= 15), taking the whole server down.
    messageHandle(connection, message).catch((e) =>
      console.error("messageHandle error", e),
    );
  });

  connection.on("close", function () {
    const session = db.sessionTable.getById(connection.sessionId);
    if (session) {
      // Session Lines: a line that just lost its last device goes dormant and
      // releases any barrier waiting on it (#11). No-op for vanilla scores.
      session
        .runExclusively(async () => {
          await handleConnectionClose(session, connection);
          updateNumberOfConnectionForSession(session);
        })
        .catch((e) => console.error("handleConnectionClose error", e));
    }
  });
});

// ── Display revisions ────────────────────────────────────────────────────────
// A display message can be scheduled for the FUTURE (`t`), and the client
// honours that by holding it in a timer. Between the send and the fire the
// room can move: a rewind repositions the line, a dive changes which frame
// list the index resolves against, a reconnect answers with a fresh snapshot.
// The held message then arrived last and won, overwriting a display the server
// had already corrected — a performer showing the frame they were rewound off,
// or resolving a main-flow index against a sub's frames.
//
// So every message that DRIVES a line's display carries `dr`, a number that
// only goes up, and the client applies one only if it is at least the last one
// it applied (`displayRevOk`). A socket generation cannot do this job: a
// rewind and its stale SHOW live on the same socket.
//
// ONE sequence for the whole process, not one per line. A device changes
// lines — a split hands it a fresh child, a merge a survivor, a structural
// undo its restored line — and a per-line counter numbered each line's
// messages from wherever that line happened to be. A device that had applied
// revision 20 on L0 and was split onto a new L1 rejected L1's revisions 1…19
// as stale: frames and snapshots alike, until the new counter caught up. One
// sequence keeps every message ordered against every other, whichever line
// sent it.
//
// Ordering alone does not retire what the OLD line already queued for this
// device: that message is older than anything the new line sends, but nothing
// newer may have been applied yet when its timer fires. So the assignment is a
// display message too (MSG_LINE_ASSIGNED, MSG_BEGIN_SPLIT), and a device whose
// line CHANGES takes the assignment's revision as its floor — everything the
// previous line had queued is below it. A device told the id it already has (a
// merge survivor) keeps its floor, and its own line's queued frame with it.
//
// MSG_PAUSE is one because it paints: the placeholder replaces the frame. An
// unrevisioned pause let the SHOW an advance had queued for the preload
// deadline land after it and put the frame back up in a paused room.
//
// Allocated at send time, which is when the server decides the transition —
// sends are issued in causal order, so the numbers are too. It rides on the
// SEND helpers rather than the call sites, because the one that gets
// forgotten is the one that breaks it. Not persisted: a restart closes every
// socket, and a new socket is a new epoch on the client (`resetDisplayEpoch`).
const DISPLAY_MESSAGES = new Set([
  MESSAGES.MSG_SHOW,
  MESSAGES.MSG_SUB_ENTER,
  MESSAGES.MSG_SUB_EXIT,
  MESSAGES.MSG_PAUSE,
  MESSAGES.MSG_LINE_ASSIGNED,
  MESSAGES.MSG_BEGIN_SPLIT,
]);
let displayRevCounter = 0;

// The messages that say WHICH SCORE a frame index belongs to, and so carry the
// line's dive context (`ctx`, `orch.diveContextKey`). The page reports back
// the context it is displaying on every tap, and MSG_TAP refuses a tap whose
// context is not the line's: an index and a filename alone cannot tell a main
// score's START.svg from its sub's.
const CONTEXT_MESSAGES = new Set([
  MESSAGES.MSG_SHOW,
  MESSAGES.MSG_SUB_ENTER,
  MESSAGES.MSG_SUB_EXIT,
  MESSAGES.MSG_PAUSE,
]);

function stampDisplayRev(session, lineId, payload) {
  if (!payload || !DISPLAY_MESSAGES.has(payload.m)) {
    return payload;
  }
  displayRevCounter += 1;
  const stamped = { ...payload, dr: displayRevCounter };
  if (session.hasSessionLines && CONTEXT_MESSAGES.has(payload.m)) {
    const line = (session.lines || []).find((l) => l && l.id === lineId);
    if (line) {
      stamped.ctx = orch.diveContextKey(line.subStack);
    }
  }
  return stamped;
}

//time = 0 => immediately
function sendToClient(conn, time, payload) {
  conn.sendUTF(
    JSON.stringify({
      t: time,
      ...payload,
    }),
  );
}

// …and the same, for the display messages a single connection is addressed
// with (a reconnect's snapshot, a structural gesture's per-device drive).
function sendDisplayToClient(session, conn, time, payload) {
  sendToClient(conn, time, stampDisplayRev(session, conn.lineId, payload));
}

// Encode a broadcast once. Structural map updates can be large, and encoding
// the same object independently for every open admin tab multiplied the CPU
// cost by the number of operators watching the room.
function sendToConnections(connections, time, payload) {
  if (!connections.length) return;
  const encoded = JSON.stringify({
    t: time,
    ...payload,
  });
  for (const conn of connections) conn.sendUTF(encoded);
}

function sendToAllClients(session, time, payload) {
  sendToConnections(
    wsServer.connections.filter((conn) => conn.sessionId === session.id),
    time,
    payload,
  );
}

// A score replacement collapses the room to its fresh L0 line. The durable
// registry is intentionally cleared by BMSession.resetForScoreChange; live
// sockets also need their transient address cleared immediately so a tap sent
// before their reload/re-PING is counted on L0 rather than an obsolete line.
function resetSessionConnections(session) {
  for (const conn of wsServer.connections) {
    if (conn.sessionId === session.id) {
      conn.lineId = session.lines[0].id;
      conn.currentVoteTo = -1;
    }
  }
}

function sendToAllClientsWithDelay(session, timeDelay, payload) {
  const time = new Date().getTime() + timeDelay;
  sendToAllClients(session, time, payload);
}

function sendToAllAdmins(session, time, payload) {
  sendToConnections(
    wsServer.connections.filter(
      (conn) => conn.sessionId === session.id && conn.isAdmin,
    ),
    time,
    payload,
  );
}

// ── Session Lines: per-line messaging ────────────────────────────────────────
// Same as sendToAllClients/sendToAllAdmins, but addressed to one line's
// connections (conn.lineId === lineId). With a single line every connection is
// on L0, so these reduce to the session-wide sends above.

function sendToLine(session, lineId, time, payload) {
  const obj = {
    t: time,
    ...stampDisplayRev(session, lineId, payload),
  };
  wsServer.connections.forEach(function each(conn) {
    if (conn.sessionId === session.id && conn.lineId === lineId) {
      conn.sendUTF(JSON.stringify(obj));
    }
  });
}

function sendToLineWithDelay(session, lineId, timeDelay, payload) {
  const time = new Date().getTime() + timeDelay;
  sendToLine(session, lineId, time, payload);
}

function sendToLineAdmins(session, lineId, time, payload) {
  const obj = {
    t: time,
    ...payload,
  };
  wsServer.connections.forEach(function each(conn) {
    if (
      conn.sessionId === session.id &&
      conn.lineId === lineId &&
      conn.isAdmin
    ) {
      conn.sendUTF(JSON.stringify(obj));
    }
  });
}

// Resolve the line a connection currently belongs to. Never resolves to a
// hard-retired line (rejoin-absorbed, or a split parent kept for an undo,
// decision #13) — falls back to the first assignable line (with one line this
// is always lines[0]).
function lineForConn(session, conn) {
  const line = session.lines.find((l) => l.id === conn.lineId);
  if (line && line.status !== "retired") {
    return line;
  }
  return (
    session.lines.find((l) => l.status === "active") ||
    session.lines.find((l) => l.status !== "retired") ||
    session.lines[0]
  );
}

// Bind a connection to its line + device id. Restores a known device's line via
// deviceRegistry; otherwise assigns the smallest live-or-dormant line (#13).
// With one line this always resolves to lines[0].
async function ensureLineAssignment(session, conn, deviceId) {
  if (deviceId) {
    conn.deviceId = deviceId;
  }

  // A spectator (a /map tab, or a RIDER — a session page opened with no
  // password) is not a device of the room: it leaves no registry entry, so
  // there is nothing to look up for it either.
  const spectator = isSpectatorConn(conn);
  let lineId =
    deviceId && !spectator ? session.deviceRegistry[deviceId] : conn.lineId;
  let line = lineId ? session.lines.find((l) => l.id === lineId) : null;

  // Never (re)bind to a hard-retired line (rejoin-absorbed, decision #13) —
  // e.g. a registry entry left by a merge this device slept through. Fall
  // through to the normal assignment policy.
  if (line && line.status === "retired") {
    line = null;
  }
  // …and a spectator is never bound to a line that is not ACTIVE (owner). It
  // cannot tap, so a dormant line it landed on would never wake up under it:
  // "a spectator should only be able to view active lines/nodes". The same
  // rule re-homes it if the line it is watching goes dormant later
  // (finalizeAttrition).
  if (spectator && line && line.status !== "active") {
    line = null;
  }

  if (!line && spectator) {
    lineId = spectatorLandingLineId(
      session.lines,
      wsServer.connections,
      session.id,
    );
    line = lineId ? session.lines.find((l) => l.id === lineId) : null;
  }
  if (!line) {
    // Balance over population only — spectators don't occupy a line. (A
    // spectator reaches this only when the room has no active line at all,
    // and then there is nothing live for it to watch anyway.)
    const population = wsServer.connections.filter((c) => !isSpectatorConn(c));
    // Nobody is playing: wake the line the room left LAST (see
    // lastVacatedLineId) rather than the lowest-numbered husk.
    const vacated = session.lines.some((l) => l.status === "active")
      ? null
      : lastVacatedLineId(session.lines);
    lineId = vacated || smallestLineId(session.lines, population, session.id);
    line = lineId ? session.lines.find((l) => l.id === lineId) : null;
    // A dormant line is always the smallest (0 devices), so #13 hands newcomers
    // the dead paths first — but only a revival that puts a line somewhere the
    // room is NOT already standing brings a path back. Reviving one onto an
    // occupied frame just doubles a line that already exists, which is what the
    // owner saw after a finished score: three players joined a room sitting on
    // `END` and the map drew three separate lines on it. Then the newcomer
    // balances across the ACTIVE lines instead, which is where the owner wants
    // late joiners anyway — spread over the room so every one of them can still
    // reach the point it has got to.
    if (line && line.status === "dormant" && revivalAddsNoPath(session, line)) {
      const liveId = smallestLineId(
        session.lines.filter((l) => l.status === "active"),
        population,
        session.id,
      );
      const live = liveId ? session.lines.find((l) => l.id === liveId) : null;
      if (live) {
        lineId = liveId;
        line = live;
      }
    }
  }
  if (!line) {
    line =
      session.lines.find((l) => l.status !== "retired") || session.lines[0];
    lineId = line.id;
  }

  conn.lineId = lineId;
  // A spectator is an observer: binding it must not keep the line alive
  // (attrition), revive a dormant line, or trigger adoption parking — and it
  // must leave NO PERSISTED trace either, hence the return BEFORE the registry
  // write. `conn.lineId` above is just an address to send to and dies with the
  // socket; a registry entry would outlive it in saved state, and a split's
  // offline-device sweep (applySplit) would then treat the observer as a real
  // device, spending one child's balancing slot on a tab that never plays. A
  // refreshed map tab simply re-binds via smallestLineId, which is free: the
  // map renders the room from the broadcast lines[] snapshot, not from its own
  // line's messages; a refreshed RIDER re-binds via spectatorLandingLineId,
  // which is the point — the room may have moved on, and a spectator follows
  // the room rather than owning a seat in it.
  if (spectator) {
    return line;
  }
  // A NEW or moved entry is written out now: it used to wait for the next
  // unrelated save, so a joiner who arrived just before a restart was known to
  // the room only in memory and came back as a stranger.
  const registryChanged =
    !!deviceId && session.deviceRegistry[deviceId] !== lineId;
  if (deviceId) {
    session.deviceRegistry[deviceId] = lineId;
  }
  // A device claimed the line again — cancel any pending attrition grace timer.
  cancelAttritionTimer(line);
  const hadDevices =
    populationLineConnections(wsServer.connections, session.id, lineId).filter(
      (c) => c !== conn,
    ).length > 0;
  // Joining a dormant line revives it (Phase 3 resumes its lifecycle) — and
  // fast-forwards it to the latest track-group frame the room has reached
  // (decision #13 revision): the frozen position is stale, so the joiner lands
  // where the action is instead of resurrecting an abandoned path. Reviving in
  // place remains the fallback (no grouped landing yet, or the line froze
  // inside that same group).
  if (line.status === "dormant") {
    line.status = "active";
    // Persisted here rather than left to the fast-forward: a revival that
    // lands the line back where it froze (a score with no track groups, or no
    // grouped arrival yet) moves nothing and therefore saved nothing, so the
    // state file went on calling an occupied line dormant until the next
    // unrelated write. It self-heals across a restart — the reconnecting
    // device revives it again — but an operator reading saved state should not
    // have to know that.
    await fastForwardRevivedLine(session, line);
    // The revived line may be standing on a node another (dormant) line holds.
    line = await settleCoLocatedLines(session, line);
    lineId = line.id;
    await session.saveSessionStateToFile();
  } else if (registryChanged) {
    await session.saveSessionStateToFile();
  }
  // First device on a line (a revival, or the adoption of an empty split
  // child): if its frame's track group is still waiting on arrivals, the line
  // must park too — otherwise its taps would open a solo, unsynchronized
  // window mid-wait (the line only now became waitable; empty lines are not).
  if (!hadDevices && session.hasSessionLines && line.subStack.length === 0) {
    await maybeParkAtGroup(session, line, frameNameForLine(session, line));
  }
  return line;
}

// How many OTHER active main-flow lines currently sit on `frameName` — the
// input to the least-occupied landing rule (orch.revivalLandingFrame), shared
// by the dormant-line revival below and the operator's forced advance of a
// track group's stragglers (forceAdvanceStragglers).
function frameOccupancyExcluding(session, frameName, exclude) {
  return activeLines(session).filter((l) => {
    if (l === exclude || l.subStack.length > 0) {
      return false;
    }
    const fn = frameNameForLine(session, l);
    return fn != null && fn.toLowerCase() === frameName.toLowerCase();
  }).length;
}

// The frames the room's OTHER active lines are standing on right now, one
// entry per line (so repeats read as occupancy). This is what tells a revival
// whether the latest track-group arrival still describes where the room IS —
// a room that has moved on, to a later passage or to the end of the score,
// leaves every frame of that group empty.
//
// Undefined — "cannot tell, take the record at its word" — while any active
// line is mid-DIVE. A dived line stands on no main-flow frame (which is why
// the occupancy count leaves it out too), so counting it as absent from the
// group would read a room that is merely inside its sub-scores as a room that
// has finished with them, and freeze a revival in place instead of landing it
// on the group those lines are about to come back to.
function activeMainFlowFrames(session, exclude) {
  const others = activeLines(session).filter((l) => l !== exclude);
  if (others.some((l) => l.subStack.length > 0)) {
    return undefined;
  }
  return others
    .map((l) => frameNameForLine(session, l))
    .filter((name) => name != null);
}

// Would reviving `line` bring a PATH back, or just put a second line where the
// room is already standing?
//
// The revival landing answers it: a missing slot of a live track group is a
// path (that is the whole point of #13's fast-forward), and so is any frame no
// active line holds. A landing that lands ON an active line is not — it splits
// the same position across two lines for no musical reason, and the operator's
// map then shows a crowd of lines on one node.
//
// False whenever the question cannot be asked cleanly: a room with a line
// mid-dive (`activeMainFlowFrames` declines to guess), or a score with no
// session lines. Revival is the documented default, so an unknown answers for
// it rather than against.
function revivalAddsNoPath(session, line) {
  if (!session.hasSessionLines || !session.graph) {
    return false;
  }
  const occupied = activeMainFlowFrames(session, line);
  if (!occupied || occupied.length === 0) {
    return false;
  }
  const record = session.latestGroupArrival;
  const landing =
    orch.revivalLandingFrame({
      graph: session.graph,
      listFiles: session.listFiles,
      latestGroupFrame: record && record.frame,
      line,
      occupancy: (frameName) => frameOccupancyExcluding(session, frameName, line),
      activeFrames: occupied,
      // …and when the landing is null the line revives where it froze, which is
      // the frame that has to be judged instead.
    }) || frameNameForLine(session, line);
  if (!landing) {
    return false;
  }
  return occupied.some(
    (frame) => frame.toLowerCase() === landing.toLowerCase(),
  );
}

// Decision #13 revision: a dormant line being revived abandons its frozen
// position and lands where the ROOM is — on the least-occupied frame of the
// latest track group while the room is still spread across it (so revivals
// fill missing track slots rather than doubling covered ones), and otherwise
// on the least-occupied frame the active lines themselves hold. Which of the
// two applies is revivalLandingFrame's decision, made from the frames below.
// All playhead mutation is synchronous (callers rely on
// line.currentIndex being final when this returns its promise); only the
// registry/persistence follow-ups await. No-op → frozen-position revival.
async function fastForwardRevivedLine(session, line) {
  if (!session.hasSessionLines || !session.graph) {
    return;
  }
  const record = session.latestGroupArrival;
  const target = orch.revivalLandingFrame({
    graph: session.graph,
    listFiles: session.listFiles,
    latestGroupFrame: record && record.frame,
    line,
    occupancy: (frameName) => frameOccupancyExcluding(session, frameName, line),
    // Where the ROOM is right now, so the fast-forward can tell a track group
    // the room is still spread across from one it has long since left behind.
    activeFrames: activeMainFlowFrames(session, line),
  });
  if (!target) {
    return;
  }
  const idx = session.listFilesInLowerCase.indexOf(target.toLowerCase());
  if (idx < 0) {
    return;
  }

  // Leave any frozen sub context (restores the saved main-flow history) — the
  // landing is a main-flow frame.
  while (line.subStack.length > 0) {
    line.exitSub();
  }
  line.setCurrIdxTo(idx);
  // The line teleported: it must not stay parked at — or keep pending
  // hold-until obligations toward — its pre-dormancy position. (Group parking
  // at the NEW frame is re-evaluated by the caller's maybeParkAtGroup.)
  line.isGroupWaiting = false;
  orch.unparkLine(session, line);

  // The landing plays its own holding period, before the arrival is recorded:
  // the revived performer has just been handed a frame and should get the beat
  // the score gives it, and the group it lands in waits on that hold like any
  // other occupant's. No tap carried a duration here either — the line was
  // dormant.
  await startArrivalHoldForLanding(session, line);

  // Registry: normal departure/landing semantics — leaving the frozen frame
  // completes it, which may release barriers parked elsewhere.
  if (recordArrival(session, line)) {
    await tryReleaseBarriers(session);
  }
  await session.saveSessionStateToFile();
}

// ── Session Lines: orchestration (Phase 3) ───────────────────────────────────
// All of the below only runs behind a `session.hasSessionLines` gate. A vanilla
// score never enters these paths, so its runtime is byte-for-byte Phase 2.

const orch = createOrchestrator({
  send: sendToLine,
  sendAdmins: sendToLineAdmins,
  createLine: (session, id) => new BMLine(session, id),
  MESSAGES,
  now: () => Date.now(),
});

// Fallback duration (seconds) for a split choice window when both the frame and
// the session would resolve it to 0 — the window must always be bounded but
// real (decision #2).
const DEFAULT_SPLIT_CHOICE_DUR = 10;

// The frame NAME a line currently sits on. In a sub-session the line indexes the
// sub's frame list (Chunk K); on the main flow it indexes session.listFiles.
function frameNameForLine(session, line) {
  const sub = line.subStack && line.subStack[line.subStack.length - 1];
  if (sub && session.subFrames && session.subFrames[sub.score]) {
    return session.subFrames[sub.score].frameList[line.currentIndex];
  }
  return session.listFiles[line.currentIndex];
}

function navigationForLine(session, line) {
  const sub = line.subStack && line.subStack[line.subStack.length - 1];
  if (sub && session.subFrames && session.subFrames[sub.score]) {
    const subInfo = session.subFrames[sub.score];
    return {
      frameList: subInfo.frameList,
      frameLinks: (subInfo.graph || {}).frameLinks,
    };
  }
  return {
    frameList: session.listFiles,
    frameLinks: (session.graph || {}).frameLinks,
  };
}

// The parser's entry for the line's CURRENT frame — sub-aware, like
// navigationForLine. Null only when the graph cannot speak for the frame at
// all (no graph built yet, a name that does not resolve); an entry it DOES
// hold is authoritative.
function frameGraphEntryForLine(session, line) {
  const sub = line.subStack && line.subStack[line.subStack.length - 1];
  const graph =
    sub && session.subFrames && session.subFrames[sub.score]
      ? session.subFrames[sub.score].graph
      : session.graph;
  const frameName = frameNameForLine(session, line);
  if (!graph || !graph.byFrame || !frameName) {
    return null;
  }
  return graph.byFrame[frameName] || null;
}

// How long the line's CURRENT frame asks to be held, in seconds — the single
// answer every hold start uses.
//
// The GRAPH is the authority here, not the tap. A tap reports the `holding` of
// the frame its link NAMES (voting.js `getFrameHoldingDur`), which is the frame
// the line lands on for an ordinary move and is NOT for any of the others: a
// dive lands on the sub's START while the link names the return landing, a sub
// exit lands on the return landing while the tap named the sub-end marker, a
// split divides ONE line across several destinations so no single tap can
// speak for them, and an operator move has no tap behind it at all. Reading
// the landing's own value off the graph makes every one of them right by
// construction instead of right by coincidence.
//
// The graph is built for EVERY score, vanilla included, and carries every
// frame, so `nextFrameHoldingDur` survives only as the fallback for a frame
// the graph cannot answer for. A frame it knows answers even when nothing was
// authored: `holding: null` there means "take the session default", which is
// an answer and not a gap — hence `Object.hasOwn` rather than a truth test.
function landingHoldSeconds(session, line) {
  const entry = frameGraphEntryForLine(session, line);
  const authored =
    entry && Object.hasOwn(entry, "holding")
      ? entry.holding
      : line.nextFrameHoldingDur;
  return parseCustomDur(session.holdDuration, authored);
}

// How long the line's CURRENT frame opens its choice window for, as the raw
// authored string (`voting="8"` / `"50%"` / `"false"`), or null when the graph
// cannot answer for the frame.
//
// Same authority argument as `landingHoldSeconds` above, for the same reason
// and one more: a tap reports the `voting` of the frame it is standing on,
// read out of the DOM by the page that sent it — so the window's length was
// decided by a value the client chose. A page with a stale frame list (one
// mid-dive, one that missed a rewind) reported the wrong frame's window
// honestly, and a message built by hand could name any length at all. The
// score is the authority on how long its own frames are open; the tap's value
// survives only as the fallback for a frame the graph does not carry.
// The graph is built for EVERY score and carries every frame, so — exactly as
// for `holding` — a frame it knows answers even when nothing was authored:
// `voting: null` there means "take the session default", which is an ANSWER
// and not a gap. Hence `Object.hasOwn` rather than a truth test, and hence the
// tap's own value surviving only for a frame the graph cannot speak for.
function landingVotingDur(session, line, tapValue) {
  const entry = frameGraphEntryForLine(session, line);
  return entry && Object.hasOwn(entry, "voting") ? entry.voting : tapValue;
}

// …and WHETHER it is held at all — the same question, of the same frame.
//
// The gate and the duration used to be asked of different things: the duration
// came from the landing while the gate read `session.holdDuration`, the room's
// default, which is 0 unless an operator sets it. So a frame authored
// `holding="12"` was ignored outright on the ordinary voted or grouped advance
// while every other landing played it — the same frame reached one way held
// and reached another did not, which is exactly the split `landingHoldSeconds`
// exists to close. The default also made it the common case rather than an
// edge one, and the consequence is not only timing: a landing with no hold is
// registered `done` on arrival (`recordArrival` reads `isHolding`), so a
// `hold-until` there whose targets were already met releases in the same tick,
// freeing a line the moment its device was told to show the frame (and, back
// when a release still auto-advanced, taking it straight off again).
//
// Ask it AFTER the playhead has moved: the answer is about the frame the line
// is standing on, not the one it came from.
function holdsAtLanding(session, line) {
  return landingHoldSeconds(session, line) > 0;
}

function defaultOutgoingVoteIdForLine(session, line) {
  if (!session.hasSessionLines) {
    return null;
  }
  const nav = navigationForLine(session, line);
  return orch.defaultOutgoingVoteId(
    nav.frameLinks,
    nav.frameList,
    frameNameForLine(session, line),
    () => Math.random(),
  );
}

function outgoingVoteIdsForLine(session, line) {
  const nav = navigationForLine(session, line);
  return orch.outgoingVoteIds(
    nav.frameLinks,
    nav.frameList,
    frameNameForLine(session, line),
  );
}

// The frame index a tap may move this line to, or null when it is refused —
// `orch.validateTapTarget` asked of the line's ACTIVE score (the sub's frame
// list and link graph mid-dive). The rule itself lives in the orchestrator so
// it can be exercised without booting a server.
//
// `tapContext` is the dive context the tapping page reports DISPLAYING (the
// `ctx` its last display message carried). On a session-lines score it must be
// the line's own; a page that reports none is refused. Vanilla scores never
// dive, send no context, and are not asked for one.
function validatedTapTarget(session, line, selectedId, tapContext) {
  const nav = navigationForLine(session, line);
  const checkContext = !!session.hasSessionLines;
  return orch.validateTapTarget({
    selectedId,
    frameName: frameNameForLine(session, line),
    frameList: nav.frameList,
    frameLinks: nav.frameLinks,
    currentIndex: line.currentIndex,
    context: checkContext ? (tapContext == null ? null : tapContext) : undefined,
    lineContext: checkContext ? orch.diveContextKey(line.subStack) : undefined,
  });
}

// ── Rendezvous reached-registry (#6) ─────────────────────────────────────────
// Every playhead landing is recorded in session.reachedTargets ("arrived") and
// upgraded to "done" once the frame's own holding period there has ended —
// hold-until barriers release on "done" targets no matter where the reaching
// line is (it does NOT have to converge on the barrier frame). Refs inside a
// sub are qualified "score/frame", matching hold-until sub refs. Departure
// also completes a frame (a line cannot leave mid-hold), so the previous ref
// is upgraded on the next landing.

function reachedRefForLine(session, line) {
  const frameName = frameNameForLine(session, line);
  if (!frameName) {
    return null;
  }
  const sub = line.subStack && line.subStack[line.subStack.length - 1];
  return sub ? `${sub.score}/${frameName}` : frameName;
}

// Returns true when some ref BECAME "done" — the edge on which open barriers
// must be re-checked (the caller runs tryReleaseBarriers).
function recordArrival(session, line) {
  if (!session.hasSessionLines) {
    return false;
  }
  if (!session.reachedTargets) {
    session.reachedTargets = {};
  }
  const ref = reachedRefForLine(session, line);
  if (!ref) {
    return false;
  }
  let becameDone = false;
  if (
    line._lastReachedRef &&
    line._lastReachedRef.toLowerCase() !== ref.toLowerCase()
  ) {
    becameDone = orch.markReached(
      session.reachedTargets,
      line._lastReachedRef,
      true,
    );
  }
  line._lastReachedRef = ref;
  // No holding running for this landing (holdDuration 0, a frame authored
  // `holding="false"`…) ⇒ the frame's holding period is already over.
  //
  // A SUB-END is the exception, and it is not about holding at all: reaching
  // one pops the line in the same tick (`handleSubTransitions`, two statements
  // after this call), so the line is passing THROUGH rather than resting, and
  // the frame is completed by that departure like any other. Marking it done
  // here instead releases a `hold-until` waiting on it while the line is still
  // inside the sub — one frame short of the return landing the release expects
  // to find it on, and before that landing has started its own hold, so the
  // rendezvous the score wrote opens on a line that has not actually arrived
  // (and, back when a release still auto-advanced, the parked lines were taken
  // straight off the frame). That is the "skipped target after exiting a
  // sub-score" defect (§9), reached from the registry rather than the clock.
  //
  // It used to be held shut by `isHolding` — the ordinary advance set that flag
  // on any non-zero session default, so a sub-end was "arrived" whether or not
  // the frame asked to be held. Once the gate started reading the FRAME (§7.1),
  // a sub-end authored `holding="false"` — which is the honest thing to write
  // on a marker no device displays — stopped being covered. The rule is stated
  // rather than inherited now.
  const passingThrough = line.isHolding || isSubEndFrame(session, line);
  return (
    orch.markReached(session.reachedTargets, ref, !passingThrough) || becameDone
  );
}

// The line's holding period at its current frame ended (holding timer fired).
function recordHoldEnded(session, line) {
  if (!session.hasSessionLines || line.status !== "active") {
    return false;
  }
  if (!session.reachedTargets) {
    session.reachedTargets = {};
  }
  const ref = reachedRefForLine(session, line);
  return ref ? orch.markReached(session.reachedTargets, ref, true) : false;
}

// The sub link (if any) of the line's current MAIN-FLOW frame whose return
// landing is the advance target. Taking that link means the line dives into
// the sub instead of moving — the target frame is where it lands after the
// sub. Matching is by target frame (vote ids and default fallbacks carry the
// frame index); only navigation call sites consult this — rewinds and other
// repositions never dive.
function subLinkForAdvanceTarget(session, line, targetIdx) {
  if (!session.hasSessionLines || line.subStack.length > 0) {
    return null;
  }
  const links = ((session.graph || {}).subLinks || {})[
    frameNameForLine(session, line)
  ];
  if (!links || links.length === 0) {
    return null;
  }
  const targetName = session.listFiles[targetIdx];
  if (!targetName) {
    return null;
  }
  const targetLower = targetName.toLowerCase();
  return (
    links.find(
      (l) =>
        l.returnHref &&
        String(l.returnHref).toLowerCase() === targetLower &&
        session.subFrames &&
        session.subFrames[l.score],
    ) || null
  );
}

// A navigation advance chose a sub link: dive instead of moving. Mirrors the
// bookkeeping afterLineArrived's finally would have done for a plain landing
// (the dive can change group reachability, and admins want the fresh
// positions snapshot).
async function diveViaSubLink(session, line, subLink) {
  await enterSubSession(session, line, subLink);
  await tryReleaseGroupWaits(session);
  updateNumberOfConnectionForSession(session);
}

// True when a line INSIDE a sub sits on that sub's session-sub-end frame. The
// display for that arrival is driven by MSG_SUB_EXIT (afterLineArrived →
// exitSubSession), so a plain delayed MSG_SHOW must not race it — it would fire
// after the exit, in main context, with a stale sub index (wrong frame + the
// client's cid desyncs and every later tap is rejected).
function isSubEndFrame(session, line) {
  if (!session.hasSessionLines || line.subStack.length === 0) {
    return false;
  }
  const top = line.subStack[line.subStack.length - 1];
  const subInfo = session.subFrames && session.subFrames[top.score];
  const subGraph = subInfo && subInfo.graph;
  return !!(
    subGraph && (subGraph.subEnd || {})[frameNameForLine(session, line)]
  );
}

// True when a line (on the main flow) sits on a session-split frame.
function isSplitFrame(session, line) {
  if (!session.hasSessionLines || !session.graph || !session.graph.splits) {
    return false;
  }
  if (line.subStack && line.subStack.length > 0) {
    return false; // splits only on the main flow (v1 subs are plain)
  }
  return !!session.graph.splits[frameNameForLine(session, line)];
}

// The split frame's ordered child links plus the member list they are resolved
// against. ONE builder for both the live per-device destination preview and the
// real resolution below, so the destination a device is shown mid-window is
// exactly the one it gets when the window closes.
function splitPlanForLine(session, line) {
  const frameName = frameNameForLine(session, line);
  const childFrameIndices = (session.graph.frameLinks || {})[frameName] || [];
  if (childFrameIndices.length < 2) {
    return null; // not a real split (validator should have caught this)
  }

  const members = populationLineConnections(
    wsServer.connections,
    session.id,
    line.id,
  ).map((conn) => {
    const votedIdx = orch.parseVoteTargetIndex(conn.currentVoteTo, -1);
    const slot = childFrameIndices.indexOf(votedIdx);
    return { conn, key: conn.deviceId, choice: slot >= 0 ? slot : null };
  });

  return { frameName, childFrameIndices, members };
}

// A split partition (member index → child slot) keyed by connection instead:
// each device's destination as the vote id of the child link it lands on.
function splitDestinationsByConn(plan, assignment) {
  const voteIds = orch.splitDestinationVoteIds(
    plan.frameName,
    plan.childFrameIndices,
    assignment,
  );
  const destinations = new Map();
  plan.members.forEach((m, i) => {
    if (m.conn && voteIds[i]) {
      destinations.set(m.conn, voteIds[i]);
    }
  });
  return destinations;
}

// Per-device destinations on a split frame: the child link each connection
// would land on if the window closed right now. A split has no single winning
// vote — the line DIVIDES — so each device is told its own destination instead
// of one shared winner (see sendVotingUpdateToLine). Recomputed from the live
// votes on every tick, so it tracks other devices' choices as they come in.
function splitDestinationPreview(session, line) {
  const plan = splitPlanForLine(session, line);
  if (!plan) {
    return new Map();
  }
  const { assignment } = orch.planSplitPartition(
    plan.members,
    plan.childFrameIndices.length,
  );
  return splitDestinationsByConn(plan, assignment);
}

/**
 * Is there anybody on this line to divide?
 *
 * POPULATION, not connections: a map tab is an observation tool and a rider is
 * a spectator (decision #12), so neither makes a line something a split can
 * act on.
 */
function lineHasPopulation(session, line) {
  return (
    populationLineConnections(wsServer.connections, session.id, line.id)
      .length > 0
  );
}

// Resolve a split: the choice window has closed on a split frame. The line
// carries on down the first branch (keeping its number) and one new line is
// spawned per further branch; distribute choosers + balance stragglers,
// reassign connections, then let each child react to its landing frame.
// `gestureId` groups the forks of ONE operator gesture: a track group's
// release divides every populated line standing on a split frame, and the
// operator watched one thing happen (`orch.splitGestureEvents`). Null — the
// lone choice window closing below — is one fork and one gesture already.
async function resolveSplit(session, line, gestureId = null) {
  const plan = splitPlanForLine(session, line);
  if (!plan) {
    return; // not a real split (validator should have caught this)
  }
  // Tallied BEFORE applySplit — the counts still describe the window that just
  // closed, and conn.currentVoteTo is reset a few lines below.
  const finalCounts = countVoteForLine(session, line);

  // The population whose window just closed — captured BEFORE applySplit, which
  // is the last moment they can be named: it rebinds each of them to a child,
  // so afterwards `line.id` no longer identifies the set that voted.
  //
  // Only these votes are cleared. Voting windows on independent lines overlap
  // routinely, and a session-wide loop erased them: a split on L0 wiped L2's
  // choices mid-window, and because a later vote recalculates the tally from
  // `conn.currentVoteTo` (and another split's partition reads it directly),
  // performers on an unrelated line were sent somewhere they did not choose.
  // Riders and map tabs on the splitting line are included — they never vote,
  // but they are this line's own connections and clearing a field that is
  // already -1 for them costs nothing.
  const votingPopulation = lineConnections(
    wsServer.connections,
    session.id,
    line.id,
  );

  const { children, assignment } = orch.applySplit({
    session,
    parentLine: line,
    childFrameIndices: plan.childFrameIndices,
    members: plan.members,
    gestureId,
  });

  // Settle every device's destination marker on the child it ACTUALLY got,
  // before the new frame replaces the split frame. Driven by applySplit's own
  // assignment, so this final marker cannot disagree with the split; it only
  // corrects the last tick when a late tap moved someone's balanced slot.
  const finalDestinations = splitDestinationsByConn(plan, assignment);
  sendSplitVotingUpdate(finalCounts, finalDestinations, [
    ...finalDestinations.keys(),
  ]);

  // Map-view observers are not split members. The continuing branch kept the
  // line's id so they are already on a live line, but follow the registry
  // sweep where it moved their device id, as a split member would.
  wsServer.connections.forEach((c) => {
    if (c.sessionId === session.id && c.isMapView && c.lineId === line.id) {
      c.lineId =
        (c.deviceId && session.deviceRegistry[c.deviceId]) || children[0].id;
    }
  });

  // Reset votes on the (now reassigned) connections that took part in it.
  votingPopulation.forEach((conn) => {
    conn.currentVoteTo = -1;
  });

  await session.saveSessionStateToFile();

  // A child may land on its own orchestration frame (a barrier parks; a nested
  // split just waits for taps — split paths are never sub links, the validator
  // forbids it). Run arrival hooks before scheduling any plain SHOW so
  // redirected/merged lines do not receive stale frame updates.
  //
  // Each child first starts ITS OWN landing's holding period. One window
  // closed here but the line divided, so the children stand on different
  // frames and no single tap speaks for them — the split is the third landing
  // the tap cannot answer for, alongside the two ends of a dive. Without it a
  // child landed phase-less: `recordArrival` marked its frame done on the
  // spot, so an authored `holding` on a split destination was ignored outright
  // and a child landing on an already-satisfied hold-until was advanced off
  // the frame in the same tick it was told to show it.
  for (const child of children) {
    await startArrivalHoldForLanding(session, child);
    await showLineAfterArrivalIfNeeded(session, child);
  }

  // A child whose only members are OFFLINE devices is born active — the
  // registry sweep counts them, so it is not a branch "nobody took" — yet
  // nobody is connected to it. Dormancy is driven by a device leaving (#11),
  // and there is nobody left to leave, so such a line used to stay active and
  // empty for the rest of the session. Every fresh joiner then balanced onto
  // it (0 players beats any populated line) and was dropped on its frame: the
  // owner's room had finished on END while one of these sat on K, and both of
  // the next two joiners were put on K. Give it the grace window a disconnect
  // would: a swept device that comes back in time keeps its branch, otherwise
  // the line goes dormant and the next joiner is placed by #13.
  for (const child of children) {
    if (
      child.status === "active" &&
      populationLineConnections(wsServer.connections, session.id, child.id)
        .length === 0
    ) {
      startAttritionGrace(session, child);
    }
  }

  // Admins were reassigned to child lines — refresh their (per-line) history +
  // the now-diverged availability.
  pushAdminHistory(session);
}

// Hook run whenever a line's playhead lands on a (new) frame. Detects sub-start /
// sub-end / hold-until barriers / rejoin. A no-op for plain frames (and for
// vanilla scores). Split is handled separately, on choice-window close.
// Returns true if it drove the client display itself (sub enter/exit, or a
// rejoin that re-showed the survivor) — so the caller must NOT also send a SHOW.
async function afterLineArrived(session, line) {
  if (!session.hasSessionLines || line.status === "retired") {
    return false;
  }
  try {
    return await afterLineArrivedInner(session, line);
  } finally {
    // Track-group arrival waits: ANY landing can shrink a group's waiting set
    // (the line arrived at the group — or moved off its last path to it), so
    // re-check every parked group. Recursive arrivals re-check idempotently.
    await tryReleaseGroupWaits(session);
    // Admin live map: every landing refreshes the per-line positions (the same
    // payload the line-distribution panel consumes). Recursive arrivals (sub
    // exit → landing) just send an extra idempotent snapshot.
    updateNumberOfConnectionForSession(session);
  }
}

async function showLineAfterArrivalIfNeeded(session, line) {
  const consumed = session.hasSessionLines
    ? await afterLineArrived(session, line)
    : false;
  if (!consumed && !session.isPause && line.status !== "retired") {
    sendToLine(session, line.id, Date.now() + session.preloadDuration, {
      m: MESSAGES.MSG_SHOW,
      showIdx: line.currentIndex,
    });
  }
  return consumed;
}

async function afterLineArrivedInner(session, line) {
  const graph = session.graph || {};
  const frameName = frameNameForLine(session, line);

  // Rendezvous registry: record the landing. A target that BECAME done may
  // release barriers parked anywhere in the session — but the release is held
  // back until this line has had its chance to JOIN the barrier at its own
  // landing frame, below.
  //
  // Releasing here instead frees the room in two instalments.
  // `tryReleaseBarriers` asks `parkedLines.some(holdPendingAtFrame)` — the set
  // `enterBarrier` fills — so a line arriving AT a barrier frame and completing
  // that barrier's last target in the same breath is not in it yet: the wait
  // opens for everyone already parked while the line that completed it is left
  // to serve out its own holding period parked alone, told to wait for a target
  // it is standing on. They leave the barrier together now, which is what the
  // score asked for. (It cost more when a release still auto-advanced: the
  // parked lines were moved off and merged without it, so the rendezvous the
  // score wrote was unmakeable — see releaseBarrier.)
  //
  // It shows up most sharply coming out of a sub-score, because that is where
  // the two roles land on one line: the wait names a frame inside the sub
  // (`hold-until="Tetra1/End.svg"`), and the line that completes it is the one
  // the sub returns to the barrier frame. Nothing about it is particular to
  // sub-scores though — any line whose arrival completes the wait it is
  // arriving at loses the same way.
  const becameDone = recordArrival(session, line);

  // Sub-session exit: reaching a session-sub-end frame pops back to the main
  // flow (MSG_SUB_EXIT drives the display). Dives are NOT arrival-triggered —
  // a line dives when it takes a session-sub-start <a> link (see
  // subLinkForAdvanceTarget at the navigation call sites).
  if (await handleSubTransitions(session, line, frameName)) {
    return true;
  }

  // One line per node (owner: "at each node you can only have 1 line — either
  // that line was merged from other lines, it is still only 1 line at that
  // node"). Whoever else is standing here — active or dormant, with or without
  // a rejoin-at announcing it — merges with the line that just arrived, and
  // the survivor then meets whatever the frame holds (barrier, track group)
  // through the recursive arrival runRejoin makes.
  const coLocated = coLocatedLines(session, line);
  if (coLocated.length > 0) {
    await runRejoin(session, [line, ...coLocated], frameName, { inPlace: true });
    if (becameDone) await tryReleaseBarriers(session);
    return true;
  }

  // v1 sub-sessions are plain: no split / barrier / rejoin inside a sub, so
  // there is no barrier here for this line to join and the release is due now.
  if (line.subStack.length > 0) {
    if (becameDone) await tryReleaseBarriers(session);
    return false;
  }

  // Decision #13 revision: remember the newest MAIN-FLOW grouped landing —
  // dormant-line revivals fast-forward to this group instead of resuming their
  // frozen position. Recorded before the barrier/rejoin branches below:
  // parking or merging on the frame is still "reaching" it.
  if (orch.groupOfFrame(graph, frameName)) {
    session.latestGroupArrival = { frame: frameName, at: Date.now() };
  }

  // Hold-until barrier (optionally paired with rejoin-at on the same frame). The
  // line parks here and the caller still shows the barrier frame (+ banner).
  const holdTargets = (graph.holdUntilTargets || {})[frameName];
  if (holdTargets && holdTargets.length > 0) {
    // This is the join the release above was waiting for: `enterBarrier` parks
    // the line — so its own holding period counts toward `holdPending` — and
    // then runs the release check itself, which subsumes `becameDone`.
    await enterBarrier(session, line, frameName, holdTargets);
    return false;
  }

  // Not a barrier frame, so there was nothing for this line to join: whatever
  // its arrival completed can be acted on now.
  if (becameDone) {
    await tryReleaseBarriers(session);
  }

  // Track-group ARRIVAL barrier: a line landing on a grouped frame parks until
  // every populated line that can still reach the group has arrived (empty
  // lines excluded). The matching release check runs in afterLineArrived's
  // finally (tryReleaseGroupWaits).
  await maybeParkAtGroup(session, line, frameName);

  return false;
}

// Sub-session exit. Returns true if the arrival was a sub exit (the display is
// then driven by MSG_SUB_EXIT, not a plain SHOW). Entry is navigation-driven
// (diveViaSubLink), never an arrival reaction.
async function handleSubTransitions(session, line, frameName) {
  if (line.subStack.length === 0) {
    return false;
  }

  // Inside a sub: pop on reaching a session-sub-end frame.
  const top = line.subStack[line.subStack.length - 1];
  const subInfo = session.subFrames && session.subFrames[top.score];
  const subGraph = subInfo && subInfo.graph;
  if (subGraph && (subGraph.subEnd || {})[frameName]) {
    await exitSubSession(session, line);
    return true;
  }
  return false;
}

function subStartIndex(frameList) {
  const start = (frameList || []).findIndex((f) =>
    f.toUpperCase().startsWith("START"),
  );
  if (start >= 0) return start;
  const pre = (frameList || []).findIndex((f) =>
    f.toUpperCase().startsWith("PRE"),
  );
  return pre >= 0 ? pre : 0;
}

async function enterSubSession(session, line, subLink) {
  const { score, returnHref } = subLink;
  const subInfo = session.subFrames[score];

  line.enterSub(score, returnHref);
  const startIdx = subStartIndex(subInfo.frameList);
  line.setCurrIdxTo(startIdx); // indexes the sub list now (activeFrameList)

  // The mirror of exitSubSession, and the same root cause: the tap that dove
  // named a session-sub-start LINK, whose href is the return landing back in
  // the main flow — so the `holding` it carried belongs to a frame the line
  // will not stand on until it comes back out, while the frame it lands on now
  // is the sub's START. Both ends of a dive move the line somewhere other than
  // the frame the tap named, so both take their hold from the graph instead.
  await clearLinePhase(session, line);

  // Client fetches + injects the sub frames, swaps its frame list, then shows
  // the sub START.
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_SUB_ENTER,
    sub: score,
    showIdx: startIdx,
  });

  // Display first, hold second — ejectLineFromSub's order — and both ahead of
  // the arrival, so a START whose frame holds is recorded "arrived" and not
  // "done" (recordArrival reads isHolding).
  await startArrivalHoldForLanding(session, line);

  // The sub START is a landing afterLineArrived never sees (the dive happens
  // inside it) — record it here so sub refs feed the rendezvous registry.
  if (recordArrival(session, line)) {
    await tryReleaseBarriers(session);
  }
  await session.saveSessionStateToFile();
  emitHistoryToAdmins(session, line);
}

async function exitSubSession(session, line) {
  const popped = line.exitSub();
  const returnHref = popped && popped.returnHref;
  const returnIdx = orch.subReturnIndex(
    returnHref,
    session.listFilesInLowerCase,
  );
  if (returnIdx >= 0) {
    line.setCurrIdxTo(returnIdx); // back on the main list
  }

  // The hold running here belongs to the SUB-END frame, and the line is no
  // longer standing on it. A tap reads `holding` off the frame it NAMES,
  // resolved in the ACTIVE frame list (voting.js getFrameHoldingDur), so the
  // tap out of a sub carries the sub-end's value — while the frame the line
  // actually lands on, one hop later and back in the main flow, is the return
  // landing, whose own authored `holding` was never consulted at all. The
  // sub-end frame is a marker no device ever displays, so that hold was
  // governing a frame nobody sees: a return landing marked `holding="20"`
  // played whatever the sub end said (or the session default), and one marked
  // `holding="false"` landed phase-less and was registered done on the spot —
  // a hold-until there whose targets were already met then released in the
  // same tick and its paired rejoin-at advanced the line straight off the
  // frame, the eject's defect reached by the score's own route.
  //
  // So: drop the sub-end's phase and give the landing its own, exactly as the
  // eject does. `clearLinePhase` also cancels the standby gap the window close
  // opened, whose callback would otherwise start the sub-end's hold a second
  // later, on top of this one.
  await clearLinePhase(session, line);
  await session.saveSessionStateToFile();

  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_SUB_EXIT,
    showIdx: line.currentIndex,
  });
  emitHistoryToAdmins(session, line);

  // Before afterLineArrived, so the landing is recorded as still holding and
  // a barrier at it cannot release in the same tick (holdPendingAtFrame).
  await startArrivalHoldForLanding(session, line);

  // The main landing frame may itself be a barrier / rejoin / sub-start.
  await afterLineArrived(session, line);
}

// ── Hold-until barrier + rejoin ──────────────────────────────────────────────
// session._barrier is transient (never persisted): { byFrame: { <frame>: {
//   frame, targets[], parked:Set<lineId> } } }.
// Satisfaction is rendezvous-based: targets are checked against the persisted
// session.reachedTargets registry, not the parked lines' own histories.

// Which of a barrier's targets the registry can still make good on. The latch
// says the frame was played out; the CLAIMANTS say the room can still account
// for having been there (`orch.registryClaimants` — the lines' trails, the
// snapshots a split or merge took a trail into, and the rewind-landing grants).
// Both halves are required, because only a ROOM rewind restarts the latch: the
// per-line rewind, the dive rollback and the structural undos leave it alone on
// purpose ("the ROOM did not rewind", §8.2/§8.3/§8.4), so without the second
// question a REPLAYED passage meets its own barriers already satisfied — the
// owner's "hold-until not working, it reached but did not wait for other lines".
function coveredHoldTargets(session, targets) {
  return orch.registryCoveredTargets(
    session.reachedTargets,
    targets,
    orch.registryClaimants(session),
    holdRefStates(session),
  );
}

function ensureBarrier(session) {

  if (!session._barrier) {
    session._barrier = { byFrame: {} };
  }
  return session._barrier;
}

// Rebuild the transient `_barrier` map from persisted line state after a server
// restart (`line.isBarrierWaiting`/`pendingHoldUntil` survive serialization,
// the in-memory map does not). Lazy — runs once per session, on its first
// message; without it, previously-parked lines would resume un-parked and the
// barrier would be silently forgotten.
function rehydrateBarriers(session) {
  if (!session.hasSessionLines || session._barrierRehydrated) {
    return false;
  }
  session._barrierRehydrated = true;
  let parkedAny = false;
  const graph = session.graph || {};
  for (const line of session.lines) {
    if (line.status !== "active") {
      continue;
    }
    // Group-arrival parks: the flag persists and the wait set is derived live,
    // so there is nothing to rebuild — but a release may be due (the score may
    // have changed, or the incoming lines may never reconnect).
    if (line.isGroupWaiting) {
      if (line.subStack.length > 0 || !groupOfCurrentFrame(session, line)) {
        line.isGroupWaiting = false; // score changed under the saved state
      } else {
        parkedAny = true;
      }
    }
    if (!line.isBarrierWaiting) {
      continue;
    }
    if (line.subStack.length > 0) {
      continue; // barriers live on the main flow only
    }
    const frameName = frameNameForLine(session, line);
    const targets = (graph.holdUntilTargets || {})[frameName];
    if (!targets || targets.length === 0) {
      // Score changed under the saved state — nothing to wait on anymore.
      line.isBarrierWaiting = false;
      line.pendingHoldUntil = [];
      continue;
    }
    const barrier = ensureBarrier(session);
    const entry =
      barrier.byFrame[frameName] ||
      (barrier.byFrame[frameName] = {
        frame: frameName,
        targets: targets.slice(),
        parked: new Set(),
      });
    entry.parked.add(line.id);
    parkedAny = true;
  }
  return parkedAny;
}

function activeLines(session) {
  return session.lines.filter((l) => l.status === "active");
}

// L3 DECIDED by owner: an admin is a PLAYER with extra session controls —
// admin/SM connections count as line population exactly like player
// connections (they can tap/vote, so their line can arrive). A line occupied
// only by an idle admin therefore IS waited for, like any idle player's line;
// the remedies are the admin's own tools (tap the line forward, SM
// force-release, or close the tab so attrition dissolves the wait). EXCEPTION
// (owner, same day): the standalone /map page's connection has no way to tap
// or vote — it is a pure observation tool, never population
// (populationLineConnections), and a RIDER (a passwordless session page) is
// the same thing with a score on it (owner), so a line holding only spectators
// empties out and goes dormant like any abandoned line.
function activeGuardCandidates(session, exceptParkedIds = new Set()) {
  return activeLines(session).filter(
    (l) =>
      !exceptParkedIds.has(l.id) &&
      populationLineConnections(wsServer.connections, session.id, l.id).length >
        0,
  );
}

// Does `line` keep a still-missing hold-until `target` open?
//
// #11 excludes a PARKED line from "can still reach": it cannot navigate, so a
// path only it could travel is a dead path. But a line STANDING ON the missing
// target has already reached it — the registry holds the landing as "arrived"
// and the frame's own holding period (or the line's departure) upgrades it to
// "done" on a timer that no barrier gates. Counting that as unreachable
// force-released every OTHER line waiting for the target; where the released
// frame carried a single paired `rejoin-at`, the line was auto-advanced off it
// in the same tick as its arrival, so a sub return landing was never rendered
// ("ending subs skips target").
function canKeepHoldTargetOpen(session, line, target) {
  const ref = reachedRefForLine(session, line);
  if (ref && ref.toLowerCase() === String(target || "").toLowerCase()) {
    return true; // standing on it: reached, merely not "done" yet
  }
  if (line.isBarrierWaiting || line.isGroupWaiting) {
    return false; // parked elsewhere — #11: it can no longer travel there
  }
  return lineCanReachHoldTarget(session, line, target);
}

// The line phase clock — landingHoldElapsed / holdPendingAtFrame — lives in
// lib/session-lines/line.js, imported at the top of this file. The reasoning
// for asking the FRAME and the clock rather than reading the isHolding flag is
// there with it, and so the barrier tests can import the rule instead of
// keeping a copy that drifts.

// The clock half of `coveredHoldTargets`, read off the frames the room is
// standing on: which refs have nothing left to play (`playedOut`) and which are
// being played right now (`holdingNow`). `registryCoveredTargets` has the full
// reasoning; in short, `playedOut` lets an `arrived` mark count when no event
// will ever complete it, and `holdingNow` stops a `done` mark counting while a
// line is standing there with the frame's own holding period still to run —
// which is what a stale `done` looks like the moment a rewound line steps back
// onto the frame.
//
// Only an ACTIVE line can hold a target open: a dormant one has nobody on it, so
// it is no more "playing" the frame than an empty line is coming to it (#11).
function holdRefStates(session) {
  const playedOut = new Set();
  const holdingNow = new Set();
  if (!session.hasSessionLines) {
    return { playedOut, holdingNow };
  }
  for (const line of session.lines) {
    if (line.status === "retired") continue;
    const ref = reachedRefForLine(session, line);
    if (!ref) continue;
    const key = ref.toLowerCase();
    if (landingHoldElapsed(line)) {
      playedOut.add(key);
    } else if (line.status === "active") {
      holdingNow.add(key);
    }
  }
  // A frame two lines stand on, one of them still playing it, is not played out
  // — the LAST occupant's holding period is what ends the wait, the same rule
  // the track group's hold sync follows.
  for (const key of holdingNow) {
    playedOut.delete(key);
  }
  return { playedOut, holdingNow };
}

function resolveSubScoreName(session, score) {
  const subs = session.subFrames || {};
  return (
    Object.keys(subs).find(
      (name) => name.toLowerCase() === String(score || "").toLowerCase(),
    ) || null
  );
}

function subTargetReachableFromStart(session, score, targetFrame) {
  const scoreName = resolveSubScoreName(session, score);
  const sub = scoreName && session.subFrames[scoreName];
  if (!sub || !sub.graph || !sub.graph.frameLinks) {
    return false;
  }
  const startIdx = subStartIndex(sub.frameList);
  const startFrame = sub.frameList[startIdx];
  return orch.canReachFrames(sub.graph.frameLinks, sub.frameList, startFrame, [
    targetFrame,
  ]);
}

function mainCanReachAnySubStart(session, fromFrame, score) {
  const scoreLower = String(score || "").toLowerCase();
  const starts = Object.entries((session.graph || {}).subLinks || {})
    .filter(([, links]) =>
      (links || []).some((l) => String(l.score).toLowerCase() === scoreLower),
    )
    .map(([frameName]) => frameName);
  return (
    starts.length > 0 &&
    orch.canReachFrames(
      (session.graph || {}).frameLinks,
      session.listFiles,
      fromFrame,
      starts,
    )
  );
}

function lineCanReachHoldTarget(session, line, target) {
  const ref = String(target || "");
  const slash = ref.indexOf("/");
  const top = line.subStack && line.subStack[line.subStack.length - 1];

  if (slash > 0) {
    const score = ref.slice(0, slash);
    const targetFrame = ref.slice(slash + 1);
    const scoreName = resolveSubScoreName(session, score);
    const sub = scoreName && session.subFrames[scoreName];
    if (!sub || !sub.graph || !sub.graph.frameLinks) {
      return false;
    }
    if (
      top &&
      String(top.score).toLowerCase() === String(score).toLowerCase()
    ) {
      return orch.canReachFrames(
        sub.graph.frameLinks,
        sub.frameList,
        frameNameForLine(session, line),
        [targetFrame],
      );
    }

    const fromFrame = mainFlowFrameForLine(session, line);
    return (
      subTargetReachableFromStart(session, score, targetFrame) &&
      mainCanReachAnySubStart(session, fromFrame, score)
    );
  }

  return orch.canReachFrames(
    (session.graph || {}).frameLinks,
    session.listFiles,
    mainFlowFrameForLine(session, line),
    [ref],
  );
}

async function enterBarrier(session, line, frameName, targets) {
  const barrier = ensureBarrier(session);
  const entry =
    barrier.byFrame[frameName] ||
    (barrier.byFrame[frameName] = {
      frame: frameName,
      targets: targets.slice(),
      parked: new Set(),
    });
  entry.parked.add(line.id);

  // Park the line: it holds here, ignoring taps, until the barrier releases.
  line.isBarrierWaiting = true;
  const covered = coveredHoldTargets(session, entry.targets);
  line.pendingHoldUntil = entry.targets.filter((t) => !covered.has(t));

  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_BARRIER_WAITING,
    frame: frameName,
    targets: entry.targets,
  });
  notifyAdminsBarriers(session);
  await session.saveSessionStateToFile();

  await tryReleaseBarriers(session);
}

async function tryReleaseBarriers(session) {
  const barrier = session._barrier;
  if (!barrier) {
    return;
  }

  for (const frameName of Object.keys(barrier.byFrame)) {
    const entry = barrier.byFrame[frameName];
    if (!entry) {
      // Released by a nested re-check (a release advances lines, whose
      // arrivals feed the registry and re-enter this function) — skip.
      continue;
    }
    const parkedLines = [...entry.parked]
      .map((id) => session.lines.find((l) => l.id === id))
      .filter((l) => l && l.status === "active");

    // Rendezvous (#6): coverage comes from the session-global reached
    // registry — any line reaching a target anywhere (and ending that frame's
    // hold) satisfies it; the parked lines never have to converge here.
    const covered = coveredHoldTargets(session, entry.targets);
    const satisfied = orch.holdUntilSatisfied(entry.targets, covered);

    // Deadlock guard / attrition (#11): release rather than wait forever when
    // the missing targets can no longer be reached by any active,
    // device-bearing line. Empty/dormant/retired lines do not keep a
    // hold-until target open, and neither does a line parked elsewhere — but a
    // line standing ON the target does (canKeepHoldTargetOpen).
    const reachability = orch.holdUntilReachabilityState(
      entry.targets,
      covered,
      activeGuardCandidates(session, entry.parked),
      (l, target) => canKeepHoldTargetOpen(session, l, target),
    );
    const forceRelease =
      parkedLines.length > 0 &&
      reachability.missingTargets.length > 0 &&
      reachability.unreachableTargets.length ===
        reachability.missingTargets.length;

    // A hold-until barrier IS a holding period (§7 step 5: the line "enters
    // holding" on arrival, the release "releases the hold") — it EXTENDS the
    // frame's own hold and must never cut it short. A parked line whose hold
    // has not finished keeps the entry closed, the same hold-sync rule the
    // track-group arrival barrier has ("the group unlocks on the last
    // occupant's hold release"). Without it a line landing on an ALREADY
    // satisfied barrier was released in the same tick as its arrival — and back
    // when a release still auto-advanced, that took the line off the frame
    // before its device had rendered it. The advance is gone (releaseBarrier)
    // and the gate stays: a release ends a holding period, so it must not end
    // one that has not run.
    // Called with the line alone: `some` passes (line, index), and the index
    // would arrive as the rule's injectable clock — a line flagged holding with
    // no timer behind it (restored mid-hold) then threw from `now()`.
    const holdPending = parkedLines.some((l) => holdPendingAtFrame(l));

    if ((satisfied || forceRelease) && !holdPending) {
      delete barrier.byFrame[frameName];
      await releaseBarrier(session, entry, parkedLines);
    }
  }
}

async function releaseBarrier(session, entry, parkedLines) {
  for (const l of parkedLines) {
    l.isBarrierWaiting = false;
    l.pendingHoldUntil = [];
    sendToLine(session, l.id, 0, {
      m: MESSAGES.MSG_BARRIER_RELEASED,
      frame: entry.frame,
    });
  }

  // A release FREES the line; it never moves it (owner: "rejoin-at should be an
  // announcement that that note will be merged with another note or line in the
  // next step — it should not automatically merge anything"). A paired
  // `rejoin-at` used to auto-advance a SINGLE target and merge the released
  // lines there (the Barrier→DONE pattern), which turned the barrier frame into
  // a place the room passed THROUGH: the performers watched their landing for
  // one holding period and the server then took the step for them. That is the
  // "skipped target" the sub exits kept reporting (§9), arriving by the one
  // route the earlier fixes left open — the hold gate in tryReleaseBarriers
  // only delayed the advance by a holding period, it never stopped it.
  //
  // Every rejoin is a co-presence rejoin now (`afterLineArrived`), one target
  // or many: the freed line stays on its frame, its next window votes its own
  // route, and the lines merge when they walk onto the frame the announcement
  // named.
  //
  // Composition with the group ARRIVAL barrier: a freed line on a grouped frame
  // may still owe the group a wait (out-of-group hold-until targets are valid
  // and stack) — and clearing this blocker may itself open the group for the
  // lines already parked there.
  for (const l of parkedLines) {
    await maybeParkAtGroup(session, l, entry.frame);
  }
  await tryReleaseGroupWaits(session);
  await session.saveSessionStateToFile();
  notifyAdminsBarriers(session);
}

// Merge converging lines into the lowest-id survivor, reassign their devices,
// hard-retire the absorbed lines, then put the survivor on the rejoin frame. Its
// one caller is the co-presence branch of `afterLineArrived`, which finds every
// line already standing there — so `survivorTravels` below is false in practice
// and the arrival keeps the holding period it is already playing. The travel
// branch stays for a caller that merges lines from elsewhere; the barrier
// release was that caller, until a rejoin became an announcement (§7.3).
// The node a line is standing on: its frame, plus the dive stack it is in. Two
// lines inside a sub-score share a node only when they dived the same way
// (same sub, same return landing at every level) — otherwise merging them
// would have to pick one of two different ways back out.
function lineNodeKey(session, line) {
  const frame = frameNameForLine(session, line);
  if (frame == null) return null;
  return `${orch.diveContextKey(line.subStack)}#${String(frame).toLowerCase()}`;
}

// Every other non-retired line standing on `line`'s node.
function coLocatedLines(session, line) {
  const key = lineNodeKey(session, line);
  if (key == null) return [];
  return session.lines.filter(
    (other) =>
      other !== line &&
      other.status !== "retired" &&
      lineNodeKey(session, other) === key,
  );
}

// Enforce one line per node across the whole room, for the landings that do
// not come through afterLineArrived: every rewind, the operator valves, a
// revival. Those are authoritative repositions, so the merge does not re-run
// the frame's arrival (no parking) — it only stops two lines sharing a node.
// Returns the survivor of the last merge that involved `focus`, or `focus`.
async function settleCoLocatedLines(session, focus = null) {
  if (!session.hasSessionLines) return focus;
  let result = focus;
  // Lines a structural merge undo has just pulled apart in THIS gesture
  // (`session.__justSeparated`, set for the length of one rewind message).
  // The settlement that follows an undo must not re-create the very event the
  // undo took off: the operator clicked "unmerge", was told the lines were
  // separated, and one statement later they were merged again on the node
  // they came apart on — one round trip, no separation, and a fresh merge
  // event stacked behind the undone one.
  //
  // Reaching this at all means the undo could not land a participant anywhere
  // but the rejoin frame (its predecessor is no longer in the score), so it
  // is worth saying out loud: the room is briefly two lines deep on one node,
  // which is visible on the map and settled by the next ordinary landing.
  const justSeparated = session.__justSeparated || null;
  for (let guard = 0; guard < session.lines.length + 1; guard++) {
    const groups = new Map();
    for (const line of session.lines) {
      if (line.status === "retired") continue;
      const key = lineNodeKey(session, line);
      if (key == null) continue;
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key).push(line);
    }
    const crowded = [...groups.values()].find(
      (group) =>
        group.length > 1 &&
        !(justSeparated && group.every((l) => justSeparated.has(l.id))),
    );
    if (!crowded) {
      const stranded = [...groups.values()].find((group) => group.length > 1);
      if (stranded) {
        console.warn(
          `settleCoLocatedLines: leaving ${stranded
            .map((l) => l.id)
            .join("+")} on ${frameNameForLine(session, stranded[0])} — ` +
            `re-merging them would recreate the rejoin this gesture just undid`,
        );
      }
      break;
    }
    const survivor = await runRejoin(
      session,
      crowded,
      frameNameForLine(session, crowded[0]),
      { inPlace: true, arrive: false },
    );
    if (focus && crowded.includes(focus) && survivor) result = survivor;
  }
  return result;
}

async function runRejoin(session, lines, rejoinFrameName, opts = {}) {
  const lineIds = lines.map((l) => l.id);
  const { survivor, absorbed } = orch.applyRecombine({
    session,
    lineIds,
    connections: wsServer.connections,
    frame: rejoinFrameName,
  });
  if (!survivor) {
    return null;
  }

  const anyGroupParked = lines.some((l) => l.isGroupWaiting);
  for (const l of absorbed) {
    l.clearAllTimer();
    cancelAttritionTimer(l);
    l.isBarrierWaiting = false;
    l.isGroupWaiting = false;
    // A retired line waits nowhere: take it out of any barrier's parked set so
    // a release is not held open by a line that no longer exists.
    orch.unparkLine(session, l);
  }

  survivor.isBarrierWaiting = false;
  survivor.isGroupWaiting = false;
  const targetIdx = session.listFilesInLowerCase.indexOf(
    String(rejoinFrameName).toLowerCase(),
  );
  // A co-presence merge finds the survivor already standing on the rejoin
  // frame: it does not travel, and must keep the holding period it is already
  // playing there rather than have one restarted under it.
  const survivorTravels =
    !opts.inPlace && targetIdx >= 0 && targetIdx !== survivor.currentIndex;
  if (survivorTravels) {
    survivor.setCurrIdxTo(targetIdx);
  }

  // Reset votes on every (now merged) connection.
  wsServer.connections.forEach((conn) => {
    if (conn.sessionId === session.id && conn.lineId === survivor.id) {
      conn.currentVoteTo = -1;
    }
  });

  await session.saveSessionStateToFile();

  // Tell the merged devices their (surviving) line + show its frame.
  sendToLine(session, survivor.id, 0, {
    m: MESSAGES.MSG_LINE_ASSIGNED,
    lineId: survivor.id,
  });
  if (anyGroupParked) {
    // Merged devices may still show a group-arrival banner from a pre-merge
    // park (the client only hides it on MSG_BARRIER_RELEASED); the recursive
    // afterLineArrived below re-parks the survivor if the group still waits.
    sendToLine(session, survivor.id, 0, {
      m: MESSAGES.MSG_BARRIER_RELEASED,
      frame: rejoinFrameName,
    });
  }
  emitHistoryToAdmins(session, survivor);

  // A survivor that TRAVELLED here plays the rejoin frame's own holding period,
  // like any other arrival. The merge is the score's routing, not an operator
  // valve ending a wait, so the landing is ordinary travel — and a frame it
  // reached phase-less was marked done on the spot, which skipped an authored
  // `holding` on the rejoin target outright and, where that target is a track
  // group, silently voided the group's "wait for the last occupant's holding
  // period" rule (the group had no hold of this line's to wait for). The phase
  // clear first because a FORCED release can advance a survivor whose own hold
  // is still running, and its timer would otherwise outlive the frame it
  // belongs to.
  if (survivorTravels) {
    await clearLinePhase(session, survivor);
    await startArrivalHoldForLanding(session, survivor);
  }

  // A merged line with nobody on it (a dormant husk absorbed into a line whose
  // own devices are offline) gets the grace window a disconnect would.
  if (
    survivor.status === "active" &&
    populationLineConnections(wsServer.connections, session.id, survivor.id)
      .length === 0
  ) {
    startAttritionGrace(session, survivor);
  }

  if (opts.arrive === false) {
    // An authoritative reposition (rewind, valve, revival): show the frame,
    // re-run nothing — and so park nowhere, the rule every rewind follows.
    if (orch.unparkLine(session, survivor)) notifyAdminsBarriers(session);
    if (anyGroupParked || lines.some((l) => l.isBarrierWaiting)) {
      sendToLine(session, survivor.id, 0, {
        m: MESSAGES.MSG_BARRIER_RELEASED,
        frame: rejoinFrameName,
      });
    }
    if (!session.isPause) {
      sendToLine(session, survivor.id, Date.now() + session.preloadDuration, {
        m: MESSAGES.MSG_SHOW,
        showIdx: survivor.currentIndex,
      });
    }
    updateNumberOfConnectionForSession(session);
    return survivor;
  }

  // The rejoin frame may itself be an orchestration frame.
  await showLineAfterArrivalIfNeeded(session, survivor);
  return survivor;
}

// Attrition (#11): a line that loses its last device goes DORMANT (revivable) —
// it releases any barrier waiting on it and clears its timers, but keeps its
// frame/history/subStack so a later joiner can revive it (#13). Structural
// lines (rejoin-absorbed) are already 'retired' and skip this.
//
// Dormancy is DEBOUNCED: a socket close is very often a refresh or a transient
// network blip (the client reconnect backoff is 1–5s), and a barrier released
// on dormancy is irreversible (#11 — revival never re-arms it). So the line
// only goes dormant if no device reclaims it within the grace window.
const ATTRITION_GRACE_MS = 8000;

function cancelAttritionTimer(line) {
  if (line && line._attritionTimer) {
    clearTimeout(line._attritionTimer);
    line._attritionTimer = null;
  }
}

async function handleConnectionClose(session, conn) {
  if (!session || !session.hasSessionLines) {
    return;
  }
  // A spectator (the standalone /map, or a rider) is an observation tool, never
  // population — closing or reloading it must leave no footprint in the room.
  // Every count already filters it out (populationLineConnections), so without
  // this guard a spectator watching a line that has no population reaches the
  // attrition timer below and starts a grace window nobody asked for: an
  // observer changing room state just by being closed.
  if (isSpectatorConn(conn)) {
    return;
  }
  const lineId = conn.lineId;
  if (!lineId) {
    return;
  }
  const line = session.lines.find((l) => l.id === lineId);
  if (!line || line.status !== "active") {
    return;
  }
  const remaining = populationLineConnections(
    wsServer.connections,
    session.id,
    lineId,
  ).filter((c) => c !== conn);
  if (remaining.length > 0) {
    return;
  }
  startAttritionGrace(session, line);
}

// Open the #11 grace window on a line nobody is connected to: unless a device
// claims it within ATTRITION_GRACE_MS (ensureLineAssignment cancels the timer),
// it goes dormant. A no-op while a window is already running.
function startAttritionGrace(session, line) {
  if (line._attritionTimer) {
    return; // grace window already running
  }
  const attritionTimer = setTimeout(() => {
    session
      .runExclusively(async () => {
        // A reconnect or score reset may have cancelled/replaced this timer
        // while its callback waited behind a structural rewind.
        if (line._attritionTimer !== attritionTimer) return;
        line._attritionTimer = null;
        await finalizeAttrition(session, line);
      })
      .catch((e) => console.error("finalizeAttrition error", e));
  }, ATTRITION_GRACE_MS);
  line._attritionTimer = attritionTimer;
}

// Move the RIDERS watching `line` onto a live one (owner). A rider
// is bound to a line only so the server has somewhere to send it a frame from;
// when that line stops being active the binding has nothing left to show, and a
// spectator cannot tap its way out. Map tabs are deliberately NOT re-homed:
// they paint the whole room from the broadcast `lines[]` snapshot, so their
// binding is a pure address and moving it would change nothing on screen.
//
// The move is told in the vocabulary the page needs (§10/§16): a rider whose
// new line sits in a sub must be told to ENTER it, one leaving a sub must be
// told to EXIT — a bare MSG_SHOW carrying a main-flow index would be resolved
// against the sub's injected frame list and blank the display. The sub
// messages travel even while paused, with the pause placeholder restored right
// after, exactly as the operator advances do.
function rehomeRidersOffLine(session, line) {
  if (!session.hasSessionLines) {
    return; // one line: there is nowhere else to watch from
  }
  const riders = wsServer.connections.filter(
    (c) =>
      c &&
      c.sessionId === session.id &&
      c.lineId === line.id &&
      !c.isMapView &&
      c.isStaff === false,
  );
  if (riders.length === 0) {
    return;
  }
  const targetId = spectatorLandingLineId(
    session.lines,
    wsServer.connections,
    session.id,
  );
  const target = targetId ? session.lines.find((l) => l.id === targetId) : null;
  if (!target || target.id === line.id) {
    return; // nothing active left in the room — leave the rider where it is
  }

  const wasInSub = line.subStack.length > 0;
  const top = target.subStack[target.subStack.length - 1];
  for (const conn of riders) {
    conn.lineId = target.id;
    conn.currentVoteTo = -1;
    sendDisplayToClient(session, conn, 0, {
      m: MESSAGES.MSG_LINE_ASSIGNED,
      lineId: target.id,
    });
    if (top) {
      sendDisplayToClient(session, conn, 0, {
        m: MESSAGES.MSG_SUB_ENTER,
        sub: top.score,
        showIdx: target.currentIndex,
      });
    } else if (wasInSub) {
      sendDisplayToClient(session, conn, 0, {
        m: MESSAGES.MSG_SUB_EXIT,
        showIdx: target.currentIndex,
      });
    } else if (!session.isPause) {
      sendDisplayToClient(session, conn, 0, {
        m: MESSAGES.MSG_SHOW,
        showIdx: target.currentIndex,
      });
    }
    if (session.isPause && (top || wasInSub)) {
      sendDisplayToClient(session, conn, 0, {
        m: MESSAGES.MSG_PAUSE,
        isPause: true,
        showIdx: target.currentIndex,
      });
    }
  }
  console.log(
    `re-homed ${riders.length} rider(s) off dormant ${line.id} onto ${target.id}`,
  );
}

async function finalizeAttrition(session, line) {
  // Re-check: the session may be gone, a device may have reclaimed the line
  // (ensureLineAssignment cancels the timer, but re-verify), or the line may
  // have been retired by a split/rejoin in the meantime.
  if (session.isSessionDeleted || line.status !== "active") {
    return;
  }
  if (
    populationLineConnections(wsServer.connections, session.id, line.id)
      .length > 0
  ) {
    return;
  }

  line.status = "dormant";
  line.dormantAt = Date.now();
  line.clearAllTimer();
  line.votingTimer = line.holdingTimer = line.standbyTimer = null;
  line.isVoting = false;
  line.isStandby = false;
  line.isHolding = false;
  line.isBarrierWaiting = false;
  line.isGroupWaiting = false;
  if (session._barrier) {
    for (const entry of Object.values(session._barrier.byFrame)) {
      entry.parked.delete(line.id);
    }
  }

  // A rider watching this line must not be left staring at a frozen frame:
  // "a spectator should only be able to view active lines/nodes" (owner).
  rehomeRidersOffLine(session, line);

  await tryReleaseBarriers(session);
  // A dormant line stops being "incoming" — group arrival waits may dissolve.
  await tryReleaseGroupWaits(session);
  notifyAdminsBarriers(session);
  await session.saveSessionStateToFile();
  // The ws close handler pushed the per-line snapshot 8s ago, when this line
  // still had its pre-dormancy flags; nothing has pushed since. Without this
  // the operator's line panel and the map keep showing the line as active and
  // the room as still waiting on it, long after both stopped being true.
  updateNumberOfConnectionForSession(session);
}

// ── Session manager controls across lines (Chunk M) ──────────────────────────
// Everything here is gated on session.hasSessionLines. A vanilla score keeps
// today's single-line SM behavior (one line, no track groups, no barriers).

function nonRetiredLines(session) {
  return (session.lines || []).filter((l) => l.status !== "retired");
}

function mainHistoryStateForLine(line) {
  let history = Array.isArray(line.history) ? line.history : [];
  let historyIndex = line.historyIndex;
  if (
    line.subStack &&
    line.subStack.length > 0 &&
    Array.isArray(line.savedHistories) &&
    line.savedHistories.length > 0
  ) {
    const saved = line.savedHistories[0] || {};
    history = Array.isArray(saved.history) ? saved.history : [];
    historyIndex = saved.historyIndex;
  }
  const max = history.length - 1;
  const idx =
    historyIndex == null
      ? max
      : Math.max(-1, Math.min(Number(historyIndex), max));
  return { history, historyIndex: idx };
}

function mainTrailForLine(line) {
  const { history, historyIndex } = mainHistoryStateForLine(line);
  return history.slice(0, historyIndex + 1);
}

function rewindLineSnapshot(line) {
  return {
    id: line.id,
    trail: mainTrailForLine(line),
    // The forks this line is downstream of, so a room rewind can place it by
    // the route it actually took when its own trail was truncated past the
    // checkpoint (`orch.ancestorGroupOccurrence`).
    splitAncestors: line.splitAncestors || [],
  };
}

function populatedRewindCheckpointLines(session, lines) {
  return lines
    .filter(
      (l) =>
        l.status === "active" &&
        populationLineConnections(wsServer.connections, session.id, l.id)
          .length > 0,
    )
    .map(rewindLineSnapshot);
}

// Push every admin their OWN line's history. Always available:false — the
// implicit bound-line rewind is retired in session-lines rooms, so the SM
// dropdown is a read-only trail display; rewinds live in the score map
// (room-wide {group} checkpoint rewind + explicit {lineId} line rewind). Only
// called for session-lines scores (emitHistoryToAdmins branches; vanilla sends
// no `available` field at all).
function pushAdminHistory(session) {
  wsServer.connections.forEach((conn) => {
    if (conn.sessionId === session.id && conn.isAdmin) {
      const line = lineForConn(session, conn);
      sendToClient(conn, 0, {
        m: MESSAGES.MSG_SELECT_HISTORY,
        history: line.history,
        selectedIdx: line.historyIndex,
        available: false,
      });
    }
  });
}

// Emit updated history to admins after a line moved. Session-lines: push every
// admin their own line + availability (pushAdminHistory). Vanilla: exactly
// today's single-line admin history send (no `available` field → byte-identical).
function emitHistoryToAdmins(session, line) {
  if (session.hasSessionLines) {
    pushAdminHistory(session);
    return;
  }
  sendToLineAdmins(session, line.id, 0, {
    m: MESSAGES.MSG_SELECT_HISTORY,
    history: line.history,
    selectedIdx: line.historyIndex,
  });
}

// Surface the set of currently-waiting hold-until barriers to ALL admins so the
// operator can force-release a stuck one (defensive valve, decision #12). Sent
// as an admin-flagged MSG_BARRIER_WAITING; an empty list hides the admin panel.
function notifyAdminsBarriers(session) {
  if (!session.hasSessionLines) {
    return;
  }
  // Recompute the straggler set FIRST: the panel and the players' banners are
  // two views of one state, refreshed from exactly the same edges, and the
  // `stragglers[]` below is built from the result. Refreshing afterwards left
  // the panel one edge behind — visible after a restart, where player devices
  // reconnect one at a time and each reconnect changes who is being waited on.
  refreshStragglerNotices(session);
  const barriers = session._barrier
    ? Object.keys(session._barrier.byFrame).map((frame) => {
        const entry = session._barrier.byFrame[frame];
        // Hold-until entries have stragglers of their own: the lines that can
        // still reach a target nobody has reached — exactly who this barrier
        // is held open FOR. `advanceTargets` names the frame each would be
        // sent to, so the map can label the command with its destination and
        // offer nothing for a line it cannot land (a target inside a
        // sub-score).
        const stragglers = holdUntilStragglerTargets(session, entry);
        return {
          frame,
          targets: entry.targets,
          parked: [...entry.parked],
          stragglers: stragglers.map((s) => s.lineId),
          advanceTargets: stragglers.reduce((map, s) => {
            if (s.target) {
              map[s.lineId] = s.target;
            }
            return map;
          }, {}),
        };
      })
    : [];
  // Track-group arrival waits share the panel (as "group:<name>") so the
  // operator's force-release valve covers them too — the panel round-trips
  // the frame string, which forceReleaseBarrier detects by its prefix.
  for (const [group, lines] of groupWaitParkedByGroup(session)) {
    barriers.push({
      frame: `group:${group == null ? "?" : group}`,
      targets: group == null ? [] : orch.groupFramesLower(session.graph, group),
      parked: lines.map((l) => l.id),
      // Who the group is still waiting on from OUTSIDE — the operator's
      // "force advance stragglers" targets. No `advanceTargets`: a group
      // straggler's landing is picked when the command runs (the group's
      // least-occupied frame), so the UI names the GROUP as the destination.
      stragglers:
        group == null
          ? []
          : groupStragglerLines(session, group).map((l) => l.id),
    });
  }
  sendToAllAdmins(session, 0, {
    m: MESSAGES.MSG_BARRIER_WAITING,
    admin: true,
    barriers,
  });
}

// "group:<name>" panel entries are track-group arrival waits, not hold-until
// frames; anything else (including no frame at all → "every barrier") is not.
function parseGroupRef(frameName) {
  return typeof frameName === "string" && frameName.startsWith("group:")
    ? frameName.slice("group:".length)
    : null;
}

// The "your move, proceed when ready…" banner for a line some barrier is held
// open for. `line.stragglerFor` carries the panel's own barrier ref —
// "group:<name>" for a track group, the frame name for a hold-until — so the
// two sites that send this payload (the straggler diff and a reconnect) split
// it the same way. The client reads only `straggler`; the rest is context.
function stragglerBanner(session, line) {
  const group = parseGroupRef(line.stragglerFor);
  return {
    m: MESSAGES.MSG_BARRIER_WAITING,
    frame: frameNameForLine(session, line),
    group,
    barrier: group == null ? line.stragglerFor : null,
    straggler: true,
  };
}

// Admin force-release (defensive valve). Releases a chosen barrier (by frame) or
// every waiting barrier when no frame is given, reusing the Chunk J release path
// (MSG_BARRIER_RELEASED). Like any other release it FREES the parked lines where
// they stand and moves nobody — the operator's move-them valve is the straggler
// advance. Ignores the "someone still coming" guard — this is the manual
// override for a stuck / rider-only line.
async function forceReleaseBarrier(session, frameName) {
  if (!session.hasSessionLines) {
    return;
  }
  const groupRef = parseGroupRef(frameName);
  if (session._barrier && groupRef == null) {
    const frames = frameName
      ? [frameName]
      : Object.keys(session._barrier.byFrame);
    for (const fn of frames) {
      const entry = session._barrier.byFrame[fn];
      if (!entry) {
        continue;
      }
      const parkedLines = [...entry.parked]
        .map((id) => session.lines.find((l) => l.id === id))
        .filter((l) => l && l.status === "active");
      delete session._barrier.byFrame[fn];
      await releaseBarrier(session, entry, parkedLines);
    }
  }
  if (groupRef != null || !frameName) {
    for (const [group, lines] of groupWaitParkedByGroup(session)) {
      const matches =
        groupRef == null ||
        (group == null ? groupRef === "?" : group === groupRef);
      if (matches) {
        await releaseGroupWaitLines(session, lines);
      }
    }
  }
  notifyAdminsBarriers(session);
  // A force-release is the one release with no landing behind it, so nothing
  // else refreshes the per-line snapshot: without this the line panel and the
  // map's ⏳/⏩ badges keep showing the wait the operator just resolved.
  updateNumberOfConnectionForSession(session);
}

// ── Track-group ARRIVAL barrier ──────────────────────────────────────────────
// Grouped frames don't just vote together — they WAIT for each other. A line
// landing on a track-grouped frame parks (frame shown, taps ignored — same
// client banner protocol as a hold-until park) until every populated line that
// can still REACH a group frame has arrived on one, and every arrived line has
// cleared its own (out-of-group) hold-until barrier. Empty (0-device) lines
// neither occupy nor are waited for. The wait dissolves timeout-free via
// reachability (decision #11 philosophy). Once released, the first tap opens
// the group's synchronized windows exactly as before (openCoGroupWindows). A
// LATE arrival (e.g. a line revived mid-round) is not parked once the group
// stopped waiting — it joins the running round and is truncated at the group
// close (owner-decided: lowest-complexity option). SM jumps never park at the
// landing (authoritative override, like the landing-barrier carve-out), and
// the admin panel's force-release valve covers group waits.

// The line's position projected onto the MAIN flow: its current frame, or —
// inside a sub — the sub-start return landing it will pop back to (where its
// future navigation resumes; v1 subs are plain).
function mainFlowFrameForLine(session, line) {
  if (line.subStack.length === 0) {
    return frameNameForLine(session, line);
  }
  const idx = orch.subReturnIndex(
    line.subStack[0].returnHref,
    session.listFilesInLowerCase,
  );
  return idx >= 0 ? session.listFiles[idx] : null;
}

// The main-flow frame a line dived FROM. `savedHistories[0]` is the main trail
// exactly as it stood when the OUTERMOST dive was taken, so its current entry is
// the frame carrying the session-sub-start link the line followed — the one
// destination a "put it back" needs no rule to choose. Null when the score no
// longer has that frame (renamed under saved state), which is what makes the map
// print a reason instead of an inert button.
function subOriginFrameForLine(session, line) {
  const saved = (line.savedHistories || [])[0];
  const name =
    saved && Array.isArray(saved.history)
      ? saved.history[saved.historyIndex]
      : null;
  if (name == null) {
    return null;
  }
  const idx = session.listFilesInLowerCase.indexOf(String(name).toLowerCase());
  return idx >= 0 ? session.listFiles[idx] : null;
}

// Evaluate a group's arrival-barrier state over the live session.
function groupWaitState(session, group) {
  const groupFrames = orch.groupFramesLower(session.graph, group);
  const groupSet = new Set(groupFrames);
  return orch.groupArrivalState(activeLines(session), groupFrames, {
    frameNameForLine: (l) => frameNameForLine(session, l),
    deviceCount: (l) =>
      populationLineConnections(wsServer.connections, session.id, l.id).length,
    inSub: (l) => l.subStack.length > 0,
    isBlocked: (l) => !!l.isBarrierWaiting,
    // Hold sync: an occupant still in its holding period keeps the group
    // parked so everyone leaves the held frame together — the group unlocks on
    // the last node's hold release. Gated ≥2 occupants in groupArrivalState,
    // so a lone grouped line never self-parks while holding.
    // Read off the FRAME's intrinsic period, not the `isHolding` flag, for the
    // reason landingHoldElapsed gives: a flag with no timer behind it (SM hold
    // toggle, a state file restored mid-hold) would keep the group parked for
    // ever.
    isHolding: (l) => !landingHoldElapsed(l),
    // Passed ⇒ arrived (owner, with the targeted line rewind): a line whose
    // main trail already went through this group is never counted as incoming
    // again — so a line rewound behind the group replays through it without
    // waiting for the lines ahead. Trail truncation on rewind is what revokes
    // this for the rewound line itself.
    hasPassed: (l) =>
      mainTrailForLine(l).some((f) => groupSet.has(f.toLowerCase())),
    canReach: (l) =>
      orch.canReachFrames(
        session.graph.frameLinks,
        session.listFiles,
        mainFlowFrameForLine(session, l),
        groupFrames,
      ),
  });
}

// Park `line` at its frame's group arrival barrier when the group still waits
// on someone. No-op for ungrouped frames, sub lines, empty lines, and lines
// already parked.
async function maybeParkAtGroup(session, line, frameName) {
  if (line.isGroupWaiting || line.subStack.length > 0) {
    return;
  }
  const group = orch.groupOfFrame(session.graph, frameName);
  if (!group) {
    return;
  }
  if (
    populationLineConnections(wsServer.connections, session.id, line.id)
      .length === 0
  ) {
    return; // an empty line can't vote — never park it (nor is it waited for)
  }
  if (!groupWaitState(session, group).waiting) {
    return;
  }
  line.isGroupWaiting = true;
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_BARRIER_WAITING,
    frame: frameName,
    group,
  });
  notifyAdminsBarriers(session);
  await session.saveSessionStateToFile();
}

// Group-parked active lines keyed by their frame's group. A line whose frame is
// no longer grouped (score reloaded under saved state) surfaces under `null`
// and is released unconditionally by tryReleaseGroupWaits.
function groupWaitParkedByGroup(session) {
  const byGroup = new Map();
  for (const l of activeLines(session)) {
    if (!l.isGroupWaiting) {
      continue;
    }
    const group = groupOfCurrentFrame(session, l);
    if (!byGroup.has(group)) {
      byGroup.set(group, []);
    }
    byGroup.get(group).push(l);
  }
  return byGroup;
}

async function releaseGroupWaitLines(session, lines) {
  for (const l of lines) {
    l.isGroupWaiting = false;
    sendToLine(session, l.id, 0, {
      m: MESSAGES.MSG_BARRIER_RELEASED,
      frame: frameNameForLine(session, l),
    });
  }
  notifyAdminsBarriers(session);
  await session.saveSessionStateToFile();
}

// Re-check every group with parked lines and release the ones whose wait has
// dissolved. Called on the edges where the waiting set can shrink: every
// landing, dormancy, hold-until release, SM jump, post-restart rehydration.
async function tryReleaseGroupWaits(session) {
  if (!session.hasSessionLines) {
    return;
  }
  for (const [group, lines] of groupWaitParkedByGroup(session)) {
    if (group == null || !groupWaitState(session, group).waiting) {
      await releaseGroupWaitLines(session, lines);
    }
  }
  // A landing can change who a still-waiting group is waiting ON without
  // releasing anything, so the banners and the panel refresh here too
  // (idempotent — releaseGroupWaitLines above already went through this).
  notifyAdminsBarriers(session);
}

// ── Stragglers (owner) ───────────────────────────────────────────────────────
// The lines a track group's arrival barrier is still waiting on from OUTSIDE
// the group. The parked lines see "waiting for other lines…"; until now the
// lines being waited FOR saw nothing at all, so nobody in the room knew whose
// move it was. They are now told — see refreshStragglerNotices — and the
// operator can either let the group go without them (force-release) or bring
// them in (forceAdvanceStragglers).
//
// The parked-lines-are-not-stragglers rule lives in orch.groupStragglerIds
// (pure, unit-tested); this resolves it back to line objects.
function groupStragglerLines(session, group) {
  if (group == null) {
    return [];
  }
  const lines = activeLines(session);
  const ids = new Set(
    orch.groupStragglerIds(groupWaitState(session, group), {
      lines,
      isParked: (l) => !!(l.isBarrierWaiting || l.isGroupWaiting),
    }),
  );
  return lines.filter((l) => ids.has(l.id));
}

// The lines a HOLD-UNTIL barrier is waiting on, each paired with the frame a
// forced advance would send it to. A track group waits for lines to ARRIVE on
// it; a hold-until waits for some line to REACH a named target, so its
// stragglers are the lines that can still get there — the same set the
// deadlock guard in tryReleaseBarriers consults to decide the wait is still
// viable, read the other way round.
//
// The candidate rules are shared with that guard on purpose (active, populated,
// not parked at this barrier, `canKeepHoldTargetOpen`): a line the guard counts
// as keeping the wait alive is exactly a line the operator can resolve it with.
// Resolve a sub-qualified hold-until target ("Tetra2/Ripple.svg") to a landing
// the operator's advance can actually use: which sub, which index in its frame
// list, and — when the line is not already inside — which authored dive it
// should be treated as having taken, since that dive's `returnHref` is where
// the line pops back to when the sub ends. Preference goes to a sub-start link
// on a main frame the line can still reach: its own way in, so its onward path
// after the sub is the one the score would have given it. Null when the score
// offers no usable way in (unknown sub, unknown frame, or no dive whose return
// landing still exists), which is what makes the UI say so instead of offering
// an inert button.
function subAdvanceLanding(session, line, ref) {
  const text = String(ref || "");
  const slash = text.indexOf("/");
  if (slash <= 0) {
    return null;
  }
  const scoreName = resolveSubScoreName(session, text.slice(0, slash));
  const sub = scoreName && (session.subFrames || {})[scoreName];
  if (!sub || !Array.isArray(sub.frameList)) {
    return null;
  }
  const targetFrame = text.slice(slash + 1).toLowerCase();
  const subIdx = sub.frameList.findIndex(
    (f) => String(f).toLowerCase() === targetFrame,
  );
  if (subIdx < 0) {
    return null;
  }

  // Already inside this sub, just not far enough in: move within it, keeping
  // the dive it came in on so its return landing — and the main-flow history it
  // saved on the way down — survive the advance.
  const top = line.subStack[line.subStack.length - 1];
  if (top && String(top.score).toLowerCase() === scoreName.toLowerCase()) {
    return {
      score: scoreName,
      subIdx,
      returnHref: top.returnHref,
      alreadyInside: true,
    };
  }

  const candidates = [];
  for (const [mainFrame, links] of Object.entries(
    (session.graph || {}).subLinks || {},
  )) {
    for (const l of links || []) {
      if (String(l.score).toLowerCase() !== scoreName.toLowerCase()) {
        continue;
      }
      if (orch.subReturnIndex(l.returnHref, session.listFilesInLowerCase) < 0) {
        continue;
      }
      candidates.push({ mainFrame, returnHref: l.returnHref });
    }
  }
  if (candidates.length === 0) {
    return null;
  }
  const fromFrame = mainFlowFrameForLine(session, line);
  const own = candidates.find((c) =>
    orch.canReachFrames(
      (session.graph || {}).frameLinks,
      session.listFiles,
      fromFrame,
      [c.mainFrame],
    ),
  );
  return {
    score: scoreName,
    subIdx,
    returnHref: (own || candidates[0]).returnHref,
    alreadyInside: false,
  };
}

function holdUntilStragglerTargets(session, entry) {
  const covered = coveredHoldTargets(session, entry.targets);
  const candidates = activeGuardCandidates(session, entry.parked);
  const state = orch.holdUntilReachabilityState(
    entry.targets,
    covered,
    candidates,
    (l, target) => canKeepHoldTargetOpen(session, l, target),
  );
  return orch.holdUntilStragglerTargets(state, {
    lines: candidates,
    canReachTarget: (l, target) => canKeepHoldTargetOpen(session, l, target),
    // A landing is either a main-flow frame or, for a qualified
    // "Score/Frame.svg" target, a frame inside a sub-score the line can be
    // dropped into (see subAdvanceLanding). Anything else leaves the line a
    // straggler with no destination.
    canLandOn: (target, l) =>
      session.listFilesInLowerCase.indexOf(String(target).toLowerCase()) >= 0 ||
      subAdvanceLanding(session, l, target) != null,
  });
}

// Push/clear the per-line straggler banner, diffed against `line.stragglerFor`
// so a line is only messaged when its role actually changes. The flag is
// TRANSIENT (absent from BMLine's persistence allowlist): it is derived from
// live positions, and re-derived from scratch on the first post-restart edge.
// It holds the panel's barrier ref ("group:<name>" or a hold-until frame name),
// not a bare group name — a line can be the straggler of either kind of wait.
//
// Only barriers that already have someone parked are considered: a group (or a
// hold-until frame) nobody has reached yet is not waiting on anyone.
function refreshStragglerNotices(session) {
  if (!session.hasSessionLines) {
    return;
  }
  const stragglerRefs = new Map(); // lineId → the barrier held open for it
  for (const [group] of groupWaitParkedByGroup(session)) {
    for (const l of groupStragglerLines(session, group)) {
      if (!stragglerRefs.has(l.id)) {
        stragglerRefs.set(l.id, `group:${group}`);
      }
    }
  }
  // Hold-until barriers wait on lines too — on whoever can still reach a
  // target nobody has reached — so their stragglers get the same "your move"
  // prompt, and the same per-line advance valve. A group wait wins the flag
  // when a line is the straggler of both: it is the wait the line can do least
  // about, since it has to travel to the group either way.
  const barrier = session._barrier;
  for (const frame of barrier ? Object.keys(barrier.byFrame) : []) {
    const entry = barrier.byFrame[frame];
    if (!entry || entry.parked.size === 0) {
      continue;
    }
    for (const { lineId, target } of holdUntilStragglerTargets(
      session,
      entry,
    )) {
      const line = session.lines.find((l) => l.id === lineId);
      const ref = line && reachedRefForLine(session, line);
      if (ref && ref.toLowerCase() === String(target || "").toLowerCase()) {
        // Standing on the target already: the barrier is waiting on this
        // line's holding period, not its travel — the same reason a BLOCKED
        // occupant is never a track group's straggler. It stays listed for the
        // operator (whose advance there ends that hold), but "your move" would
        // be a lie: there is no move left for it to make.
        continue;
      }
      if (!stragglerRefs.has(lineId)) {
        stragglerRefs.set(lineId, frame);
      }
    }
  }

  for (const line of session.lines || []) {
    if (!line || line.status === "retired") {
      continue;
    }
    const ref = stragglerRefs.get(line.id) || null;
    const was = line.stragglerFor || null;
    line.stragglerFor = ref;
    if (ref && !was) {
      sendToLine(session, line.id, 0, stragglerBanner(session, line));
    } else if (!ref && was && !line.isBarrierWaiting && !line.isGroupWaiting) {
      // Ordering guard: the usual way to STOP being a straggler is to arrive
      // and park, and maybeParkAtGroup has already sent that line its parked
      // banner by now. Clearing here would wipe it off the screen.
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BARRIER_RELEASED,
        frame: frameNameForLine(session, line),
      });
    }
  }
}

// Admin "force advance stragglers" — the complement of a force-release. Rather
// than letting a stuck barrier go WITHOUT the lines it is still expecting,
// bring those lines in:
//
//   - a TRACK GROUP's straggler teleports onto the group's least-occupied frame
//     (the same landing rule a dormant-line revival uses, decision #13
//     revision, so forced arrivals fill empty track slots instead of doubling
//     covered ones). The group then fills and releases down the ordinary path.
//   - a HOLD-UNTIL's straggler teleports onto the target the
//     barrier is still missing, so the wait ends the way the score meant it to
//     — the target genuinely reached — rather than being waived. A straggler
//     already standing on the target owes only its holding period, so there the
//     advance ends that hold instead of moving anything.
//
// `frameName` is the panel's own barrier ref: "group:<name>" for a track group,
// a frame name for a hold-until, or nothing at all → every waiting barrier.
// `lineIds` narrows it to named lines ("advance THIS line", the map's node
// menu); omitted, every straggler of the named barrier goes. Ids are filtered
// against the freshly computed straggler set, so a stale one is simply ignored.
async function forceAdvanceStragglers(session, frameName, lineIds) {
  if (!session.hasSessionLines || !session.graph) {
    return;
  }
  const groupRef = parseGroupRef(frameName);
  const only =
    Array.isArray(lineIds) && lineIds.length > 0 ? new Set(lineIds) : null;
  const advanced = [];
  let touched = false;

  // Track-group arrival waits. Skipped when `frameName` names a hold-until
  // barrier: an unrecognized frame used to fall through to "every group",
  // harmless only while hold-until entries had no stragglers to offer.
  if (frameName == null || groupRef != null) {
    for (const [group, parkedLines] of groupWaitParkedByGroup(session)) {
      if (group == null || (groupRef != null && group !== groupRef)) {
        continue;
      }
      // Anchor: where the group actually sits in the current frame list. Taken
      // from a parked line rather than the graph so a group whose frames were
      // renamed under saved state simply yields nothing to advance to.
      const anchor = frameNameForLine(session, parkedLines[0]);
      if (!anchor) {
        continue;
      }
      for (const line of groupStragglerLines(session, group)) {
        if (only && !only.has(line.id)) {
          continue;
        }
        const wasInSub = line.subStack.length > 0;
        if (await advanceLineToGroup(session, line, anchor)) {
          advanced.push({ line, wasInSub });
        }
      }
    }
  }

  // Hold-until barriers.
  if (session._barrier && groupRef == null) {
    const frames = frameName
      ? [frameName]
      : Object.keys(session._barrier.byFrame);
    for (const fn of frames) {
      const entry = session._barrier.byFrame[fn];
      if (!entry) {
        continue;
      }
      for (const { lineId, target } of holdUntilStragglerTargets(
        session,
        entry,
      )) {
        if (!session._barrier.byFrame[fn]) {
          break; // an earlier advance in this sweep already released it
        }
        if (!target || (only && !only.has(lineId))) {
          continue; // no landing (sub-qualified target), or not asked for
        }
        const line = session.lines.find(
          (l) => l.id === lineId && l.status === "active",
        );
        if (!line) {
          continue;
        }
        const wasInSub = line.subStack.length > 0;
        const outcome = await advanceLineToHoldTarget(session, line, target);
        if (outcome === "moved") {
          advanced.push({ line, wasInSub });
        } else if (outcome) {
          touched = true;
        }
      }
    }
  }

  if (advanced.length === 0) {
    if (touched) {
      await session.saveSessionStateToFile();
      updateNumberOfConnectionForSession(session);
    }
    notifyAdminsBarriers(session);
    return;
  }

  // A forced arrival is still an arrival: if the group is STILL waiting on
  // someone else, the line just brought in parks with the rest.
  for (const { line } of advanced) {
    await maybeParkAtGroup(session, line, frameNameForLine(session, line));
  }
  await tryReleaseGroupWaits(session);
  await session.saveSessionStateToFile();
  notifyAdminsBarriers(session);
  pushAdminHistory(session);
  updateNumberOfConnectionForSession(session);

  // Tell each moved line's devices where they are now. Three shapes, because
  // the client's frame list is context-dependent and an index means nothing
  // without it:
  //   INTO a sub  → MSG_SUB_ENTER (fetch + inject that sub's frames, swap the
  //                 list, show the landing). Idempotent for a line already in
  //                 the sub — the client caches the injection.
  //   OUT of one  → MSG_SUB_EXIT, the client's only exit from sub view: a
  //                 main-flow index against the sub's injected list resolves to
  //                 no frame, blanking the display and throwing in the audio
  //                 player on the unresolvable id.
  //   main → main → the ordinary preloaded MSG_SHOW.
  // The two sub messages are sent even while paused — a stale sub context must
  // not outlive the move, or the eventual unpause breaks the same way — with
  // the pause placeholder restored right after.
  for (const { line, wasInSub } of advanced) {
    const top = line.subStack[line.subStack.length - 1];
    if (top) {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_SUB_ENTER,
        sub: top.score,
        showIdx: line.currentIndex,
      });
    } else if (wasInSub) {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_SUB_EXIT,
        showIdx: line.currentIndex,
      });
    } else {
      if (!session.isPause) {
        sendToLine(session, line.id, Date.now() + session.preloadDuration, {
          m: MESSAGES.MSG_SHOW,
          showIdx: line.currentIndex,
        });
      }
      continue; // a paused main-flow line keeps the placeholder it already has
    }
    if (session.isPause) {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_PAUSE,
        isPause: true,
        showIdx: line.currentIndex,
      });
    }
  }
}

// Operator "eject this line from its sub-score". A dive is a session of its
// own, and until now the only ways out of one were the authored sub-end frame
// and the room-wide checkpoint rewind — which frees one stuck line by
// discarding every OTHER line's progress too. This is the narrow valve: one
// line, forward, onto the landing the score itself would have given it when
// the sub ended (`subStack[0].returnHref`, the OUTERMOST dive's return frame,
// so a nested dive is popped along with it).
//
// It is the twin of `exitSubSession` — the same exit, taken early — as
// `advanceLineIntoSub` is the twin of `enterSubSession`, and the landing runs
// through `afterLineArrived` for the same reason that one does: the return frame
// may itself carry a hold-until, be some line's rejoin target, or belong to a
// track group, and an ejected line must meet those exactly as it would have on
// the natural way out. (The barrier advances above deliberately skip that — they
// exist to END a wait, not to join one. An eject is ordinary travel, so it
// joins.) Over the top of it goes the hygiene every operator move shares: clear
// the phase the line is being pulled out from under, and unpark it.
//
// Unlike those advances it is NOT straggler-gated: a line stuck in a sub stalls
// the room whether or not a barrier happens to be waiting on it, which is
// exactly the case this exists for.
//
// `sub` is the race guard — the line must still be inside the sub the operator
// saw it in, so a stale click on a line that has since popped out is refused.
//
// Note what an eject does NOT do: an abandoned dive completes nothing. The sub
// frame the line walked away from is never marked done (`_lastReachedRef` is
// cleared first, so the departure completes nothing either), which means a
// hold-until waiting on a target inside that sub keeps waiting — the release is
// the valve for that one.
async function ejectLineFromSub(session, lineId, sub) {
  if (!session.hasSessionLines) {
    return;
  }
  const line = (session.lines || []).find(
    (l) => l.id === lineId && l.status === "active",
  );
  if (!line || line.subStack.length === 0) {
    return;
  }
  const top = line.subStack[line.subStack.length - 1];
  if (sub && String(top.score).toLowerCase() !== String(sub).toLowerCase()) {
    return;
  }
  // Resolved against the LIVE frame list, so a return landing renamed out from
  // under saved state yields nothing and the eject is refused — the map's menu
  // says as much in place of the button (`lines[].subReturn`).
  const returnIdx = orch.subReturnIndex(
    line.subStack[0].returnHref,
    session.listFilesInLowerCase,
  );
  if (returnIdx < 0) {
    return;
  }

  await clearLinePhase(session, line);
  while (line.subStack.length > 0) {
    line.exitSub(); // each pop restores the main-flow history it saved on entry
  }
  line.setCurrIdxTo(returnIdx);
  line.isGroupWaiting = false;
  orch.unparkLine(session, line);
  line._lastReachedRef = null;
  await session.saveSessionStateToFile();

  // Display first, landing second — exitSubSession's own order. MSG_SUB_EXIT is
  // the client's only way out of sub view, and it has to be out of it before
  // afterLineArrived starts addressing it about a main-flow frame. It goes even
  // while paused (a stale sub context must not outlive the move), with the pause
  // placeholder restored right after.
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_SUB_EXIT,
    showIdx: line.currentIndex,
  });
  if (session.isPause) {
    sendToLine(session, line.id, 0, {
      m: MESSAGES.MSG_PAUSE,
      isPause: true,
      showIdx: line.currentIndex,
    });
  }
  emitHistoryToAdmins(session, line);

  // The return frame is an ordinary landing, so it plays its OWN holding period
  // — started before afterLineArrived, exactly as the advance that carries a
  // line into a natural sub exit already has one running. Without it the
  // arrival registers as done on the spot and a hold-until at the landing whose
  // targets are already met releases in the same tick, bouncing the line onward
  // before its device has rendered the frame.
  await startArrivalHoldForLanding(session, line);

  await afterLineArrived(session, line);
  notifyAdminsBarriers(session);
}

// Teleport one straggler onto `anchorFrame`'s track group. Mirrors
// fastForwardRevivedLine — same least-occupied landing, same leave-the-sub /
// unpark / record-arrival sequence — but operator-driven.
// Returns true when the line actually moved.
async function advanceLineToGroup(session, line, anchorFrame) {
  const target = orch.revivalLandingFrame({
    graph: session.graph,
    listFiles: session.listFiles,
    latestGroupFrame: anchorFrame,
    line,
    occupancy: (frameName) => frameOccupancyExcluding(session, frameName, line),
    // No activeFrames, deliberately: the liveness test exists to spot a
    // STALE arrival record, and there is nothing stale here — the operator is
    // naming the group, on a barrier that is waiting at this moment. Omitting
    // it keeps the group live by definition, so a straggler still lands even
    // when it is the first line the group would have.
  });
  if (!target || !(await teleportLineForAdvance(session, line, target))) {
    return false;
  }
  session.latestGroupArrival = { frame: target, at: Date.now() };
  return true;
}

// Advance one straggler of a HOLD-UNTIL barrier: send it to the target the
// barrier is still missing. Returns "moved" when the line travelled (its
// devices need a fresh frame), "held" when it was already standing on the
// target and only its holding period was cut short, and null when there was
// nothing to do.
async function advanceLineToHoldTarget(session, line, target) {
  const idx = session.listFilesInLowerCase.indexOf(
    String(target).toLowerCase(),
  );
  const landing = idx < 0 ? subAdvanceLanding(session, line, target) : null;
  if (idx < 0 && !landing) {
    return null; // nothing in the score to land on — never offered
  }
  const ref = reachedRefForLine(session, line);
  if (ref && ref.toLowerCase() === String(target).toLowerCase()) {
    // Already standing on it: canKeepHoldTargetOpen counts this line as still
    // able to finish the target, so the barrier is waiting on its HOLDING
    // period, not its travel. Moving it nowhere would be a no-op, so the
    // advance is "end that hold now" — the same edge the holding timer would
    // have produced on its own.
    await endHoldForAdvance(session, line);
    return "held";
  }
  if (landing) {
    return (await advanceLineIntoSub(session, line, landing)) ? "moved" : null;
  }
  return (await teleportLineForAdvance(session, line, session.listFiles[idx]))
    ? "moved"
    : null;
}

// Drop `line` onto a frame INSIDE a sub-score — the sub half of
// teleportLineForAdvance, and the same sequence: clear the phase it is being
// moved out from under, take the dive, land, record the arrival. A line
// already in that sub keeps its dive (so the sub history and return landing it
// built on the way down survive); any OTHER sub it was in is left first,
// exactly as a main-flow advance leaves it.
//
// It lands on the target frame rather than the sub's START on purpose: this is
// a valve, and the barrier is waiting on that frame specifically — a drop at
// START would leave the room stalled until the line happened to travel there,
// and a branching sub might never route it through at all.
async function advanceLineIntoSub(session, line, landing) {
  await clearLinePhase(session, line);
  if (!landing.alreadyInside) {
    while (line.subStack.length > 0) {
      line.exitSub();
    }
    line.enterSub(landing.score, landing.returnHref);
  }
  line.setCurrIdxTo(landing.subIdx); // indexes the SUB frame list now
  line.isGroupWaiting = false;
  orch.unparkLine(session, line);

  line._lastReachedRef = null;
  if (recordArrival(session, line)) {
    await tryReleaseBarriers(session);
  }
  return true;
}

// Move `line` onto `targetFrame` (main flow) as an operator-driven advance.
// Shared by both advances above: clear whatever phase the line was in — it is
// being moved out from under it — leave any sub, and land with the revival
// fast-forward's registry semantics.
async function teleportLineForAdvance(session, line, targetFrame) {
  const idx = session.listFilesInLowerCase.indexOf(
    String(targetFrame).toLowerCase(),
  );
  if (idx < 0) {
    return false;
  }

  // clearLinePhase, not the bare timer cancels this used to do:
  // cancelHoldingTimer stops the TIMER but leaves `isHolding` set, and a line
  // that lands still "holding" with no timer to end it never marks its landing
  // frame done (recordArrival gates on !isHolding) — a hold-until waiting on
  // that frame, or a track group syncing on its occupants' holds, would then
  // wait for an edge that can never come. It also clears the stale per-device
  // `currentVoteTo`, so the line's next window starts from a clean tally.
  await clearLinePhase(session, line);

  while (line.subStack.length > 0) {
    line.exitSub();
  }
  line.setCurrIdxTo(idx);
  line.isGroupWaiting = false;
  orch.unparkLine(session, line);

  // Landing semantics identical to a revival fast-forward: seed the CURRENT
  // generation with the new position (leaving the old frame completes it,
  // which can release barriers parked elsewhere).
  line._lastReachedRef = null;
  if (recordArrival(session, line)) {
    await tryReleaseBarriers(session);
  }
  return true;
}

// End a straggler's holding period at the frame it already stands on, on the
// operator's command. Mirrors the holding timer's own callback (flag, admin
// hold checkbox, registry, both barrier re-checks) — the line does not move,
// so its devices need nothing beyond the cancelled countdown.
async function endHoldForAdvance(session, line) {
  if (line.isHolding || line.holdingTimer != null) {
    if (line.holdingTimer != null) {
      await cancelHoldingTimer(session, line, 1);
    } else {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BEGIN_HOLDING,
        endTime: 0,
        duration: 1,
      });
    }
    line.isHolding = false;
    line.holdingTimer = null;
    sendToAllAdmins(session, 0, {
      m: MESSAGES.MSG_CHECK_HOLD,
      isHold: false,
    });
  }
  recordHoldEnded(session, line);
  await tryReleaseBarriers(session);
  await tryReleaseGroupWaits(session);
}

// The opposite end of endHoldForAdvance: BEGIN the landing's OWN holding
// period, for the two landings no tap speaks for — the sub eject and the
// natural sub exit.
//
// An ordinary arrival carries one — stopVotingForSession sets `isHolding`
// before the line even moves and starts the frame's hold behind it — and that
// is what `holdPendingAtFrame` reads to stop a satisfied barrier releasing in
// the same tick as the arrival (§5/#6: a barrier EXTENDS the frame's own hold
// and never cuts it short). An operator move clears the phase it pulls the
// line out from under (clearLinePhase), so without this the ejected line
// landed phase-less: `recordArrival` marked its landing done on the spot, the
// hold gate read false, and a hold-until whose targets were already met
// released immediately — with a single paired rejoin-at that advanced the line
// off the frame 14 ms after its device had been told to show it (measured in a
// browser). A sub EXIT reaches that same landing by the score's own route, and
// it carried the WRONG frame's hold rather than none — see exitSubSession.
//
// The duration is the landing frame's authored `holding` value
// (`landingHoldSeconds`, off the graph the parser built), and the tap's
// `nextFrameHoldingDur` is dropped on the way past: it was read off the frame
// that tap NAMED, not the frame the line ends up standing on.
//
// The barrier ADVANCES deliberately do not get this: they exist to END a wait,
// so a fresh hold at the landing would be the opposite of the command — the
// same reason endHoldForAdvance cuts a straggler's hold short rather than
// extending it — and they never join the landing's barrier in the first place.
async function startArrivalHoldForLanding(session, line) {
  // Dropped before the read, not after: no tap speaks for this landing, and
  // landingHoldSeconds would otherwise fall back to the tap's value for a
  // frame the graph cannot answer for.
  line.nextFrameHoldingDur = null;
  if (!holdsAtLanding(session, line)) {
    return; // holding="false" on the frame, or a room that holds nowhere
  }
  await startHoldingForSessionWithDelay(session, line, 0);
}

// MSG_UPDATE_VOTING on a split frame, addressed per device. `winningVoteId` is
// stripped: a split frame has no winner — the line divides — so a single shared
// glow would point every device at one link most of them are not taking. Each
// connection instead gets `splitDestinationVoteId`, the child link the server
// currently has it going to (null for anyone outside the partition, e.g. a
// map-view tab). Splits are session-lines-only, so vanilla payloads are
// untouched.
//
// `conns` is passed in rather than filtered by line here: the final settle runs
// AFTER applySplit has already re-pointed every conn.lineId at its child.
function sendSplitVotingUpdate(countDic, destinations, conns) {
  const counts = { ...countDic };
  delete counts.winningVoteId;
  const timestamp = new Date().getTime();
  for (const conn of conns) {
    sendToClient(conn, 0, {
      m: MESSAGES.MSG_UPDATE_VOTING,
      countDic: counts,
      splitDestinationVoteId: destinations.get(conn) || null,
      timestamp,
    });
  }
}

// Every MSG_UPDATE_VOTING for a whole line goes through here so the split frame
// case (per-device destinations, above) can never be missed on one of the
// paths.
function sendVotingUpdateToLine(session, line, countDic) {
  if (isSplitFrame(session, line)) {
    sendSplitVotingUpdate(
      countDic,
      splitDestinationPreview(session, line),
      // Performers, not population: a rider is shown the tally like anyone
      // else, but is outside the partition, so its payload carries a null
      // destination. A map tab has no destination either and ignores
      // MSG_UPDATE_VOTING anyway (it reads the `lines` payload instead).
      performerLineConnections(wsServer.connections, session.id, line.id),
    );
    return;
  }
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_UPDATE_VOTING,
    countDic,
    timestamp: new Date().getTime(),
  });
}

function sendUpdateVotingToClient(conn, session, line) {
  const countDic = countVoteForLine(session, line);
  const timestamp = new Date().getTime();
  const payload = {
    m: MESSAGES.MSG_UPDATE_VOTING,
    countDic,
    timestamp,
  };
  // The tapper's own immediate echo — same split rule as the broadcast path.
  if (isSplitFrame(session, line)) {
    delete countDic.winningVoteId;
    payload.splitDestinationVoteId =
      splitDestinationPreview(session, line).get(conn) || null;
  }
  sendToClient(conn, 0, payload);
}

const isValidVote = (vote) => {
  return (
    vote !== -1 &&
    vote !== null &&
    vote !== undefined &&
    vote !== "-1" &&
    vote !== "null" &&
    vote !== "undefined"
  );
};

function isValidVoteForLine(session, line, vote) {
  if (!isValidVote(vote)) {
    return false;
  }
  if (!session.hasSessionLines) {
    return true;
  }
  if (vote === "stay") {
    return true;
  }
  return outgoingVoteIdsForLine(session, line).includes(String(vote));
}

function winningVoteIdForLine(session, line, votingData) {
  const winningVoteId = votingData && votingData.winningVoteId;
  if (isValidVoteForLine(session, line, winningVoteId)) {
    return winningVoteId;
  }
  return defaultOutgoingVoteIdForLine(session, line);
}

// Tally votes for one line: only PERFORMERS bound to line.id count, and the
// leader-stabilization state lives on the line. With a single line this is
// exactly today's session-wide tally. Map-view tabs are excluded here rather
// than relying on the map page never sending a vote.
function countVoteForLine(session, line) {
  const listConn = populationLineConnections(
    wsServer.connections,
    session.id,
    line.id,
  );
  const voteData = listConn
    .map((o) => o.currentVoteTo)
    .filter((vote) => isValidVoteForLine(session, line, vote));
  const counts = {};

  for (const frameIdx of voteData) {
    if (counts[frameIdx] !== undefined) {
      counts[frameIdx]++;
    } else {
      counts[frameIdx] = 1;
    }
  }

  if (voteData.length === 0) {
    // Votes live on websocket connections; if a voting device reconnects before
    // close, the active tally can go empty. Keep this window's last real tally
    // so the rest of the line still advances instead of falling back to STAY.
    if (line._lastVoteCounts) {
      return { ...line._lastVoteCounts };
    }
    if (isValidVoteForLine(session, line, line.currWinningId)) {
      counts.winningVoteId = line.currWinningId;
    } else {
      const defaultVoteId = isSplitFrame(session, line)
        ? null
        : defaultOutgoingVoteIdForLine(session, line);
      if (defaultVoteId) {
        counts.winningVoteId = defaultVoteId;
      }
    }
    return counts;
  }

  const winningVoteCount = Math.max(...Object.values(counts));
  const winningVoteIds = [];
  for (const [voteId, voteCount] of Object.entries(counts)) {
    if (voteCount === winningVoteCount) {
      winningVoteIds.push(voteId);
    }
  }

  // Select random winning note in case 2 or more notes have the same vote count
  if (
    line.currWinningId &&
    winningVoteIds.includes(line.currWinningId) &&
    line.previousWinningCount === winningVoteIds.length
  ) {
    counts.winningVoteId = line.currWinningId;
  } else {
    const randomWinningIdx = Math.floor(Math.random() * winningVoteIds.length);
    counts.winningVoteId = winningVoteIds[randomWinningIdx];
  }

  line.previousWinningCount = winningVoteIds.length;
  line.currWinningId = counts.winningVoteId;
  line._lastVoteCounts = { ...counts };

  return counts;
}

const parseCustomDur = (defaultDur, customDur) => {
  if (!customDur) {
    return defaultDur;
  }

  if (customDur === "false") {
    return 0;
  } else if (customDur.endsWith("%")) {
    return (defaultDur * Number(customDur.replace("%", ""))) / 100;
  } else {
    return Number(customDur);
  }
};

// `initiator` is the tap that OPENED this window ({ conn, voteId }), if any: a
// vote already cast, which must survive the reset below so the split's opening
// push already knows where the tapper is going (see there).
async function startVotingForSessionWithDelay(
  session,
  line,
  timeDelay,
  customDur,
  skipGroupSync = false,
  initiator = null,
) {
  const sessionId = session.id;
  line.currentVotingDuration = customDur
    ? parseCustomDur(session.votingDuration, customDur)
    : session.votingDuration;
  line.currentBeginTimeStamp = Date.now() + timeDelay;
  line.currentEndTimeStamp =
    line.currentBeginTimeStamp + line.currentVotingDuration * 1000;
  line.isVoting = true;
  line.isStandby = false;
  line.currWinningId = undefined;
  line.previousWinningCount = 0;
  line._lastVoteCounts = null;

  //start voting data timer
  line.votingTimeStamp = 0;
  line.didSendStopVoting = false;
  const votingTimer = setInterval(() => {
    session
      .runExclusively(async () => {
        if (line.votingTimer !== votingTimer) return;
        line.votingTimeStamp += session.synTimeInterval * 1000;

        if (line.didSendStopVoting) {
          clearInterval(votingTimer);
          line.votingTimer = null;
          return;
        }

        sendVotingUpdateToLine(session, line, countVoteForLine(session, line));

        if (
          !line.didSendStopVoting &&
          line.votingTimeStamp >= (line.currentVotingDuration - 1) * 1000
        ) {
          await stopVotingForSession(session, line);
          line.didSendStopVoting = true;
        }

        if (line.votingTimeStamp >= line.currentVotingDuration * 1000) {
          clearInterval(votingTimer);
          line.votingTimer = null;
        }
      })
      .catch((e) => console.error("voting timer error", e));
  }, session.synTimeInterval * 1000);
  line.votingTimer = votingTimer;

  await session.saveSessionStateToFile();

  wsServer.connections.forEach((conn) => {
    if (conn.sessionId === sessionId && conn.lineId === line.id) {
      conn.currentVoteTo = -1;
    }
  });

  // …except the tap that opened this window: the reset above clears the votes
  // of the PREVIOUS window, and that one belongs to the new one. Re-applying it
  // here rather than leaving it to the caller (which only resumes after this
  // whole function has run) is what keeps the split push below from describing
  // the tapper as an unassigned straggler.
  if (initiator && initiator.conn) {
    initiator.conn.currentVoteTo = initiator.voteId;
  }

  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_BEGIN_VOTING,
    endTime: line.currentEndTimeStamp,
    duration: line.currentVotingDuration,
  });

  // A split's choice window opens with every device already assigned a
  // destination (stragglers ⇒ a balanced spread). Push it now instead of
  // leaving play-mode devices — which cannot tap, so this marker is their only
  // cue — with a blank frame until the first tick.
  //
  // The opening tap must be in hand by here (`initiator`, above). Computed
  // without it, this push tells the tapper it was balanced somewhere — a blue
  // "auto" marker that flashes for the few ms until its own echo replaces it
  // with orange, reading as the app overriding a choice just made.
  if (isSplitFrame(session, line)) {
    sendVotingUpdateToLine(session, line, countVoteForLine(session, line));
  }

  // Session Lines: a track-group's voting windows are time-synchronized. When a
  // line on a grouped frame starts voting, open matching windows on the other
  // votable co-group lines (same duration), so the group closes together (L).
  if (session.hasSessionLines && !skipGroupSync) {
    await openCoGroupWindows(session, line);
  }

  // Admin map: voting is a between-landings state change, so the per-line
  // snapshot must be re-pushed here (vanilla map reads MSG_BEGIN_VOTING itself).
  if (session.hasSessionLines) {
    updateNumberOfConnectionForSession(session);
  }
}

// The track group of a line's current (main-flow) frame, or null.
function groupOfCurrentFrame(session, line) {
  if (!session.hasSessionLines || line.subStack.length > 0) {
    return null;
  }
  return orch.groupOfFrame(session.graph, frameNameForLine(session, line));
}

// Start synchronized voting windows on the co-group lines of `initiator`.
async function openCoGroupWindows(session, initiator) {
  const group = groupOfCurrentFrame(session, initiator);
  if (!group) {
    return;
  }
  const groupFrames = orch.groupFramesLower(session.graph, group);
  const coLines = orch
    .linesOnGroupFrames(
      activeLines(session),
      (l) => frameNameForLine(session, l),
      groupFrames,
    )
    .filter(
      (l) =>
        l.id !== initiator.id &&
        l.subStack.length === 0 &&
        !l.isVoting &&
        !l.isStandby &&
        !l.isBarrierWaiting &&
        !l.isGroupWaiting,
    );

  // Match the initiator's resolved duration exactly (decision #3: initiator's
  // duration). skipGroupSync=true so co-lines don't recursively re-open windows.
  const syncDur = String(initiator.currentVotingDuration);
  for (const l of coLines) {
    await startVotingForSessionWithDelay(session, l, 100, syncDur, true);
  }
}

// Resolve a whole track group at window close. Across all grouped lines' tallies
// pick the single global-max (random tiebreak); if it is a STAY, every grouped
// line stays; otherwise each line advances to its own link winner — except a
// line on a split frame, which divides via resolveSplit (balanced children)
// rather than moving whole. Each surviving line's winningVoteId is set so the
// client glow follows (no client change).
async function resolveGroupVoting(session, line) {
  const group = groupOfCurrentFrame(session, line);
  const groupFrames = orch.groupFramesLower(session.graph, group);
  const groupLines = orch
    .linesOnGroupFrames(
      activeLines(session),
      (l) => frameNameForLine(session, l),
      groupFrames,
    )
    // A group-parked line took no part in this round (arrival barrier) — don't
    // sweep it into the resolution; it votes from the group's next round on.
    .filter((l) => l.subStack.length === 0 && !l.isGroupWaiting);
  if (!groupLines.includes(line)) {
    groupLines.push(line);
  }

  // Stop every grouped line's window so their own timers don't double-resolve.
  for (const l of groupLines) {
    if (l.votingTimer) {
      clearInterval(l.votingTimer);
      l.votingTimer = null;
    }
    l.isVoting = false;
    l.didSendStopVoting = true;
  }

  // Global stay decision across the group. Tally each line ONCE (the tally
  // mutates the line's leader-stabilization state and re-randomizes ties) and
  // reuse the same counts for the per-line link winner below.
  const countsByLine = new Map();
  const tallies = groupLines.map((l) => {
    const counts = countVoteForLine(session, l);
    countsByLine.set(l.id, counts);
    const stripped = { ...counts };
    delete stripped.winningVoteId;
    return { lineId: l.id, counts: stripped };
  });
  const { isStay } = orch.resolveGroupStay(tallies, () => Math.random());

  // One id for however many forks this release makes, so the map can offer the
  // release as ONE undo instead of one per line — allocated lazily, because
  // most releases fork nothing and an unused id would still be persisted.
  let gestureId = null;

  for (const l of groupLines) {
    // A grouped SPLIT frame still divides its line when the group advances :
    // delegate to resolveSplit — choosers land on their tapped child,
    // stragglers are balanced across the children — instead of moving the
    // whole line to a single link winner. A global STAY brakes the split like
    // any other grouped line (falls through to the stay handling below). Must
    // run before this line's votes are cleared: resolveSplit reads
    // conn.currentVoteTo for the choices. …but only when there is somebody on
    // it to divide. A grouped window opens for EVERY line in the group, empty
    // ones included, so an unpopulated line parked on a grouped split frame
    // used to divide nobody into two empty lines on every release — the room's
    // line count doubling each time the group let go. Falling through instead
    // treats it like any other unpopulated grouped line: it advances whole, on
    // its default link, and stays one line.
    if (!isStay && isSplitFrame(session, l) && lineHasPopulation(session, l)) {
      if (!gestureId) gestureId = orch.allocSplitGestureId(session);
      await resolveSplit(session, l, gestureId);
      continue;
    }

    l.isStandby = true;

    // The tally computed above, BEFORE clearing votes (resetting first would
    // wipe the link winner, so groupLinkWinner returns null and every grouped
    // line falls through to STAY — the frame counts down and never advances).
    const counts = countsByLine.get(l.id);
    let winningId;
    let targetIdx;
    if (isStay) {
      winningId = "stay";
      targetIdx = l.currentIndex;
    } else {
      const linkWinner = orch.groupLinkWinner(counts, () => Math.random());
      if (linkWinner == null) {
        const defaultVoteId = defaultOutgoingVoteIdForLine(session, l);
        if (defaultVoteId == null) {
          winningId = "stay";
          targetIdx = l.currentIndex;
        } else {
          winningId = defaultVoteId;
          targetIdx = Number(defaultVoteId.split("#")[0]);
        }
      } else {
        winningId = linkWinner;
        targetIdx = Number(linkWinner.split("#")[0]);
      }
    }
    l.currWinningId = winningId;

    // Now clear this line's client votes for the next window.
    wsServer.connections.forEach((conn) => {
      if (conn.sessionId === session.id && conn.lineId === l.id) {
        conn.currentVoteTo = -1;
      }
    });

    // Final glow update: the client follows countDic.winningVoteId. (Split
    // lines never reach here — they were delegated to resolveSplit above, which
    // sends per-device destinations instead of one shared winner.)
    counts.winningVoteId = winningId;
    sendVotingUpdateToLine(session, l, counts);

    // A grouped line whose link winner is a session-sub-start link dives into
    // its sub (the group advanced; this line's advance IS the dive).
    const subLink =
      winningId === "stay"
        ? null
        : subLinkForAdvanceTarget(session, l, targetIdx);
    if (winningId !== "stay" && !subLink) {
      l.setCurrIdxTo(targetIdx);
    }

    // Asked of the frame this line is NOW on (`holdsAtLanding`) — a STAY's
    // landing is the frame it never left. A dive is excluded: it has not moved
    // yet and lands on the sub's START, whose hold `enterSubSession` starts.
    // `isHolding` is set synchronously because `recordArrival`, moments later,
    // reads it to tell an "arrived" landing from a "done" one; the timer below
    // reuses the same answer so the two can never disagree.
    const holds = !subLink && holdsAtLanding(session, l);
    if (holds) {
      l.isHolding = true;
    }

    const standbyTimer = setTimeout(() => {
      session
        .runExclusively(async () => {
          if (l.standbyTimer !== standbyTimer) return;
          l.isStandby = false;
          if (holds) {
            await startHoldingForSessionWithDelay(session, l, 0);
          }
          l.standbyTimer = null;
          await session.saveSessionStateToFile();
          // The standby gap is over (holdPendingAtFrame): with no holding to
          // run, this is the edge a barrier parked on this line waits for.
          if (session.hasSessionLines) {
            await tryReleaseBarriers(session);
          }
        })
        .catch((e) => console.error("group standby timer error", e));
    }, 1000);
    l.standbyTimer = standbyTimer;

    emitHistoryToAdmins(session, l);

    if (subLink) {
      await diveViaSubLink(session, l, subLink);
    } else if (winningId !== "stay") {
      await showLineAfterArrivalIfNeeded(session, l);
    }
  }

  await session.saveSessionStateToFile();
  // Admin map: a global STAY resolves without any landing, so no snapshot went
  // out — push one so the voting glyphs clear (extra one on advance is fine).
  updateNumberOfConnectionForSession(session);
}

async function stopVotingForSession(session, line) {
  // Clear the voting timer immediately to stop sending MSG_UPDATE_VOTING
  if (line.votingTimer) {
    clearInterval(line.votingTimer);
    line.votingTimer = null;
  }

  // Additional safety: ensure voting state is properly reset
  line.isVoting = false;
  line.didSendStopVoting = true;

  // Session Lines: a window closing on a track-grouped frame resolves the whole
  // group together (global-stay override). Checked BEFORE the split path so a
  // grouped split frame gets the same resolution no matter whose synchronized
  // window happens to close first — resolveGroupVoting runs the global-stay
  // contest and delegates split-frame lines to resolveSplit itself.
  if (groupOfCurrentFrame(session, line)) {
    await resolveGroupVoting(session, line);
    return;
  }

  // Session Lines: a choice window closing on a split frame divides the line
  // instead of advancing it. (Gated — vanilla scores never reach this.)
  // Nobody on it ⇒ nothing to divide, and it advances whole instead — the same
  // rule the grouped path applies, for the window a line can still be holding
  // when its last device goes.
  if (isSplitFrame(session, line) && lineHasPopulation(session, line)) {
    await resolveSplit(session, line);
    return;
  }

  line.isStandby = true;

  //stand by signal
  const votingData = countVoteForLine(session, line);
  const winningVoteId = winningVoteIdForLine(session, line, votingData);
  const mostVoteRingId =
    winningVoteId === "stay"
      ? line.currentIndex
      : // ID should follow format: nextVoteId#currFileName#aEleIndex
        Number(winningVoteId?.split("#")[0] ?? line.currentIndex);

  // Reset this line's client votes
  wsServer.connections.forEach((conn) => {
    if (conn.sessionId === session.id && conn.lineId === line.id) {
      conn.currentVoteTo = -1;
    }
  });

  // Session Lines: a winning session-sub-start link DIVES into its sub-score
  // instead of moving (the link's href is the return landing, reached on exit).
  const subLink =
    winningVoteId === "stay"
      ? null
      : subLinkForAdvanceTarget(session, line, mostVoteRingId);
  if (!subLink) {
    line.setCurrIdxTo(mostVoteRingId);
  }

  // Asked of the frame the line is NOW on — see the twin in resolveGroupVoting.
  const holds = !subLink && holdsAtLanding(session, line);
  if (holds) {
    line.isHolding = true;
  }
  //unlock
  const standbyTimer = setTimeout(() => {
    session
      .runExclusively(async () => {
        if (line.standbyTimer !== standbyTimer) return;
        line.isStandby = false;
        if (holds) {
          await startHoldingForSessionWithDelay(session, line, 0);
        }
        line.standbyTimer = null;
        await session.saveSessionStateToFile();
        // See the twin in resolveGroupVoting: the end of the standby gap is a
        // barrier re-check edge when no holding period follows it.
        if (session.hasSessionLines) {
          await tryReleaseBarriers(session);
        }
      })
      .catch((e) => console.error("standby timer error", e));
  }, 1000);
  line.standbyTimer = standbyTimer;
  await session.saveSessionStateToFile();

  emitHistoryToAdmins(session, line);

  if (subLink) {
    await diveViaSubLink(session, line, subLink);
  } else {
    await showLineAfterArrivalIfNeeded(session, line);
  }
}

async function startHoldingForSessionWithDelay(session, line, delay) {
  line.isHolding = true;
  //holding cooldown
  line.currentHoldingDuration = landingHoldSeconds(session, line);
  line.nextFrameHoldingDur = null;
  line.currentBeginHoldTimeStamp = new Date().getTime() + delay;
  line.currentEndHoldTimeStamp =
    line.currentBeginHoldTimeStamp + line.currentHoldingDuration * 1000;

  //unlock
  const holdingTimer = setTimeout(() => {
    session
      .runExclusively(async () => {
        if (line.holdingTimer !== holdingTimer) return;
        line.isHolding = false;
        sendToAllAdmins(session, 0, {
          m: MESSAGES.MSG_CHECK_HOLD,
          isHold: line.isHolding,
        });
        line.holdingTimer = null;
        // Rendezvous (#6): the frame's own holding period just ended — its
        // targets are now fully satisfied; re-check open barriers. UNconditional
        // (it used to run only on the "became done" edge): a barrier held open
        // solely because THIS line was still holding at it needs the re-check
        // even when the ref was already done in the registry from an earlier
        // pass, or it would wait for an edge that never comes.
        recordHoldEnded(session, line);
        await tryReleaseBarriers(session);
        // Track-group hold sync: a group parked on this occupant's hold releases
        // only now that it ended — the hold-end edge where the group's blocked
        // set shrinks. Releases when the LAST occupant unholds.
        await tryReleaseGroupWaits(session);
        await session.saveSessionStateToFile();
        // Admin map: hold ended between landings — refresh the holding flags.
        if (session.hasSessionLines) {
          updateNumberOfConnectionForSession(session);
        }
      })
      .catch((e) => console.error("holding timer error", e));
  }, line.currentHoldingDuration * 1000);
  line.holdingTimer = holdingTimer;
  await session.saveSessionStateToFile();

  sendToAllAdmins(session, 0, {
    m: MESSAGES.MSG_CHECK_HOLD,
    isHold: line.isHolding,
  });
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_BEGIN_HOLDING,
    endTime: line.currentEndHoldTimeStamp,
    duration: line.currentHoldingDuration,
  });
}

/**
 * Take a line out from under whatever phase it is in — holding, standby,
 * voting — and clear the per-device votes that belonged to it.
 *
 * The flags go with the timers. Cancelling the timers alone leaves a line
 * "holding" with nothing left to end it, and such a line never marks its
 * landing frame done (`recordArrival` gates on `!isHolding`), so a hold-until
 * waiting on that frame — or a track group syncing on its occupants' holds —
 * waits for an edge that can never come.
 *
 * It was named for the room rewind, which is where it started, and it is no
 * longer only that: both ends of a dive, a rejoin the survivor travelled to,
 * and the two operator valves all reach it, because every one of them moves a
 * line somewhere the phase it is carrying does not belong to. Some of those
 * then start the LANDING's own phase (`startArrivalHoldForLanding`); the
 * rewinds and advances deliberately do not.
 */
async function clearLinePhase(session, line) {
  if (line.isHolding || line.holdingTimer != null) {
    if (line.holdingTimer != null) {
      await cancelHoldingTimer(session, line, 1);
    } else {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BEGIN_HOLDING,
        endTime: 0,
        duration: 1,
      });
    }
    line.isHolding = false;
    line.holdingTimer = null;
  }

  if (line.standbyTimer) {
    clearTimeout(line.standbyTimer);
  }
  line.standbyTimer = null;
  line.isStandby = false;

  if (line.isVoting || line.votingTimer != null) {
    if (line.votingTimer != null) {
      await cancelVotingTimer(session, line);
    } else {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BEGIN_VOTING,
        endTime: 0,
        duration: 0,
      });
    }
    line.isVoting = false;
    line.votingTimer = null;
    line.currWinningId = undefined;
    line.previousWinningCount = 0;
    line._lastVoteCounts = null;
  }

  wsServer.connections.forEach((conn) => {
    if (conn.sessionId === session.id && conn.lineId === line.id) {
      conn.currentVoteTo = -1;
    }
  });
}

//
// Returns a refusal reason, or null when it ran. Every one of the returns below
// used to be a bare `return`, so a click on a checkpoint the room had just
// stopped sharing was answered with silence — indistinguishable from a bug, and
// the more confusing because THIS is the rewind that expires merge undos.
// Nothing has moved at any of them: the whole plan is resolved before the first
// line is touched.
async function roomRewind(session, group) {
  if (!session.hasSessionLines || !session.graph || !session.graph.groups) {
    return { refusal: "no-checkpoints", moved: false };
  }
  const groups = session.graph.groups;
  let lines = nonRetiredLines(session);
  // Whether this group IS a checkpoint is the MENU population's question, and
  // it stays theirs after the rejoin undos below bring absorbed lines back: a
  // line that merged in before ever reaching this group has no occurrence of it
  // to pass, so re-asking the question of the restored room would turn the
  // gesture into `not-a-checkpoint` half-way through. `roomRewindPlan` splits
  // the two roles for exactly this reason — `checkpointLines` decide legality,
  // `lines` are the ones placed: by their own trail where they have an
  // occurrence, then by the route their forks recorded, and only then by fill.
  const checkpointLines = populatedRewindCheckpointLines(session, lines);
  const planFor = (currentLines) =>
    orch.roomRewindPlan({
      group,
      groups,
      checkpointLines,
      lines: currentLines.map(rewindLineSnapshot),
      // Read only for the lines whose own trail does not reach the checkpoint —
      // the forks they came from say where their route crossed it.
      splitEvents: session.splitEvents,
    });
  let plan = planFor(lines);
  if (!plan) {
    return { refusal: "not-a-checkpoint", moved: false };
  }

  // The rejoins the room made SINCE this checkpoint come off first (owner:
  // rewinding the ROOM from a merged node back to an older barrier arrived
  // with two lines where the room had crossed that barrier with three).
  // Repositioning across a rejoin without undoing it is the room-scale version
  // of the walk `lineRewind` refuses to make: the barrier being returned to is
  // a moment those lines were still separate, so landing there with one of
  // them swallowed is a room the score never produced.
  // `mergesBehindRoomRewind` measures SINCE in each survivor's own trail,
  // against the frame this rewind is landing it on. …and the FORKS, for the
  // mirror reason. Undoing only the rejoins got half the rule: the room could
  // still come back with MORE lines than it crossed the checkpoint with,
  // because every split made since was left standing. When the checkpoint
  // frame is itself a split frame — one carrying both `session-track-group`
  // and `session-split` — that is not cosmetic: the rewind lands all of those
  // extra lines back on it and the next group release forks every one of them,
  // so each rewind-and-replay multiplied the room instead of restoring it.
  const behind = [
    ...orch
      .mergesBehindRoomRewind({
        mergeEvents: session.mergeEvents,
        lines,
        plan,
      })
      .map((event) => ({ kind: "merge", event })),
    ...orch
      .splitsBehindRoomRewind({
        splitEvents: session.splitEvents,
        groupFrames: orch.groupFramesLower(session.graph, group),
      })
      .map((event) => ({ kind: "split", event })),
  ]
    // One order for the whole room across BOTH kinds: a fork built on a rejoin
    // has to come off before it. `orch.compareStructural` is the ordering
    // every chain walk uses, read newest-first — this list used to have a
    // comparator of its own, which is one rule too many for one question.
    // Exact ties fall to this array's own order (a stable sort), which puts
    // the rejoins ahead of the forks exactly as `structuralEvents` would.
    .sort((a, b) => orch.compareStructural(b, a));
  // Asked before anything moves, so a step that cannot come off costs the room
  // nothing — this rewind's own rule is that the whole plan resolves first.
  // Only a legacy `expired` event can answer no now that a room rewind expires
  // nothing, and repositioning regardless would be the bug above, committed in
  // silence.
  for (const { kind, event } of behind) {
    if (
      !orch.structuralRewindChain({ session, kind, eventId: event.id })
        .available
    ) {
      return {
        refusal: kind === "split" ? "split-undo-refused" : "merge-undo-refused",
        moved: false,
      };
    }
  }

  // One operator gesture, one display drive. The undos and the repositioning
  // under them are steps of a single rewind, so every device is addressed once,
  // at the end (`flushDisplayHold`) — the devices an undo hands back to a
  // restored line included, which no MSG_SHOW of this function's could reach.
  // Opened HERE, before a dive is unwound, because the drive decides each
  // connection's message from the view it was in when the gesture began.
  const hold = openDisplayHold(session);
  let moved = false;
  try {
    for (const { kind, event } of behind) {
      // A convergence undoes whole and a cascade takes its own dependants with
      // it, so an event further down this list may already be gone by the time
      // we reach it — the walk working, not a refusal.
      if (event.status !== "active") {
        continue;
      }
      const step =
        kind === "split"
          ? await splitRewind(session, event.id, event.frame)
          : await mergeRewind(session, event.id, event.frame);
      if (step.moved) moved = true;
      if (!step.ok) {
        // REFUSE rather than reposition anyway: a fork or rejoin still standing
        // is exactly the room this rule exists to prevent, and `moved` carries
        // whatever the earlier steps already committed.
        return {
          refusal:
            kind === "split" ? "split-undo-refused" : "merge-undo-refused",
          moved,
        };
      }
    }
    if (behind.length > 0) {
      // Population and trails have both changed under the plan: lines came
      // back or collapsed away, and every survivor's trail is truncated to
      // where it stood before its rejoin or its fork.
      lines = nonRetiredLines(session);
      plan = planFor(lines);
      if (!plan) {
        return { refusal: "not-a-checkpoint", moved };
      }
    }

    const byLineId = new Map(plan.lines.map((p) => [p.lineId, p]));
    const landings = [];
    for (const line of lines) {
      const entry = byLineId.get(line.id);
      if (!entry) {
        return { refusal: "line-unplaced", moved };
      }
      const idx = session.listFilesInLowerCase.indexOf(
        String(entry.frame).toLowerCase(),
      );
      if (idx < 0) {
        return { refusal: "frame-missing", moved };
      }
      landings.push({
        line,
        index: idx,
        frame: session.listFiles[idx],
        source: entry.source,
        historyIndex: entry.historyIndex,
      });
    }

    const landingHoldTargets = [];
    const seenHoldTarget = new Set();
    for (const landing of landings) {
      for (const target of (session.graph.holdUntilTargets || {})[
        landing.frame
      ] || []) {
        const key = String(target).toLowerCase();
        if (!seenHoldTarget.has(key)) {
          seenHoldTarget.add(key);
          landingHoldTargets.push(target);
        }
      }
    }

    const parkedAt = new Map();
    for (const landing of landings) {
      const { line } = landing;
      parkedAt.set(
        line.id,
        line.isBarrierWaiting || line.isGroupWaiting
          ? frameNameForLine(session, line)
          : null,
      );
      await clearLinePhase(session, line);
      // Popping subStack here only fixes the SERVER's idea of where the line
      // is; the devices are still in sub view, and the one display drive at the
      // end is what takes them out of it — it compares the view each was in
      // when the hold opened against the view its line ends in.
      while (line.subStack.length > 0) {
        line.exitSub();
      }
    }

    orch.beginReachedGeneration(session, landingHoldTargets);

    for (const { line, index, frame, source, historyIndex } of landings) {
      const wasGroupParked = line.isGroupWaiting === true;
      line.isGroupWaiting = false;
      if (orch.unparkLine(session, line) || wasGroupParked) {
        sendToLine(session, line.id, 0, {
          m: MESSAGES.MSG_BARRIER_RELEASED,
          frame: parkedAt.get(line.id),
        });
      }
      line._lastReachedRef = null;
      if (source === "history") {
        line.historyIndex = historyIndex;
      }
      line.setCurrIdxTo(index);
      recordArrival(session, line);

      if (orch.groupOfFrame(session.graph, frame)) {
        session.latestGroupArrival = { frame, at: Date.now() };
      }
    }

    await tryReleaseBarriers(session);
    await tryReleaseGroupWaits(session);
    await session.saveSessionStateToFile();
    notifyAdminsBarriers(session);
    pushAdminHistory(session);
    updateNumberOfConnectionForSession(session);

    // Every line the gesture touched — repositioned, or brought back by an undo
    // on the way — told once, in the shape its own devices need: a line dragged
    // out of a sub-score gets MSG_SUB_EXIT rather than a bare MSG_SHOW (its
    // devices still hold the SUB's injected frame list, so a main-flow index
    // resolves to no frame there), and a paused room keeps its placeholder.
    for (const { line } of landings) {
      holdLineDisplay(session, line);
    }
    return { refusal: null, moved: true };
  } finally {
    flushDisplayHold(hold);
  }
}

// Structural split rewind: collapse every current descendant of one split
// instance back into its original parent at the split frame. Nested descendant
// splits collapse recursively through splitAncestors. A split event crossed by
// a later outside merge is refused by splitRewindPlan — that merged population
// cannot be separated safely without per-device ancestry.
//
// Unlike a room-checkpoint rewind, this is a SUBTREE rewind: unrelated lines do
// not move, so the room's reached registry + latestGroupArrival stay intact.
//
// Returns `{ ok, moved }`, not a bare boolean: the walk commits step by step,
// so "it did not finish" and "nothing happened" are different answers and the
// operator has to be told which one they got (see `reportRewindRefusal`).
async function splitRewind(session, eventId, expectedFrame) {
  if (!session.hasSessionLines) {
    return { ok: false, moved: false };
  }
  // The race guard belongs BEFORE the walk. The chain commits real topology
  // changes step by step, so leaving the guard to the final step meant a stale
  // menu bought all of them and was then refused: one click on a split whose
  // frame had moved took a whole rejoin off the room and collapsed nothing.
  if (!structuralGuardHolds(session.splitEvents, eventId, expectedFrame)) {
    return { ok: false, moved: false };
  }
  // One gesture, one display drive — the walk below can be several validated
  // steps and the devices are told once, at the end (`flushDisplayHold`). The
  // `finally` covers the refusal paths too: a walk that stops part-way has
  // still moved the room, and the devices standing in it must be told where.
  const hold = openDisplayHold(session);
  try {
    // ONE RELEASE, ONE GESTURE — the fork counterpart of the convergence rule
    // above. A track group's release forks every populated line standing on a
    // split frame, so one thing the operator watched is several events;
    // undoing one of them left the room in a shape no single gesture had
    // produced. Newest-first like every other walk, each member with its own
    // cascade taken off first. Sibling forks divide DIFFERENT lines, so none
    // of them is in another's chain and the order between them carries no
    // constraint of its own.
    //
    // The race guard is this event's frame; the siblings are guarded by their
    // own recorded frames, which is all they were ever offered under.
    let moved = false;
    let undone = 0;
    for (const event of orch.splitGestureEvents({
      splitEvents: session.splitEvents,
      eventId,
    })) {
      // Already off — taken by an earlier member's cascade, or by something it
      // was nested in. That is the walk working, not a refusal.
      if (event.status !== "active") {
        undone++;
        continue;
      }
      const chain = await undoStructuralChain(session, "split", event.id);
      moved = moved || chain.moved;
      if (!chain.ok) {
        return { ok: false, moved };
      }
      if (structuralEventDone(session.splitEvents, event.id)) {
        undone++;
        moved = true;
        continue;
      }
      const done = await splitRewindOne(
        session,
        event.id,
        event.id === eventId ? expectedFrame : event.frame,
      );
      if (!done) {
        // Refuse rather than stop quietly: half a release undone is exactly
        // the room this fold exists to prevent, and `moved` carries whatever
        // the earlier members already committed.
        return { ok: false, moved };
      }
      undone++;
      moved = true;
    }
    return { ok: undone > 0, moved };
  } finally {
    flushDisplayHold(hold);
  }
}

// One recorded split event, collapsed — with nothing of the room's built on
// top of it any more (its caller cleared that first).
async function splitRewindOne(session, eventId, expectedFrame) {
  if (!session.hasSessionLines) {
    return false;
  }
  const plan = orch.splitRewindPlan({
    splitEvents: session.splitEvents,
    lines: session.lines,
    eventId,
    expectedFrame,
  });
  if (!plan.available) {
    return false;
  }

  // Synchronous phase cleanup before any connection changes: old child tabs
  // must receive cancellation / banner-release messages while still addressed
  // to their child line ids. No await here, so the topology guard cannot race
  // a landing between validation and commit.
  for (const line of plan.descendants) {
    cancelAttritionTimer(line);
    if (line.isHolding || line.holdingTimer != null) {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BEGIN_HOLDING,
        endTime: 0,
        duration: 1,
      });
    }
    if (line.isVoting || line.votingTimer != null) {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BEGIN_VOTING,
        endTime: 0,
        duration: 0,
      });
    }
    if (line.isBarrierWaiting || line.isGroupWaiting) {
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BARRIER_RELEASED,
        frame: frameNameForLine(session, line),
      });
    }
    line.clearAllTimer();
    line.isGroupWaiting = false;
    orch.unparkLine(session, line);
  }

  const result = orch.rewindSplitStructure({
    session,
    eventId,
    expectedFrame,
    connections: wsServer.connections,
  });
  if (!result.available) {
    return false;
  }

  const parent = result.parent;
  cancelAttritionTimer(parent);
  parent.trackGroup = orch.groupOfFrame(session.graph, result.event.frame);
  // Preserve the current room generation, but record the restored parent's
  // landing in it (same landing rule as a targeted line rewind).
  parent._lastReachedRef = null;
  recordArrival(session, parent);

  await tryReleaseBarriers(session);
  await tryReleaseGroupWaits(session);
  await session.saveSessionStateToFile();

  // All live + map connections in the collapsed subtree now carry parent.id.
  sendToLine(session, parent.id, 0, {
    m: MESSAGES.MSG_LINE_ASSIGNED,
    lineId: parent.id,
  });
  notifyAdminsBarriers(session);
  pushAdminHistory(session);
  updateNumberOfConnectionForSession(session);

  // The display itself is the GESTURE's, not this step's: a collapse can be one
  // move of a walk-back, and a device told about this frame now is a device
  // watching the room flash through a state it is in the middle of discarding
  // (`flushDisplayHold`). The devices in SUB view are the hold's concern too —
  // it captures its own set when the gesture opens, which for a walk is the
  // only moment that still describes what every device is rendering (a step's
  // own MSG_SUB_EXIT is suppressed with everything else, and the line a device
  // ends on may have been in the main flow all along). §16's defect — a
  // main-flow index resolved against an injected sub's frame list — is answered
  // there, once, for whatever the walk finally leaves standing.
  holdLineDisplay(session, parent);
  return true;
}

// Everything the room built on top of ONE structural event, walked off first —
// newest first (owner: "able to rewind back to multiple merge points later
// still possible, not losing the route path").
//
// A merge used to stop being undoable the moment the merged line took its next
// structural step, so on a score like FORK → MERGE1 → FORK2 → MERGE2 only the
// newest convergence was ever reachable. Nothing expires now: the split at
// FORK2 and the merge at MERGE2 are simply undone on the way back to MERGE1,
// each one an ordinary fully-validated snapshot restore, so the room walks its
// own history backwards instead of jumping to a state no snapshot describes.
// orch.structuralRewindChain decides what is standing on top (transitively, by
// durable line identity — a recycled number does NOT drag an unrelated branch
// in) and in what order.
//
// Returns `{ ok, moved }`. `moved` is the honest half: a walk that stops at
// step k has ALREADY committed steps 1..k-1, and every caller used to collapse
// that into `false` — which the map then reported as "Nothing moved", the one
// thing it certainly was not. Nothing here can put the committed steps back
// (each is a validated snapshot restore in its own right), so the room keeps
// them and the operator is told the walk stopped part-way.
async function undoStructuralChain(session, kind, eventId) {
  const chain = orch.structuralRewindChain({ session, kind, eventId });
  if (!chain.available) {
    return { ok: false, moved: false };
  }
  let moved = false;
  for (const step of chain.chain) {
    // A convergence undoes whole, so a later step may already be gone by the
    // time we reach it — that is the walk working, not a refusal.
    if (step.event.status !== "active") {
      continue;
    }
    if (step.kind === "split") {
      if (!(await splitRewindOne(session, step.event.id, null))) {
        return { ok: false, moved }; // stop here rather than leave a half-walk
      }
      moved = true;
      continue;
    }
    const undone = await mergeRewindConvergence(
      session,
      step.event.id,
      step.event.frame,
    );
    moved = moved || undone.moved;
    if (!undone.ok) {
      return { ok: false, moved };
    }
  }
  return { ok: true, moved };
}

// Structural merge rewind: undo one rejoin. Every line the merge absorbed
// comes back at the frame it was standing on when it ran, carrying the devices
// it had then, and the merged line goes back to its own pre-merge frame — the
// mirror of the split undo, for the one structural event that DESTROYS lines.
// Devices whose first sight of the room was after the merge have no pre-merge
// line and stay with the survivor.
//
// Like the split undo this is a SUBTREE rewind: the reached registry and
// latestGroupArrival stay as they are, and the restored lines land un-parked and
// phase-less, an operator rewind being authoritative. Their next window is an
// ordinary one, so a route that leads back to the rejoin frame merges them
// again — this replays the passage rather than unmaking it.
//
// ONE CONVERGENCE, ONE GESTURE (owner): lines arriving on a rejoin frame apart
// merge in PAIRS, so "everyone met at MERGE1" can be two or three events. The
// operator watched one thing happen and asked for one undo of it, so this
// walks the whole passage (orch.mergeConvergenceEvents) newest-first — the
// only order §8.4 allows — and every line that met there comes back on the
// node it came from. Undoing the newest frees the next, so each step is an
// ordinary, fully validated undo; the pairing is left as the record of how the
// room got there rather than a queue of clicks.
//
// Returns `{ ok, moved }` for the same reason `splitRewind` does — a cascade
// that stops part-way has moved the room, and saying otherwise is a lie the
// operator has no way to check.
async function mergeRewind(session, eventId, expectedFrame) {
  if (!session.hasSessionLines) {
    return { ok: false, moved: false };
  }
  // Guard first, walk second — see `structuralGuardHolds`. Nothing below this
  // line is free to the room, so a stale menu must be turned away before any
  // of it runs.
  if (!structuralGuardHolds(session.mergeEvents, eventId, expectedFrame)) {
    return { ok: false, moved: false };
  }
  // One gesture, one display drive: the walk below is several validated steps
  // and the devices are told once, at the end (`flushDisplayHold`).
  const hold = openDisplayHold(session);
  try {
    // Whatever the room built on this population since — later splits, later
    // merges — comes off first, so a merge point stays reachable for the rest
    // of the session instead of only until the next fork.
    const chain = await undoStructuralChain(session, "merge", eventId);
    if (!chain.ok) {
      return { ok: false, moved: chain.moved };
    }
    // A convergence undoes WHOLE, so a later event of this very passage may
    // have taken this one with it on the way back. That is the undo working:
    // the rejoin the operator clicked is gone.
    if (structuralEventDone(session.mergeEvents, eventId)) {
      return { ok: true, moved: true };
    }
    const undone = await mergeRewindConvergence(
      session,
      eventId,
      expectedFrame,
    );
    return { ok: undone.ok, moved: chain.moved || undone.moved };
  } finally {
    flushDisplayHold(hold);
  }
}

/**
 * Does the menu that sent this still describe the event it names?
 *
 * The plans re-check `expectedFrame` themselves, but only when they run — which
 * for a cascading undo is AFTER the chain has already committed. Asked here,
 * before anything moves, a stale click costs the room nothing.
 */
function structuralGuardHolds(events, eventId, expectedFrame) {
  const event = (events || []).find(
    (candidate) => candidate && String(candidate.id) === String(eventId),
  );
  if (!event || event.status !== "active") {
    return false;
  }
  if (!expectedFrame) {
    return true;
  }
  return (
    String(expectedFrame).toLowerCase() ===
    String(event.frame || "").toLowerCase()
  );
}

/**
 * Did the room build something new on this passage while the operator was
 * reading the confirm?
 *
 * `structuralGuardHolds` pins the EVENT — it is still on record, still active,
 * still on the frame the menu named. It says nothing about the cascade, and the
 * cascade is most of what the operator agreed to: "this first undoes 2 later
 * steps — the split at ⟨FORK2⟩, then the merge at ⟨MERGE2⟩ — so everything the
 * room played after them is discarded". A native `confirm()` blocks the map's
 * script while the room keeps playing, so between the click and the OK a line
 * can fork or rejoin and that sentence becomes an understatement: four steps
 * discarded where two were agreed to, including a fork still on the operator's
 * screen.
 *
 * So the click carries the cascade it was shown and the walk re-derives it. A
 * mismatch in either direction is refused (`stale-cascade`) rather than
 * silently doing more or less than was promised — the refusal re-pushes the
 * map, so the next click is against a menu that tells the truth. A client that
 * sends nothing (an older map tab) is trusted exactly as before.
 */
function cascadeSignature(steps) {
  return (steps || [])
    .map((step) =>
      step && typeof step === "object"
        ? `${step.kind}:${step.eventId}`
        : String(step),
    )
    .join(",");
}

/** What one structural undo would take off on the way, right now — the same
 * list, folded the same way, that the map's entry published. */
function structuralCascadeNow(session, kind, eventId) {
  // A split undo takes its whole GESTURE off, so what it discards is the union
  // of the members' chains — the same union `splitRewindOptions` published,
  // deduped the same way. A gesture of one reduces to the single chain it
  // always was.
  const targets =
    kind === "split"
      ? orch
          .splitGestureEvents({ splitEvents: session.splitEvents, eventId })
          .map((member) => member.id)
      : [eventId];
  const seen = new Set();
  const steps = [];
  for (const target of targets) {
    const chain = orch.structuralRewindChain({
      session,
      kind,
      eventId: target,
    });
    if (!chain.available) {
      return [];
    }
    for (const step of orch.cascadeSteps({
      chain: chain.chain,
      mergeEvents: session.mergeEvents,
      // A merge's own convergence is not "on the way" — it IS the undo.
      folded:
        kind === "merge"
          ? orch
              .mergeConvergenceEvents({
                mergeEvents: session.mergeEvents,
                eventId: target,
              })
              .map((member) => member.id)
          : [],
    })) {
      const key = `${step.kind}:${step.eventId}`;
      if (seen.has(key)) continue;
      seen.add(key);
      steps.push(step);
    }
  }
  return steps;
}

/**
 * True when the walk about to run takes off nothing the operator was not shown.
 *
 * Asymmetric on purpose. Discarding MORE than the confirm named is the harm —
 * a fork still on the operator's screen goes with a click that never mentioned
 * it — while discarding FEWER is not: the room took that step off by itself in
 * the meantime, and the undo is simply smaller than advertised.
 *
 * Refusing on any difference (the first cut) made the guard brittle in a way
 * that cost more than it caught: a room rewind's list comes from
 * `roomCheckpointOptions`, which reads the live POPULATION, so one performer
 * closing a tab between the push and the click changed the list and turned a
 * legitimate rewind into a refusal the operator could do nothing about. Set
 * containment is the rule that actually expresses the promise.
 */
function cascadeAgreed(promised, current) {
  if (promised == null) {
    return true; // a client that does not send one — trusted as before
  }
  const shown = new Set(
    (Array.isArray(promised) ? promised : [promised]).map((step) =>
      cascadeSignature([step]),
    ),
  );
  return (current || []).every((step) => shown.has(cascadeSignature([step])));
}

/**
 * The rejoins a per-line rewind would walk back through, folded to one entry
 * per CONVERGENCE — the same list the map's confirm names, so the two can be
 * compared without either side guessing at the other's shape.
 */
function mergesBehindLineFolded(session, line, atIndex) {
  return orch
    .mergesBehindLine({
      mergeEvents: session.mergeEvents,
      lineId: line.id,
      lineUid: line.uid,
      atIndex,
    })
    .filter((event) => {
      const convergence = orch.mergeConvergenceEvents({
        mergeEvents: session.mergeEvents,
        eventId: event.id,
      });
      return convergence.length === 0 || convergence[0] === event;
    })
    .map((event) => String(event.id));
}

/** Was this event already walked back (by a fold, or a nested collapse)? */
function structuralEventDone(events, eventId) {
  const event = (events || []).find(
    (candidate) => candidate && String(candidate.id) === String(eventId),
  );
  return !!event && event.status === "undone";
}

// One whole convergence, undone — with nothing of the room's standing on top of
// it any more (its caller cleared that first).
//
// `{ ok, moved }`: a passage that comes apart only halfway used to answer
// `true` (any progress counted as success), so the operator was told three
// lines had separated when two had. `ok` now means the whole convergence came
// off; `moved` says whether the room changed while failing.
async function mergeRewindConvergence(session, eventId, expectedFrame) {
  if (!session.hasSessionLines) {
    return { ok: false, moved: false };
  }
  const convergence = orch.mergeConvergenceEvents({
    mergeEvents: session.mergeEvents,
    eventId,
  });
  if (convergence.length === 0) {
    return { ok: false, moved: false };
  }
  // Every device the passage's snapshots name, over ALL of its steps — the set
  // the final balancing pass counts rather than spreads. Taken before the walk,
  // because a step marks its event `undone` as it commits.
  const knownDeviceIds = new Set();
  for (const event of convergence) {
    for (const snapshot of event.participants || []) {
      for (const deviceId of (snapshot && snapshot.deviceIds) || []) {
        knownDeviceIds.add(String(deviceId));
      }
    }
  }
  let undone = 0;
  const restored = [];
  for (const event of convergence) {
    // Undoing the newest of a passage can take an older one with it; a step
    // already off is the walk working, not something to redo.
    if (event.status !== "active") {
      continue;
    }
    // The race guard belongs to the frame the whole convergence happened on,
    // which is the one the operator's menu was built against.
    const step = await mergeRewindOne(session, event.id, expectedFrame);
    if (!step) {
      // Whatever came back before this refusal is standing in the room and has
      // not been told so — the gesture drives the displays once, at its end.
      for (const line of restored) holdLineDisplay(session, line);
      return { ok: false, moved: undone > 0 };
    }
    for (const line of step) {
      if (!restored.includes(line)) restored.push(line);
    }
    undone++;
  }
  // Balance the latecomers over the WHOLE passage, not step by step. A
  // convergence merges in pairs, so an earlier step could only see part of the
  // room coming back and spent them against a shorter list of destinations —
  // three over three lines came out 2/1/3 while the confirm promised "evenly".
  // Re-seeded from the snapshot devices and re-assigned from scratch, this is
  // the same computation for a one-event merge.
  if (undone > 0) {
    orch.spreadMergeLatecomers({
      session,
      lines: restored,
      knownDeviceIds,
      connections: wsServer.connections,
    });
    await session.saveSessionStateToFile();
    updateNumberOfConnectionForSession(session);
    pushAdminHistory(session);
    for (const line of restored) holdLineDisplay(session, line);
  }
  return { ok: undone > 0, moved: undone > 0 };
}

/**
 * One operator gesture, one display drive.
 *
 * A structural undo is a WALK: `undoStructuralChain` takes the later events off
 * before the target, and a convergence comes apart in pairs, so one click is
 * several validated steps. Each step used to drive its own displays, and a
 * device therefore received two or three MSG_SHOWs from one click — the states
 * the room was in the middle of discarding first, the real one last. Two things
 * are wrong with that. Devices FLASH through frames that are being thrown away
 * (with their sounds), which reads as the tool losing its place mid-piece. And
 * the order is not actually guaranteed: `ws-client` runs a message whose `t`
 * has already passed inline and defers every other by `setTimeout`, so once the
 * session's buffer duration is small enough for the computed delays to straddle
 * zero — it is an operator setting with a minimum of 0 — a step's show lands
 * AFTER the final one and leaves the device on a frame the server does not
 * think it is on, until its line next moves.
 *
 * So the steps RECORD the lines they touched and the outermost gesture drives
 * the displays once, from the room as it finally stands. Everything else a step
 * sends still goes out as it happens — phase cancels, barrier releases, admin
 * pushes — because those describe the room's state rather than what a device
 * renders, and they are addressed to line ids that only that step still knows.
 *
 * This is the rule `mergeRewindConvergence` already followed inside one
 * convergence ("no device is told about a line the next step is about to move
 * it off"), read across the whole walk.
 */
// Per SESSION, on the session object, like the mutation queue and
// `__structuralProjection` beside it — and never persisted (`toJSON` names its
// fields explicitly). It was a module global, which made the fix above only
// half a fix: the session mutation lane serializes one ROOM, so two rooms
// rewinding at the same moment still collided on this one variable. The second
// room's `openDisplayHold` found it taken and returned null, its
// `holdLineDisplay` saw a session that was not its own and drove each step's
// displays immediately, and its devices flashed through the frames the walk
// was in the middle of discarding — the exact stranding this hold exists to
// prevent, reached by a different route.

/**
 * Open the hold for one gesture, or return null when one is already open (a
 * nested step — whoever opened it drives, and flushes).
 *
 * The devices in SUB view are captured HERE, at the start, because a step's own
 * MSG_SUB_EXIT is suppressed with everything else and MSG_SUB_EXIT is the
 * client's only way back to the main flow. The line a device ends up on may
 * have been in the main flow all along, so the line's own `subStack` cannot
 * answer for it — the device's view when the gesture began can.
 *
 * WHICH sub, not merely "a sub": a device already inside the score its line
 * ends the gesture in needs a plain MSG_SHOW, because its index is sub-relative
 * either way and re-sending MSG_SUB_ENTER would re-inject a sub it is standing
 * in. That distinction is what lets `lineRewind` — whose whole sub-internal
 * rewind is exactly that case — share this drive with the structural undos.
 */
function openDisplayHold(session) {
  if (session.__displayHold) {
    return null;
  }
  const diving = new Map();
  for (const line of session.lines || []) {
    const top =
      line && line.subStack && line.subStack[line.subStack.length - 1];
    if (top) {
      diving.set(line.id, top.score);
    }
  }
  const inSub = new Map();
  for (const conn of wsServer.connections) {
    if (conn.sessionId !== session.id || conn.isMapView) {
      continue;
    }
    if (diving.has(conn.lineId)) {
      inSub.set(conn, diving.get(conn.lineId));
    }
  }
  session.__displayHold = { session, lines: [], inSub };
  return session.__displayHold;
}

/** Record a line whose devices must be told where they are standing, once the
 * gesture is over. With no hold open (a caller outside the structural undos)
 * the drive happens immediately, so there is one display code path either way. */
function holdLineDisplay(session, line) {
  if (!line) {
    return;
  }
  const hold = session.__displayHold;
  if (!hold) {
    driveLineDisplays(session, [line], new Map());
    return;
  }
  if (!hold.lines.includes(line)) {
    hold.lines.push(line);
  }
}

/** Drive the recorded displays and close the hold. Only its opener may. */
function flushDisplayHold(hold) {
  const session = hold && hold.session;
  if (!session || hold !== session.__displayHold) {
    return;
  }
  session.__displayHold = null;
  // A line the walk retired on its way back (a split collapse absorbs its
  // children) has no devices left to address.
  const lines = hold.lines.filter(
    (line) =>
      line &&
      line.status !== "retired" &&
      (session.lines || []).some((entry) => entry === line),
  );
  driveLineDisplays(session, lines, hold.inSub);
}

/**
 * Tell each line's devices which line they are on and what to show.
 *
 * Same shapes as an operator advance, for the same reason: a frame index means
 * nothing without the frame list its devices are holding. Which shape a device
 * gets depends on the view it is IN (`inSub`, captured when the gesture opened)
 * against the view its line ends in — a device already inside the right sub
 * takes the plain show, since only the view MODE needs a message of its own.
 *
 * @param {Map<object,string>} inSub connection → the sub score it is rendering.
 */
function driveLineDisplays(session, lines, inSub) {
  // Line id first, before anything addresses these devices about a frame.
  for (const line of lines) {
    sendToLine(session, line.id, 0, {
      m: MESSAGES.MSG_LINE_ASSIGNED,
      lineId: line.id,
    });
  }
  const showTime = Date.now() + session.preloadDuration;
  for (const line of lines) {
    const top = line.subStack[line.subStack.length - 1];
    for (const conn of wsServer.connections) {
      if (conn.sessionId !== session.id || conn.lineId !== line.id) {
        continue;
      }
      // Map views are never in `inSub` — they do not render sub view — so a
      // dived line reaches them as MSG_SUB_ENTER, which they ignore. That is
      // what keeps a sub-relative index off a page resolving against the main
      // flow, and it is the behaviour they have always had.
      const was = inSub.get(conn) || null;
      if (top && was !== top.score) {
        sendDisplayToClient(session, conn, 0, {
          m: MESSAGES.MSG_SUB_ENTER,
          sub: top.score,
          showIdx: line.currentIndex,
        });
      } else if (!top && was) {
        // Sent even while paused, with the placeholder restored right after, so
        // a stale sub context cannot outlive the undo and break the unpause.
        sendDisplayToClient(session, conn, 0, {
          m: MESSAGES.MSG_SUB_EXIT,
          showIdx: line.currentIndex,
        });
      } else if (!session.isPause) {
        // Already in the right view — main flow, or the very sub its line ends
        // in. Only the frame changes.
        sendDisplayToClient(session, conn, showTime, {
          m: MESSAGES.MSG_SHOW,
          showIdx: line.currentIndex,
        });
      } else {
        continue; // a paused device in the right view keeps its placeholder
      }
      if (session.isPause) {
        sendDisplayToClient(session, conn, 0, {
          m: MESSAGES.MSG_PAUSE,
          isPause: true,
          showIdx: line.currentIndex,
        });
      }
    }
  }
}

// One recorded merge event, undone.
//
// Returns the lines it brought back, or null when it refused. The DISPLAYS are
// not driven here: a convergence is several of these, its balancing runs after
// the last one, and the whole gesture may be a WALK over several events — so
// the devices are addressed once, at the end (`flushDisplayHold`).
async function mergeRewindOne(session, eventId, expectedFrame) {
  const plan = orch.mergeRewindPlan({
    mergeEvents: session.mergeEvents,
    splitEvents: session.splitEvents,
    lines: session.lines,
    eventId,
    expectedFrame,
  });
  if (!plan.available) {
    return null;
  }

  // Synchronous phase cleanup while every device still carries the merged
  // line's id — no await, so the guard above cannot race a landing between
  // validation and commit (splitRewind's rule, same reason).
  const survivor = plan.survivor;
  cancelAttritionTimer(survivor);
  if (survivor.isHolding || survivor.holdingTimer != null) {
    sendToLine(session, survivor.id, 0, {
      m: MESSAGES.MSG_BEGIN_HOLDING,
      endTime: 0,
      duration: 1,
    });
  }
  if (survivor.isVoting || survivor.votingTimer != null) {
    sendToLine(session, survivor.id, 0, {
      m: MESSAGES.MSG_BEGIN_VOTING,
      endTime: 0,
      duration: 0,
    });
  }
  if (survivor.isBarrierWaiting || survivor.isGroupWaiting) {
    sendToLine(session, survivor.id, 0, {
      m: MESSAGES.MSG_BARRIER_RELEASED,
      frame: frameNameForLine(session, survivor),
    });
  }
  survivor.clearAllTimer();
  survivor.isGroupWaiting = false;
  orch.unparkLine(session, survivor);

  const result = orch.rewindMergeStructure({
    session,
    eventId,
    expectedFrame,
    connections: wsServer.connections,
  });
  if (!result.available) {
    return null;
  }

  const restored = result.restores.map((entry) => entry.line);
  for (const line of restored) {
    // A line that comes back with no devices is dormant, and #11's attrition
    // timer for it belongs to the merged line that no longer exists.
    cancelAttritionTimer(line);
    line._lastReachedRef = null;
    recordArrival(session, line);
    // …and it is off limits to this gesture's own one-line-per-node settlement
    // (see settleCoLocatedLines). The set lives for the length of one rewind
    // message, so a LATER landing merges them again exactly as the score asks.
    if (session.__justSeparated) session.__justSeparated.add(line.id);
  }

  await tryReleaseBarriers(session);
  await tryReleaseGroupWaits(session);
  await session.saveSessionStateToFile();

  notifyAdminsBarriers(session);
  pushAdminHistory(session);
  updateNumberOfConnectionForSession(session);

  return restored;
}

async function jumpScoreForSession(session, line, value) {
  if (line.isHolding && line.holdingTimer != null) {
    await cancelHoldingTimer(session, line, 1);
  }
  if (line.standbyTimer) {
    clearTimeout(line.standbyTimer);
    line.standbyTimer = null;
    await session.saveSessionStateToFile();
  }
  if (line.isVoting && line.votingTimer != null) {
    await cancelVotingTimer(session, line);
  }
  //---------
  const filename = line.history[value];
  if (filename == null) {
    return;
  }
  const index = session.listFilesInLowerCase.indexOf(filename.toLowerCase());
  if (index < 0) {
    return;
  }
  // Captured BEFORE the playhead moves: the barrier/group frame a parked line
  // is being rewound away from (its devices' "waiting" banner must be dismissed).
  const parkedAtFrame =
    session.hasSessionLines && (line.isBarrierWaiting || line.isGroupWaiting)
      ? frameNameForLine(session, line)
      : null;

  line.historyIndex = value;
  line.setCurrIdxTo(index);

  // Session Lines (open-item decisions): an SM jump is a REWIND.
  if (session.hasSessionLines) {
    // R4: a jumped line must not stay parked at the barrier it left — un-park
    // it and drop it from every barrier entry (deleting emptied entries). The
    // same rule applies to a group-arrival park.
    const wasGroupParked = line.isGroupWaiting === true;
    line.isGroupWaiting = false;
    if (orch.unparkLine(session, line) || wasGroupParked) {
      // The client only hides its barrier banner on MSG_BARRIER_RELEASED —
      // without this the jumped line's devices keep "waiting…" forever.
      sendToLine(session, line.id, 0, {
        m: MESSAGES.MSG_BARRIER_RELEASED,
        frame: parkedAtFrame,
      });
      notifyAdminsBarriers(session);
    }
    // Registry generation (S2 option (b)): everything reached so far belongs
    // to the pre-rewind story, so barriers met after the rewind gate like
    // first passes — except the barrier AT the landing frame itself, which the
    // room already passed: its targets are pre-satisfied so it stays unlocked.
    const landedFrame = session.listFiles[index];
    orch.beginReachedGeneration(
      session,
      (session.graph.holdUntilTargets || {})[landedFrame],
    );
    // Seed the fresh registry with the landing itself; the pre-rewind frame
    // this line sat on must NOT leak into the new generation as "done".
    line._lastReachedRef = null;
    recordArrival(session, line);
    // The rewind landing is the room's newest position of record — a grouped
    // landing re-arms the revival fast-forward target beginReachedGeneration
    // just cleared (decision #13 revision).
    if (orch.groupOfFrame(session.graph, landedFrame)) {
      session.latestGroupArrival = { frame: landedFrame, at: Date.now() };
    }
    // Pre-satisfied landing targets may release barriers parked elsewhere.
    await tryReleaseBarriers(session);
    // The jumped line's position changed — group waits it was incoming to may
    // dissolve. (Deliberately NOT parking at the LANDING frame's group: an SM
    // jump is authoritative, mirroring the landing-barrier carve-out above.)
    await tryReleaseGroupWaits(session);
  }

  await session.saveSessionStateToFile();

  emitHistoryToAdmins(session, line);
  // A rewind bypasses afterLineArrived, so the admin map's per-line positions
  // must be re-pushed here or its "here" marker stays on the pre-jump frame.
  updateNumberOfConnectionForSession(session);

  if (!session.isPause) {
    sendToLine(session, line.id, Date.now() + session.preloadDuration, {
      m: MESSAGES.MSG_SHOW,
      showIdx: index,
    });
  }
}

// Tell the operator their rewind did not happen, and why.
//
// Every rewind entry point can refuse — a menu built a moment before the room
// moved, a topology no snapshot describes any more — and until now each of them
// returned a boolean that nobody read: the operator answered a confirm()
// promising a topology change and got silence, with no way to tell a refusal
// from a bug. The map is also re-pushed, because a refusal usually means what
// it is drawing is stale, and the reason alone would leave a menu still
// offering the thing that just failed.
// Why a structural undo is still not done, re-derived after the attempt. The
// chain speaks first — a walk that could not start says so, and its reason
// ("blocked-by-expired") is the one the plan alone would never mention — and
// the race guard is re-applied, since a stale menu is the commonest refusal of
// all and would otherwise report as a bare "unavailable".
function splitRefusalReason(session, eventId, frame) {
  const chain = orch.structuralRewindChain({
    session,
    kind: "split",
    eventId,
  });
  if (!chain.available) {
    return chain.reason;
  }
  return (
    orch.splitRewindPlan({
      splitEvents: session.splitEvents,
      lines: session.lines,
      eventId,
      expectedFrame: frame,
    }).reason || "unavailable"
  );
}

function mergeRefusalReason(session, eventId, frame) {
  const chain = orch.structuralRewindChain({
    session,
    kind: "merge",
    eventId,
  });
  if (!chain.available) {
    return chain.reason;
  }
  return (
    orch.mergeRewindPlan({
      mergeEvents: session.mergeEvents,
      splitEvents: session.splitEvents,
      lines: session.lines,
      eventId,
      expectedFrame: frame,
    }).reason || "unavailable"
  );
}

// `moved` is the difference between "your click did nothing" and "your click
// did SOME of what it promised": a cascading undo commits step by step, and a
// walk that stops half-way cannot be rolled back (each step is a validated
// snapshot restore of its own). Reporting both as "Nothing moved" left the
// operator trusting a map that had already changed under them.
function reportRewindRefusal(
  conn,
  session,
  kind,
  reason,
  frame,
  moved,
  operationId,
) {
  sendToClient(conn, 0, {
    m: MESSAGES.MSG_REWIND_REFUSED,
    kind,
    reason: reason || "unavailable",
    frame: frame || null,
    moved: !!moved,
    operationId: operationId || null,
  });
  updateNumberOfConnectionForSession(session);
}

// The other half of the same conversation. Every rewind could already say why
// it did NOT happen; a successful one — three lines re-created, every device
// moved onto a different line, everything the room played since discarded —
// said nothing at all, leaving the operator to infer from a redrawn canvas that
// the confirm they had answered was acted on. Kind + frame describe the event;
// operationId uniquely identifies whose confirm it answers. No lines push rides
// with it — the rewind itself has already sent several.
async function reportRewindDone(
  session,
  kind,
  frame,
  emptied,
  operationId,
  lineId,
) {
  // Commit the receipt to the same atomic session snapshot as the rest of the
  // room. The broadcast carries that exact entry so live tabs and a freshly
  // reloaded tab render one shared audit trail.
  const rewindEntry = session.recordRewind({ kind, frame, lineId, emptied });
  await session.saveSessionStateToFile();
  // To EVERY operator tab, not only the one that clicked. A structural undo
  // re-creates lines and moves devices between them, and a second map open on
  // the same room simply watched its canvas rearrange with no account of why —
  // the one thing the receipt exists to prevent, for whichever operator was
  // not holding the mouse. The clicking tab still shows the sentence its own
  // confirm promised; the others compose a plainer one from `kind` + `frame`,
  // which is why both still ride along.
  sendToAllAdmins(session, 0, {
    m: MESSAGES.MSG_REWIND_DONE,
    kind,
    frame: frame || null,
    operationId: operationId || null,
    rewindEntry,
    // The lines it left with NOBODY on them, each with the frame it is
    // standing on. A merge undo can hand a route back to a performer who has
    // since gone home: the line comes back DORMANT, and the operator — who
    // answered a confirm promising "N lines go back, and every device goes
    // back to the line it was on" — was left to notice `L2·0p` on the canvas
    // for themselves, or not to.
    //
    // The FRAME is here because the numbers on the two ends of this gesture are
    // not read on the same basis. The confirm names the numbers the REJOIN
    // recorded ("merged here as L0, L1, L2"), while this names the numbers the
    // lines actually came back ON — and `freeLineId` hands a route the lowest
    // free number when an unrelated fork is holding its own, so the operator
    // could read "L0, L1, L2 come back" and then "L4 has nobody on it". The
    // frame is the landmark that keeps its word either way, which is the rule
    // the rest of §8.4 already follows.
    //
    // Reported AFTER the fact rather than predicted in the confirm, because
    // predicting it means simulating `spreadMergeLatecomers` through every
    // step of a cascade, and a confirm that guesses wrong about who is about to
    // be left alone is worse than one that says nothing. Here it is simply
    // true.
    ...(emptied && emptied.length > 0 ? { emptied } : {}),
  });
}

/** Every dormant line's identity, before a rewind runs. Keyed on the uid, so a
 * line the rewind RE-CREATES on a recycled number does not read as one that
 * was already dormant (§8.4 — identity is the uid, in both directions). */
function dormantLineKeys(session) {
  const keys = new Set();
  for (const line of (session && session.lines) || []) {
    if (line && line.status === "dormant") {
      keys.add(String(line.uid || line.id));
    }
  }
  return keys;
}

/** …and the ones dormant NOW that were not dormant then — the lines this
 * gesture left with nobody on them, by the number they carry today AND the
 * frame they are standing on (the number alone can have been re-allocated —
 * see `reportRewindDone`). */
function linesLeftEmpty(session, before) {
  if (!before) {
    return [];
  }
  return ((session && session.lines) || [])
    .filter(
      (line) =>
        line &&
        line.status === "dormant" &&
        !before.has(String(line.uid || line.id)),
    )
    .sort((a, b) => lineIdNum(a.id) - lineIdNum(b.id))
    .map((line) => {
      const sub = line.subStack && line.subStack[line.subStack.length - 1];
      return {
        id: line.id,
        frame: frameNameForLine(session, line) || null,
        sub: sub ? sub.score : null,
      };
    });
}

// Targeted per-line rewind (owner): move ONE named line to an earlier entry of
// its own ACTIVE trail — main flow, or within its current sub dive (a sub is
// its own session: `history` holds the sub trail while diving, so the same
// undo semantics apply, resolved against the sub's frame list). Undo, not
// teleport: the target must be in the trail.
//
// Returns a refusal reason, or null when the request was satisfied (which
// includes "the merge undo alone already landed it there" — nothing further to
// move is success, not a refusal).
//
// Deliberately UNLIKE the room-wide checkpoint rewind / the old SM jump:
//   - the rendezvous registry is NOT restarted (no beginReachedGeneration) —
//     the ROOM did not rewind, one line did, so everything the room reached
//     stays valid and the replaying line passes already-satisfied barriers;
//   - `session.latestGroupArrival` is NOT touched — the room's newest position
//     of record is still wherever the lines ahead are, and revived dormant
//     lines must keep fast-forwarding there, not to the rewound line;
//   - group waits: the "passed ⇒ arrived" excusal in groupWaitState is the
//     matching rule — the rewound line replays through groups the room passed
//     without wedging (its own truncated trail makes it re-arrive for real).
//
// `progress` is an out-param the caller reads on refusal: this rewind can undo
// merges on the way (below), and those commit before anything else is checked,
// so a refusal AFTER one of them is not "nothing moved".
async function lineRewind(
  session,
  lineId,
  value,
  expectedFrame,
  absorbedEventId,
  progress = {},
) {
  // One gesture, one display drive. This rewind can be a WALK too — it takes
  // every merge standing behind its target off first (below), each of which is
  // a full `mergeRewind` that lands several lines — and then moves its own line
  // further still. Driven per step, the rewound line's devices were shown their
  // merge landing and then the real target, which is the flash and the ordering
  // hazard `flushDisplayHold` exists to remove. The `finally` covers the
  // refusal paths: a walk that stopped after a merge came off has moved the
  // room, and the devices standing in it must be told where.
  const hold = openDisplayHold(session);
  try {
    return await lineRewindWalk(
      session,
      lineId,
      value,
      expectedFrame,
      absorbedEventId,
      progress,
    );
  } finally {
    flushDisplayHold(hold);
  }
}

async function lineRewindWalk(
  session,
  lineId,
  value,
  expectedFrame,
  absorbedEventId,
  progress,
) {
  let line = (session.lines || []).find(
    (l) => l && l.id === lineId && l.status !== "retired",
  );
  // A merge-ABSORBED line (owner). The map offers rewind entries on its route too
  // (`absorbedLines`), since the line itself is gone — so the operator can reach for the line
  // they watched walk there instead of the survivor that swallowed it. It has
  // to come BACK before it can be rewound, so the merge undo runs first, and
  // whole (mergeRewind folds the convergence, and takes off anything the room
  // has built on top since): every line that met at the rejoin frame lands on
  // the node it came from, and only then does this one carry on to the clicked
  // frame. That is §8.2's rule read from the other side, and it lands the same
  // room state as rewinding the survivor past the same merge.
  if (!line) {
    if (!session.hasSessionLines) {
      return "unknown-line";
    }
    // The line's object was dissolved by the rejoin (its number went back in
    // the pool), so its own merge record is what the map drew and what this
    // reads back.
    const absorbed = absorbedSnapshotFor(session, lineId, absorbedEventId);
    if (!absorbed) {
      return "unknown-line";
    }
    // The race guard FIRST: a stale menu must not buy a topology change. The
    // absorbed trail the map was drawn from is the snapshot's, whose entries
    // before the landing are the ones this can name — and the undo restores
    // exactly that prefix, so the index means the same thing either side of it.
    const want = absorbed.trail[value];
    if (
      want == null ||
      (expectedFrame &&
        String(want).toLowerCase() !== String(expectedFrame).toLowerCase())
    ) {
      return "stale-frame";
    }
    const undone = await mergeRewind(
      session,
      absorbed.event.id,
      absorbed.event.frame,
    );
    if (undone.moved) progress.moved = true;
    if (!undone.ok) {
      return "merge-undo-refused"; // nothing can bring it back
    }
    // Re-created, so it is found by ROUTE: the undo asks for the number the
    // line had, but an unrelated fork may be holding it and the route then
    // comes back on another one.
    const uid = absorbed.snapshot.lineUid;
    line = (session.lines || []).find(
      (l) => l && (uid ? l.uid === uid : l.id === lineId),
    );
    if (!line || line.status === "retired") {
      return "restore-failed"; // the undo did not bring it back after all
    }
    // Landing on the node the undo already put it on IS the whole request —
    // "bring L1 back where it was", the last entry of its ghost trail. The
    // undo has pushed every display and admin update; nothing further moves.
    if (value === line.historyIndex) {
      return null; // the undo alone was the whole request
    }
  }
  const filename = line.history[value];
  if (filename == null) {
    return "stale-trail";
  }
  // Race guard: the SM menu was built from a trail snapshot — if the line
  // moved (or exited its sub, swapping `history` back to the main trail)
  // since, the index no longer names the clicked frame; refuse rather than
  // land somewhere unintended.
  if (
    expectedFrame &&
    filename.toLowerCase() !== String(expectedFrame).toLowerCase()
  ) {
    return "stale-frame";
  }

  // Reaching behind a merge undoes it on the way (owner). The survivor keeps
  // its pre-merge trail, so the map legitimately offers entries from before
  // the rejoin — but walking the merged line back there whole would stand
  // devices that arrived by another route on a frame that route never touched.
  // Undo newest-first (mergeRewind refuses any other order), then re-resolve:
  // each undo lands the lines on the node they came from and TRUNCATES this
  // trail, so the clicked index no longer means what it did. Only main-flow
  // rewinds qualify — inside a dive the active trail is the sub's, while a
  // merge point indexes the main one.
  if (session.hasSessionLines && line.subStack.length === 0) {
    const behind = orch.mergesBehindLine({
      mergeEvents: session.mergeEvents,
      lineId: line.id,
      lineUid: line.uid,
      atIndex: value,
    });
    let undone = 0;
    for (const event of behind) {
      // A convergence undoes whole (mergeRewind), so an event further down this
      // list may already be gone by the time we reach it — that is the undo
      // working, not a refusal.
      if (event.status !== "active") {
        continue;
      }
      const step = await mergeRewind(session, event.id, event.frame);
      if (step.moved) progress.moved = true;
      if (!step.ok) {
        // REFUSE rather than carry on. A merge that would not come off is
        // still standing, so walking this line back behind it is exactly what
        // §8.2 exists to prevent — devices that arrived by another route left
        // on a frame that route never touched. Until now the loop simply broke
        // and the rewind below ran anyway, quietly producing the impossible
        // room the whole rule is about. `progress.moved` carries whatever the
        // earlier steps already committed, so the refusal tells the truth
        // about a part-way walk.
        return "merge-undo-refused";
      }
      undone++;
    }
    if (undone > 0) {
      // The clicked frame may be gone with the truncated tail — then the undos
      // have already landed the line at or behind the target and there is
      // nothing left to rewind.
      const trail = line.history || [];
      let at = -1;
      for (let i = Math.min(value, trail.length - 1); i >= 0; i--) {
        if (String(trail[i]).toLowerCase() === filename.toLowerCase()) {
          at = i;
          break;
        }
      }
      if (at < 0 || (at === line.historyIndex && line.subStack.length === 0)) {
        return null; // the undos already landed it at or behind the target
      }
      value = at;
    }
  }

  // Resolve within the line's ACTIVE frame list (sub-aware — the counterpart
  // of BMLine.activeFrameList, which setCurrIdxTo pushes from).
  const top = line.subStack[line.subStack.length - 1];
  const sub = top && session.subFrames && session.subFrames[top.score];
  if (top && !sub) {
    return "sub-unavailable"; // score reloaded without this sub
  }
  const frameList = sub ? sub.frameList : session.listFiles;
  const index = frameList.findIndex(
    (f) => f.toLowerCase() === filename.toLowerCase(),
  );
  if (index < 0) {
    return "frame-missing";
  }

  if (line.isHolding && line.holdingTimer != null) {
    await cancelHoldingTimer(session, line, 1);
  }
  if (line.standbyTimer) {
    clearTimeout(line.standbyTimer);
    line.standbyTimer = null;
  }
  if (line.isVoting && line.votingTimer != null) {
    await cancelVotingTimer(session, line);
  }

  // Captured BEFORE the playhead moves (in-sub lines are never parked, so
  // this only fires for main-flow rewinds).
  const parkedAtFrame =
    line.isBarrierWaiting || line.isGroupWaiting
      ? frameNameForLine(session, line)
      : null;

  line.historyIndex = value;
  line.setCurrIdxTo(index);

  // R4, same as the room rewind: a rewound line must not stay parked at the
  // barrier/group it left — and its devices' "waiting" banner only clears on
  // MSG_BARRIER_RELEASED.
  const wasGroupParked = line.isGroupWaiting === true;
  line.isGroupWaiting = false;
  if (orch.unparkLine(session, line) || wasGroupParked) {
    sendToLine(session, line.id, 0, {
      m: MESSAGES.MSG_BARRIER_RELEASED,
      frame: parkedAtFrame,
    });
    notifyAdminsBarriers(session);
  }

  // Seed the CURRENT generation with the landing (registry kept — see above).
  // The pre-rewind frame must not be upgraded to "done" as if the line had
  // departed it normally: mid-hold refs stay "arrived".
  line._lastReachedRef = null;
  recordArrival(session, line);
  await tryReleaseBarriers(session);
  // The rewound line may have stepped off a group frame / become incoming
  // again; waits it participated in must re-evaluate. (Deliberately NOT
  // parking at the LANDING frame's group: an SM rewind is authoritative,
  // mirroring jumpScoreForSession and roomRewind.)
  await tryReleaseGroupWaits(session);

  await session.saveSessionStateToFile();
  emitHistoryToAdmins(session, line);
  updateNumberOfConnectionForSession(session);

  // Last landing of the gesture, so this is the one its devices are shown —
  // the merge landings the walk passed through are dropped with it. A line
  // rewound INSIDE its dive is the case that kept this drive out of the hold
  // until now: `driveLineDisplays` reads the view each device is actually in,
  // so one already inside this sub takes the plain show it always did.
  holdLineDisplay(session, line);
  return null;
}

// Operator "roll this line back out of its dive" — the REWIND counterpart of
// ejectLineFromSub, and the sub-crossing rewind §8.2 had ruled out of scope.
// The destination is ANY frame the line has already visited on the main flow:
// `mainHistoryStateForLine` is its main trail exactly as the dive left it, and
// `selectedIdx` picks an entry of that trail. Omitted, it defaults to the
// trail's own current entry — the frame the line dived FROM — so "undo this
// dive" is simply this command's default case rather than a second command.
//
// The two sub valves are opposites and land by opposite rules:
//
//   EJECT    forward — "finish this dive now". Lands on the dive's return frame
//            through afterLineArrived, so it JOINS whatever the score put there
//            (a hold-until, a rejoin, a track group). Ordinary travel.
//   ROLLBACK backward — "the dive never happened". Lands on the fork the line
//            dived from and deliberately does NOT park there: an operator rewind
//            is authoritative, exactly as lineRewind, jumpScoreForSession and
//            roomRewind are. The line sits un-dived (dives are navigation-
//            triggered, so a reposition never re-dives on its own) and its next
//            window may take the sub again, or take another link entirely.
//
// It keeps lineRewind's registry rules, not the eject's: the rendezvous registry
// is NOT restarted and `latestGroupArrival` is untouched, because the ROOM did
// not rewind. The sub frames the line reached stay reached — it really did stand
// on them — and `_lastReachedRef` is cleared first so the frame it leaves is not
// upgraded to "done" as though it had departed normally.
//
// `sub` is the race guard, as it is for the eject: refuse rather than act on a
// line that has already popped out on its own since the menu was built.
async function rewindLineOutOfSub(
  session,
  lineId,
  sub,
  selectedIdx,
  expectedFrame,
) {
  const line = (session.lines || []).find(
    (l) => l && l.id === lineId && l.status !== "retired",
  );
  if (!line) {
    return "unknown-line";
  }
  if (line.subStack.length === 0) {
    return "not-in-sub"; // it surfaced on its own while the menu sat open
  }
  const top = line.subStack[line.subStack.length - 1];
  if (sub && String(top.score).toLowerCase() !== String(sub).toLowerCase()) {
    return "stale-sub";
  }

  // Everything is resolved off the SAVED trail before a single field is
  // mutated, so a refused race guard leaves the line exactly where it stood —
  // the whole point of validating a rewind rather than trusting the menu.
  const main = mainHistoryStateForLine(line);
  const trailIdx =
    selectedIdx == null ? main.historyIndex : Number(selectedIdx);
  const target = main.history[trailIdx];
  if (target == null) {
    return "stale-trail";
  }
  // Same race guard as lineRewind: the menu was built from a trail snapshot, so
  // the entry at this index must still name the frame that was clicked.
  if (
    expectedFrame &&
    String(target).toLowerCase() !== String(expectedFrame).toLowerCase()
  ) {
    // The operator is told (the caller reports this reason), and the log keeps
    // the detail: either the line moved since the menu was built — the case
    // this guards — or a caller sent something other than the trail entry
    // verbatim.
    console.warn(
      `rewindLineOutOfSub refused: ${lineId} trail[${trailIdx}] is ` +
        `"${target}", not "${expectedFrame}"`,
    );
    return "stale-frame";
  }
  const index = session.listFilesInLowerCase.indexOf(
    String(target).toLowerCase(),
  );
  if (index < 0) {
    return "frame-missing";
  }

  // The full phase clear, not lineRewind's bare timer cancels: a line left
  // "holding" with no timer to end it never marks its landing frame done.
  const wasParked = !!(line.isBarrierWaiting || line.isGroupWaiting);
  const parkedAtFrame = wasParked ? frameNameForLine(session, line) : null;
  await clearLinePhase(session, line);

  while (line.subStack.length > 0) {
    line.exitSub(); // restores the main-flow history saved at each dive
  }
  // Landing exactly as lineRewind lands: the index names the trail entry, and
  // setCurrIdxTo drops the redo entries after it. Rolling back to the trail's
  // OWN current entry (the default — the fork the line dived from) splices
  // nothing and its trailing-duplicate guard skips the push, so undoing a dive
  // leaves the trail precisely as the dive found it.
  line.historyIndex = trailIdx;
  line.setCurrIdxTo(index);

  line.isGroupWaiting = false;
  if (orch.unparkLine(session, line) || wasParked) {
    sendToLine(session, line.id, 0, {
      m: MESSAGES.MSG_BARRIER_RELEASED,
      frame: parkedAtFrame,
    });
  }

  line._lastReachedRef = null;
  recordArrival(session, line);
  await tryReleaseBarriers(session);
  // The line stepped off the sub and back onto the main flow: waits it was
  // incoming to must re-evaluate. NOT parked at the landing (see above).
  await tryReleaseGroupWaits(session);
  await session.saveSessionStateToFile();

  // MSG_SUB_EXIT is the client's only way out of sub view, and carries the
  // landing index against the main list it restores. Sent even while paused,
  // with the pause placeholder put back right after.
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_SUB_EXIT,
    showIdx: line.currentIndex,
  });
  if (session.isPause) {
    sendToLine(session, line.id, 0, {
      m: MESSAGES.MSG_PAUSE,
      isPause: true,
      showIdx: line.currentIndex,
    });
  }
  emitHistoryToAdmins(session, line);
  notifyAdminsBarriers(session);
  updateNumberOfConnectionForSession(session);
  return null;
}

async function cancelHoldingTimer(session, line, onOff) {
  clearTimeout(line.holdingTimer);
  line.holdingTimer = null;
  await session.saveSessionStateToFile();
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_BEGIN_HOLDING,
    endTime: 0,
    duration: onOff,
  });
}

async function cancelVotingTimer(session, line) {
  clearInterval(line.votingTimer);
  line.votingTimer = null;
  await session.saveSessionStateToFile();
  sendToLine(session, line.id, 0, {
    m: MESSAGES.MSG_BEGIN_VOTING,
    endTime: 0,
    duration: 0,
  });
}

// Every call in one turn of the event loop becomes ONE push, taken after the
// turn's mutations have run: a single gesture calls this several times (a
// rewind lands lines, re-homes riders and settles the room, each announcing
// itself), and every push rebuilds and re-serializes the whole snapshot for
// every admin tab. The push reads the room when it goes out, so the one that
// is sent is the one the others would have ended on.
function updateNumberOfConnectionForSession(session) {
  if (session.__snapshotPending) return;
  session.__snapshotPending = true;
  setImmediate(() => {
    session.__snapshotPending = false;
    pushConnectionSnapshot(session);
  });
}

// The room-specific answers the snapshot builder needs
// (lib/session-lines/admin-snapshot.js); it imports nothing from here.
const snapshotRoom = {
  messageType: MESSAGES.MSG_SHOW_NUMBER_CONNECTION,
  structuralProjection: (session) => structuralProjection(session),
  roomCheckpointOptions: (session) => roomCheckpointOptions(session),
  structuralEventSummaries,
  mergeLatecomerCount: (session, entry) => mergeLatecomerCount(session, entry),
  mainHistoryStateForLine: (line) => mainHistoryStateForLine(line),
  frameNameForLine: (session, line) => frameNameForLine(session, line),
  mainFlowFrameForLine: (session, line) => mainFlowFrameForLine(session, line),
  subOriginFrameForLine: (session, line) => subOriginFrameForLine(session, line),
  walkedRefs: (session) => orch.roomWalkedRefs(session),
  lineIdNum,
};

function pushConnectionSnapshot(session) {
  for (const { connections, payload } of buildAdminSnapshots(
    session,
    wsServer.connections,
    snapshotRoom,
  )) {
    sendToConnections(connections, 0, payload);
  }
}

// Full cascades, restored identities, landings and ghost trails are sizeable
// and change only with structural topology. A map asks for them once after a
// compact update announces a new version; ordinary movement/count pushes never
// serialize or transmit them.
function sendStructuralDetailsToMap(session, conn) {
  const structural = structuralProjection(session);
  const mergeRewinds = structural.mergeRewinds.map((entry) => {
    if (!entry.available) return entry;
    const counted = mergeLatecomerCount(session, entry);
    return {
      ...entry,
      latecomers: counted.total,
      latecomersHere: counted.live,
    };
  });
  sendToClient(conn, 0, {
    m: MESSAGES.MSG_SHOW_NUMBER_CONNECTION,
    structuralDetails: true,
    structuralVersion: structural.version,
    splitRewinds: structural.splitRewinds,
    mergeRewinds,
    absorbedLines: structural.absorbedLines,
  });
}

/**
 * The three structural map projections, memoized on the topology they describe.
 *
 * Each of them is quadratic in the number of structural events —
 * `mergeRewindOptions` runs a full plan, chain walk and convergence grouping
 * per event, `splitRewindOptions` the same, `absorbedLineSnapshots` another
 * plan per event — and `updateNumberOfConnectionForSession` fires on every
 * arrival, join, leave and rewind. Since nothing expires any more (a merge
 * point stays reachable for the whole session) the event list only grows, so a
 * long piece was paying that on every push: measured on the real orchestrator,
 * 100 fork/merge passages cost ~37 ms and 1.4 MB per push.
 *
 * The answer depends on exactly two things — the structural events and the
 * lines' identities/status — so the cache key is built from those, in O(events
 * + lines), rather than from a bump the twenty-odd mutation sites would each
 * have to remember. A key that reads the same means an identical answer. Live
 * pushes send only summaries of these cached arrays; the arrays themselves are
 * sent to a map once per key. Positions, counts and `latecomers` stay outside
 * the cache because they change without a structural mutation.
 */
function structuralProjection(session) {
  // The score itself is part of the key: `absorbedLineSnapshots` resolves its
  // ghost trails against `listFiles`, and a session outlives a folder swap
  // (MSG_CHANGE_FOLDER rebuilds the score in place), so a cache keyed on the
  // topology alone would hand the new score the old score's frames.
  const key = structuralProjectionKey(session);
  const cached = session.__structuralProjection;
  if (cached && cached.key === key) {
    return cached.value;
  }
  // Built BEFORE the absorbed-line routes and handed to them: a route is offered for exactly
  // the passages these entries offer an undo for, which is one question with
  // one answer (see `absorbedLineSnapshots`).
  const mergeRewinds = orch
    .mergeRewindOptions({
      mergeEvents: session.mergeEvents,
      splitEvents: session.splitEvents,
      lines: session.lines,
    })
    .map((entry) =>
      !entry.available
        ? entry
        : {
            ...entry,
            // Where every line of the passage comes back to. On EVERY
            // available entry, folded halves included: an absorbed line's
            // button names the event its own snapshot came from, which for a
            // convergence that merged in pairs is often the older one.
            landings: mergeRestoreLandings(session, entry),
          },
    );
  const value = {
    version: structuralProjectionVersion(key),
    splitRewinds: orch.splitRewindOptions({
      splitEvents: session.splitEvents,
      // A split undo cascades through the merges standing on its subtree
      // exactly as a merge undo does (splitRewind → undoStructuralChain), so
      // the projection has to read the same events the walk will.
      mergeEvents: session.mergeEvents,
      lines: session.lines,
    }),
    mergeRewinds,
    absorbedLines: absorbedLineSnapshots(session, mergeRewinds),
  };
  session.__structuralProjection = { key, value };
  return value;
}

/**
 * The track groups the room can be rewound to, and what each rewind would take
 * off on the way.
 *
 * Both halves are answered HERE because both need inputs the map does not have.
 * Legality needs the split records — a line whose own trail a fork truncated
 * still crossed the group, inside its parent — and it needs the room's real
 * population, which counts performers and admins but never riders (decision
 * #12). The map used to re-derive this from `lines[]` alone and could only get
 * both wrong: a rider-only line hid a checkpoint the server would have
 * accepted, and a fork made older checkpoints vanish from the menu exactly when
 * an operator reaches for one.
 *
 * `undoes` is the rejoin list the click will actually walk off, taken from the
 * same `roomRewindPlan` + `mergesBehindRoomRewind` pair `roomRewind` runs — so
 * the confirm promises what the gesture does rather than a second guess at it.
 *
 * Outside `structuralProjection` because it turns on who is CONNECTED, which
 * changes with every join and leave; the groups are few and the trails are
 * already in hand.
 */
function roomCheckpointOptions(session) {
  const groups = (session.graph || {}).groups || {};
  const lines = nonRetiredLines(session);
  const checkpointLines = populatedRewindCheckpointLines(session, lines);
  const snapshots = lines.map(rewindLineSnapshot);
  return orch
    .commonCheckpoints({
      lines: checkpointLines,
      groups,
      splitEvents: session.splitEvents,
    })
    .map((checkpoint) => {
      const plan = orch.roomRewindPlan({
        group: checkpoint.group,
        groups,
        checkpointLines,
        lines: snapshots,
        splitEvents: session.splitEvents,
      });
      return {
        ...checkpoint,
        undoes: plan
          ? orch
              .mergesBehindRoomRewind({
                mergeEvents: session.mergeEvents,
                lines,
                plan,
              })
              .map((event) => event.id)
          : [],
        // …and the FORKS it takes off. Not derived from `plan` — a fork is
        // measured against the checkpoint in the PARENT's recorded trail,
        // which is the only place it survives its children's truncation
        // (`splitsBehindRoomRewind`).
        undoesSplits: orch
          .splitsBehindRoomRewind({
            splitEvents: session.splitEvents,
            groupFrames: orch.groupFramesLower(session.graph, checkpoint.group),
          })
          .map((event) => ({ eventId: event.id, frame: event.frame })),
      };
    });
}

/** The rejoins a room rewind to `group` would undo on the way, as the map was
 * told them (`roomCheckpointOptions`). Empty for a group that is no longer a
 * common checkpoint — that refusal belongs to `roomRewind` itself. */
function roomRewindUndoes(session, group) {
  const entry = roomCheckpointOptions(session).find(
    (candidate) => candidate && candidate.group === group,
  );
  if (!entry) {
    return [];
  }
  // Both kinds, tagged — a fork added while the confirm was open is as much a
  // thing the operator was not shown as a rejoin is.
  return [
    ...(entry.undoes || []).map((id) => `merge:${id}`),
    ...(entry.undoesSplits || []).map((step) => `split:${step.eventId}`),
  ];
}

/**
 * Where each line of one convergence comes back to — the landing
 * `rewindMergeStructure` will give it, worked out in advance so the confirm can
 * NAME the destinations before the operator commits to a topology change.
 *
 * It matters most exactly where the map can say least: behind a still-undoable
 * rejoin the canvas marks no landing, and reaching an OLDER merge draws
 * nothing at all either (its absorbed numbers are back in the pool), so
 * "⏪⏪ undo merge here — also undoes 2 later steps" was asking the operator to
 * commit with no idea where three lines were about to appear.
 *
 * Walked NEWEST-FIRST and overwritten, which is the order the undo runs in: the
 * survivor takes part in every event of a convergence, and the landing it keeps
 * is the one the LAST (oldest) step gives it — the frame it was standing on
 * before the passage began.
 *
 * `barrier` is the other half of the same honesty. A hold-until barrier is NOT
 * re-armed by an undo (§8.4: restored lines land un-parked and phase-less, an
 * operator rewind being authoritative), so lines put back on a barrier frame
 * can walk straight off it and the rejoin replays as a co-presence merge rather
 * than the barrier release it was. Said in the confirm rather than discovered
 * mid-piece.
 *
 * `lineId` is the number the REJOIN recorded, the same basis as the button's
 * "merged here as L0, L1, L2" — not a promise about the number the line comes
 * back on. Undoing a passage frees the numbers its own cascade took, so the
 * two agree in every ordinary case; a fork on an unrelated population is not in
 * that cascade, and a route whose number it took is re-created on the lowest
 * free one instead (`freeLineId`). The FRAME is exact either way.
 *
 * @returns {{lineId: string, frame: string, sub: (string|null), barrier: boolean}[]}
 */
function mergeRestoreLandings(session, entry) {
  const landings = new Map();
  const holdUntil = (session.graph || {}).holdUntilTargets || {};
  for (const event of orch.mergeConvergenceEvents({
    mergeEvents: session.mergeEvents,
    eventId: entry.eventId,
  })) {
    for (const snapshot of event.participants || []) {
      if (!snapshot || !snapshot.lineId) continue;
      const route = absorbedRoute(session, event, snapshot);
      if (!route) continue;
      const frame = route.trail[route.trail.length - 1];
      landings.set(snapshot.lineId, {
        lineId: snapshot.lineId,
        frame,
        sub: route.sub || null,
        // Barriers live on the main flow only, so a landing inside a dive is
        // never one.
        barrier: !route.sub && (holdUntil[frame] || []).length > 0,
      });
    }
  }
  // By NUMBER, like every other list the operator reads: the walk above is
  // newest-first, which for a convergence that merged in pairs put the last
  // line to arrive in the middle.
  return [...landings.values()].sort(
    (a, b) => lineIdNum(a.lineId) - lineIdNum(b.lineId),
  );
}

/**
 * Devices a merge undo would have to spread, because they were not in the room
 * when the rejoin ran and so appear in no snapshot.
 *
 * Counts the OFFLINE ones too: `rewindMergeStructure` sweeps the registry the
 * same way it sweeps live connections, so counting connections alone let the
 * confirm say nothing at all while a dozen registered-but-absent devices were
 * about to be redistributed. Riders are excluded in both places — a spectator
 * is never population (decision #12).
 *
 * Reported as BOTH numbers, because the operator checks the one they are shown
 * against the room in front of them. A device that registered and left really
 * is about to be reassigned, so it belongs in the total — but counting it
 * silently made the confirm promise to spread four devices to an operator who
 * could see three performers, and a number that does not match the room is a
 * reason to distrust the whole gesture, mid-piece.
 *
 * @returns {{total:number, live:number}} everything the undo reassigns, and
 *   the subset that is connected right now.
 */
function mergeLatecomerCount(session, entry) {
  const known = new Set();
  for (const member of orch.mergeConvergenceEvents({
    mergeEvents: session.mergeEvents,
    eventId: entry.eventId,
  })) {
    for (const snapshot of member.participants || []) {
      for (const deviceId of (snapshot && snapshot.deviceIds) || []) {
        known.add(String(deviceId));
      }
    }
  }
  const live = wsServer.connections.filter(
    (conn) =>
      conn &&
      conn.sessionId === session.id &&
      conn.lineId === entry.survivorLineId &&
      !conn.isMapView &&
      conn.isStaff !== false &&
      !(conn.deviceId != null && known.has(String(conn.deviceId))),
  );
  // The same set `rewindMergeStructure` skips when sweeping the registry: a
  // device counted above must not be counted twice from its offline record.
  const liveIds = new Set(
    wsServer.connections
      .filter(
        (conn) =>
          conn &&
          conn.sessionId === session.id &&
          !conn.isMapView &&
          conn.deviceId != null,
      )
      .map((conn) => String(conn.deviceId)),
  );
  let offline = 0;
  for (const [deviceId, lineId] of Object.entries(
    session.deviceRegistry || {},
  )) {
    if (lineId !== entry.survivorLineId) continue;
    if (known.has(String(deviceId)) || liveIds.has(String(deviceId))) continue;
    offline++;
  }
  return { total: live.length + offline, live: live.length };
}

/**
 * The lines a merge swallowed that its undo can still bring back (owner): "we
 * should have the option to unmerge on those lines too".
 *
 * They are hard-retired, so they are in no count, no line panel and no
 * `lines[]` entry — and until now the map had nothing to hang an entry on
 * either: after a rejoin the only route on the canvas was the survivor's, so
 * `A1/A2` offered "rewind L0 here" while `B1/B2` and `C1/C2`, where the
 * operator actually watched L1 and L2 walk, offered nothing at all. The map
 * paints these as a GHOST route and offers the same per-line rewind on them;
 * `lineRewind` brings the line back out of the merge on the way (§8.2's rule,
 * applied to the line that was swallowed rather than the one that swallowed
 * it).
 *
 * `trail` is the trail the undo will RESTORE, not the one the merge recorded:
 * `preMergeLanding` steps a co-presence merge's snapshot back off the rejoin
 * frame, so the last entry is always the node the line will land on and every
 * entry is a legitimate destination. The window is the merge's own — the
 * moment it expires these lines are dropped from `lines[]` altogether and
 * their numbers go back in the pool.
 *
 * @param {object} session
 * @param {object[]} mergeRewinds the map's own merge entries, which decide
 *   WHICH passages are drawn — see the gate below.
 */
function absorbedLineSnapshots(session, mergeRewinds) {
  const out = [];
  // A route is ghosted for exactly the passages the map OFFERS an undo for —
  // the `mergeRewinds` entries, which have already answered that question for
  // the whole convergence AND for whatever cascade stands on it.
  //
  // This used to ask `mergeRewindPlan` again, which is a NARROWER question: a
  // plan refuses a merge with anything built on top of it (`superseded`), while
  // the entry beside it reads `available` because the undo walks that cascade
  // off first. A room that forked three ways, rejoined at Z and rejoined again
  // at B-prime therefore drew a ⏪⏪ badge on Z, offered the undo and named the
  // line it would bring back — and drew no route for that line at all, while
  // the two routes feeding the newer rejoin were greyed as usual. Two ghosts
  // where the operator had watched three lines walk in, and the missing one
  // was always the line swallowed by the older rejoin.
  //
  // The recycled-number worry the old gate carried is not what it was guarding:
  // a ghost route paints no number on the canvas (badges are built from the
  // live `lines[]` only), and the number a ghost's MENU names is kept honest by
  // the check below, which is the one that knows whether the room is playing an
  // "L1" today.
  const offered = new Set(
    (mergeRewinds || [])
      .filter((entry) => entry && entry.available)
      .map((entry) => entry.eventId),
  );
  for (const event of session.mergeEvents || []) {
    if (!event || event.status !== "active") {
      continue;
    }
    // Asked of this event in its own right, folded halves included: an older
    // half of a convergence always reads `superseded` alone, and one click
    // undoes the passage whole, so every line it brings back gets its route.
    if (!offered.has(event.id)) {
      continue;
    }
    for (const snapshot of event.participants || []) {
      if (!snapshot || snapshot.lineId === event.survivorLineId) {
        continue; // the survivor is a live line, already in lines[]
      }
      // The number this route walked under is free again the moment its merge
      // runs, so an unrelated fork may be holding it now. The undo would give
      // this line a different one, and a ghost cannot say which — so it stays
      // off the canvas and the rejoin node's own entry carries the passage.
      //
      // Asked of the lines the map DRAWS, which is what a ghost could be
      // confused with: `lines[]` is filtered to non-retired. A merge-absorbed
      // line whose object `pruneRetiredLines` keeps because an active split
      // still names it as its parent carries this very number — matching on
      // that hid the route the ghost is for, and explained nothing.
      if (
        (session.lines || []).some(
          (l) => l && l.id === snapshot.lineId && l.status !== "retired",
        )
      ) {
        continue;
      }
      const route = absorbedRoute(session, event, snapshot);
      if (!route) {
        continue;
      }
      out.push({
        id: snapshot.lineId,
        mergeEventId: event.id,
        mergeFrame: event.frame,
        survivorLineId: event.survivorLineId,
        // Same prefix rule as a live line's: a line absorbed mid-DIVE carries
        // the sub's trail and its ghost belongs inside that sub's box.
        sub: route.sub,
        trail: route.trail,
        // Where the undo alone would put it back — the ghost's "here".
        landing: route.trail[route.trail.length - 1],
      });
    }
  }
  return out;
}

/**
 * The route ONE merge snapshot gives back: the trail the undo will restore, not
 * the one the merge recorded. `preMergeLanding` steps a co-presence snapshot
 * back off the rejoin frame, so the last entry is always the node the line will
 * land on and every entry is a legitimate rewind destination.
 */
function absorbedRoute(session, event, snapshot) {
  const stepBack = orch.preMergeLanding({
    snapshot,
    mergeFrame: event.frame,
    frameIndexOf: orch.frameIndexResolver(session),
  });
  const history = Array.isArray(snapshot.history) ? snapshot.history : [];
  const at =
    snapshot.historyIndex == null ? history.length - 1 : snapshot.historyIndex;
  const trail = stepBack ? stepBack.history.slice() : history.slice(0, at + 1);
  if (trail.length === 0) {
    return null;
  }
  const top = (snapshot.subStack || [])[(snapshot.subStack || []).length - 1];
  return { trail, sub: top ? top.score : null };
}

/**
 * The merge snapshot a ghost rewind names — the line is not in `session.lines`
 * at all any more, so the record IS the line until the undo re-creates it.
 * Newest first, and narrowed to the event the map's entry was built from when
 * it names one.
 */
function absorbedSnapshotFor(session, lineId, eventId) {
  const events = (session.mergeEvents || []).filter(
    (event) =>
      event &&
      event.status === "active" &&
      (!eventId || String(event.id) === String(eventId)),
  );
  for (let i = events.length - 1; i >= 0; i--) {
    const event = events[i];
    if (event.survivorLineId === lineId) {
      continue;
    }
    const snapshot = (event.participants || []).find(
      (entry) => entry && entry.lineId === lineId,
    );
    if (!snapshot) {
      continue;
    }
    const route = absorbedRoute(session, event, snapshot);
    if (route) {
      return { event, snapshot, trail: route.trail };
    }
  }
  return null;
}

/**
 * Which rewind a payload names — the same shape `dispatchRewind` is told apart
 * by, read once so a gesture that THREW can still be answered in its own terms.
 */
function rewindKindOf(messageData) {
  if (messageData.splitEventId) return "split";
  if (messageData.mergeEventId) return "merge";
  if (messageData.group) return "room";
  if (messageData.exitSub) return "sub";
  return "line";
}

function rewindOperationIdOf(messageData) {
  const operationId = messageData && messageData.operationId;
  return typeof operationId === "string" && operationId.length <= 128
    ? operationId
    : null;
}

/**
 * Every rewind answers — including the one that fell over.
 *
 * `dispatchRewind` reports a refusal or a receipt down every path it takes,
 * and an exception was the one way past both: the dispatcher's own catch
 * logged it server-side and the operator was left with silence, which is
 * precisely the failure mode MSG_REWIND_REFUSED and MSG_REWIND_DONE exist to
 * remove — and the worst case of it, since a walk commits step by step and a
 * throw part-way through has almost certainly already moved the room. `moved:
 * true` says so rather than guessing otherwise, and the refusal clears the
 * sentence the map has been holding since the click.
 */
async function handleSelectHistory(conn, session, messageData) {
  // Collected by every merge undo this gesture runs — a walk takes several
  // events off — and read by the settlement below. Scoped to the message, so
  // the next ordinary landing settles the room by the usual rule.
  session.__justSeparated = new Set();
  try {
    await dispatchRewind(conn, session, messageData);
    // A rewind can stand a line on a node another line holds (a per-line
    // rewind onto an occupied frame, a room rewind's fill); one line per node.
    await settleCoLocatedLines(session);
  } catch (err) {
    console.error("rewind gesture failed", err);
    reportRewindRefusal(
      conn,
      session,
      rewindKindOf(messageData),
      "internal-error",
      messageData.frame || messageData.group || null,
      true,
      rewindOperationIdOf(messageData),
    );
  } finally {
    session.__justSeparated = null;
  }
}

/**
 * The five rewinds, told apart by their payload shape. The WebSocket message
 * dispatcher serializes this together with every other room mutation.
 */
async function dispatchRewind(conn, session, messageData) {
  const operationId = rewindOperationIdOf(messageData);
  // Taken before any of the five rewinds below runs, so each can report the
  // lines it left with nobody on them (`reportRewindDone`).
  const dormantBefore = session.hasSessionLines
    ? dormantLineKeys(session)
    : null;
  if (messageData.splitEventId && session.hasSessionLines) {
    // What the operator agreed to discard, checked before anything commits.
    if (
      !cascadeAgreed(
        messageData.cascade,
        structuralCascadeNow(session, "split", messageData.splitEventId),
      )
    ) {
      reportRewindRefusal(
        conn,
        session,
        "split",
        "stale-cascade",
        messageData.frame,
        false,
        operationId,
      );
      return;
    }
    const done = await splitRewind(
      session,
      messageData.splitEventId,
      messageData.frame,
    );
    if (!done.ok) {
      // Re-planned AFTER the attempt on purpose: what the operator needs is
      // why it is still not done, which for a walk that stopped part-way is
      // the step that stopped it, not the state the menu was built from.
      reportRewindRefusal(
        conn,
        session,
        "split",
        splitRefusalReason(
          session,
          messageData.splitEventId,
          messageData.frame,
        ),
        messageData.frame,
        done.moved,
        operationId,
      );
    } else {
      await reportRewindDone(
        session,
        "split",
        messageData.frame,
        linesLeftEmpty(session, dormantBefore),
        operationId,
      );
    }
    return;
  }
  // Structural merge undo: put the lines one rejoin swallowed back where they
  // stood, with the devices they had. `frame` is the race guard — the merge
  // frame the menu was built against.
  if (messageData.mergeEventId && session.hasSessionLines) {
    if (
      !cascadeAgreed(
        messageData.cascade,
        structuralCascadeNow(session, "merge", messageData.mergeEventId),
      )
    ) {
      reportRewindRefusal(
        conn,
        session,
        "merge",
        "stale-cascade",
        messageData.frame,
        false,
        operationId,
      );
      return;
    }
    const done = await mergeRewind(
      session,
      messageData.mergeEventId,
      messageData.frame,
    );
    if (!done.ok) {
      reportRewindRefusal(
        conn,
        session,
        "merge",
        mergeRefusalReason(
          session,
          messageData.mergeEventId,
          messageData.frame,
        ),
        messageData.frame,
        done.moved,
        operationId,
      );
    } else {
      await reportRewindDone(
        session,
        "merge",
        messageData.frame,
        linesLeftEmpty(session, dormantBefore),
        operationId,
      );
    }
    return;
  }
  if (messageData.group && session.hasSessionLines) {
    // The room rewind refuses as readily as the other three (a checkpoint
    // stops being common the moment a line leaves the group), and used to do
    // it in silence. It validates its whole plan — the rejoins it will walk
    // back through included — before touching a line, so it still refuses as a
    // clean no-op; `moved` is for the one case that cannot be clean, a rejoin
    // that came apart and a later one that would not. The rejoins it promised
    // to take off on the way (`restoredMergeClause`), re-derived — the room
    // can rejoin somewhere else while the confirm is up.
    if (
      messageData.cascade != null &&
      !cascadeAgreed(
        messageData.cascade,
        roomRewindUndoes(session, messageData.group),
      )
    ) {
      reportRewindRefusal(
        conn,
        session,
        "room",
        "stale-cascade",
        messageData.group,
        false,
        operationId,
      );
      return;
    }
    const outcome = await roomRewind(session, messageData.group);
    if (outcome.refusal) {
      reportRewindRefusal(
        conn,
        session,
        "room",
        outcome.refusal,
        messageData.group,
        outcome.moved,
        operationId,
      );
    } else {
      await reportRewindDone(
        session,
        "room",
        messageData.group,
        linesLeftEmpty(session, dormantBefore),
        operationId,
      );
    }
    return;
  }
  // Roll ONE line back out of its dive, onto any main-flow frame it has
  // already visited — payload-distinguished like the three rewinds around it.
  // `selectedIdx` indexes the line's MAIN trail; omitted, it means the frame
  // the line dived from. `frame` is the race guard.
  if (
    messageData.exitSub &&
    messageData.lineId != null &&
    session.hasSessionLines
  ) {
    // Same reasoning as the room rewind above: it validates everything off
    // the saved trail before touching the line, so a refusal is always a
    // clean no-op — but a silent one read as a broken button.
    const refusal = await rewindLineOutOfSub(
      session,
      messageData.lineId,
      messageData.sub,
      messageData.selectedIdx,
      messageData.frame,
    );
    if (refusal) {
      reportRewindRefusal(
        conn,
        session,
        "sub",
        refusal,
        messageData.frame,
        false,
        operationId,
      );
    } else {
      await reportRewindDone(
        session,
        "sub",
        messageData.frame,
        linesLeftEmpty(session, dormantBefore),
        operationId,
        messageData.lineId,
      );
    }
    return;
  }
  // Targeted per-line rewind (owner): an EXPLICIT, admin-only jump of one
  // NAMED line within its own active trail (main flow or its current sub
  // dive). `frame` is the race guard — it must still be the trail entry at
  // selectedIdx.
  if (messageData.lineId != null && session.hasSessionLines) {
    // The rejoins this rewind promised to walk back through, re-derived. Only
    // for a line that is still standing: a GHOST entry names a line that is not
    // in `session.lines` at all, and its own `absorbedEventId` + `frame` are
    // already the guard for the one merge it undoes.
    if (messageData.cascade != null && !messageData.absorbedEventId) {
      const target = (session.lines || []).find(
        (l) => l && l.id === messageData.lineId && l.status !== "retired",
      );
      if (
        target &&
        !cascadeAgreed(
          messageData.cascade,
          mergesBehindLineFolded(session, target, messageData.selectedIdx),
        )
      ) {
        reportRewindRefusal(
          conn,
          session,
          "line",
          "stale-cascade",
          messageData.frame,
          false,
          operationId,
        );
        return;
      }
    }
    // This rewind can take merges off on the way, and those commit before the
    // rest of it is checked — so a refusal here is not automatically a no-op.
    const progress = { moved: false };
    const refusal = await lineRewind(
      session,
      messageData.lineId,
      messageData.selectedIdx,
      messageData.frame,
      // A ghost entry names the merge its route came from: the line is not in
      // session.lines at all, so the event is how the server finds it.
      messageData.absorbedEventId,
      progress,
    );
    if (refusal) {
      reportRewindRefusal(
        conn,
        session,
        "line",
        refusal,
        messageData.frame,
        progress.moved,
        operationId,
      );
    } else {
      await reportRewindDone(
        session,
        "line",
        messageData.frame,
        linesLeftEmpty(session, dormantBefore),
        operationId,
        messageData.lineId,
      );
    }
    return;
  }
  // The IMPLICIT bound-line {selectedIdx} jump stays retired for session-lines
  // rooms: rewinds are the room-wide
  // {group} checkpoint rewind or the explicit {lineId} rewind above — the
  // clients no longer offer the implicit form, but don't trust them.
  // Vanilla scores keep {selectedIdx}: their single playhead IS the room.
  if (session.hasSessionLines) {
    return;
  }
  const line = lineForConn(session, conn);
  const { selectedIdx } = messageData;
  await jumpScoreForSession(session, line, selectedIdx);
  return;
}

async function messageHandle(conn, message) {
  const messageData = JSON.parse(message.utf8Data);
  // Proof this device's JS is still running — the protocol keepalive above only
  // proves its network stack is. Read back as quietSince in the lines payload.
  conn.lastSeen = Date.now();
  const sessionId = messageData.sid;
  const session = db.sessionTable.getById(sessionId);

  if (!session) {
    console.log(
      `Session with id ${sessionId} not found while processing message`,
    );
    return;
  }

  return session.runExclusively(() =>
    messageHandleExclusively(conn, messageData, session),
  );
}

// WebSocket callbacks are independent async roots. Once a room has been
// resolved, run the complete message on its mutation lane so performer taps,
// reconnect/revival, admin controls, and structural rewinds cannot interleave.
async function messageHandleExclusively(conn, messageData, session) {
  if (session.isSessionDeleted) return;
  const sessionId = messageData.sid;
  const clientIndex = messageData.cid;
  const password = messageData.sig;
  const msg = messageData.msg;

  // Session Lines: restore barrier bookkeeping after a restart (once, cheap).
  // Re-evaluate only AFTER the grace window — evaluating now would see zero
  // reconnected devices, so every missing target would appear unreachable.
  if (rehydrateBarriers(session)) {
    setTimeout(() => {
      session
        .runExclusively(async () => {
          if (session.isSessionDeleted) return;
          await tryReleaseBarriers(session);
          await tryReleaseGroupWaits(session);
        })
        .catch((e) => console.error("post-rehydrate barrier check error", e));
    }, ATTRITION_GRACE_MS);
  }

  const isAdmin = password === session.adminPassword;
  if (msg === MESSAGES.MSG_PING) {
    const { clientTime, did } = messageData;
    conn.sessionId = sessionId;
    conn.isAdmin = isAdmin;
    // The standalone /map page marks its connection (window.wsMapView): an
    // observation tool, excluded from all population counting.
    conn.isMapView = !!messageData.mapView;
    conn.isStaff =
      password === session.playerPassword || password === session.adminPassword;
    // Session Lines: bind this connection to its device id + line (restores the
    // device's line on reconnect; one line ⇒ lines[0]).
    await ensureLineAssignment(session, conn, did);

    sendToClient(conn, 0, {
      m: MESSAGES.MSG_PING,
      serverTime: Date.now(),
      clientTime,
    });
    return;
  }

  // Every message below this point acts on a ROOM, so it must come from a
  // socket this server has already bound to that room (`isBoundToSession`, and
  // the reasoning is there). MSG_PING is what binds it, above, and it is the
  // first thing every client sends.
  if (!isBoundToSession(conn, session.id)) {
    return;
  }

  // The spectator rule, server side (owner): "a rider is a spectator, and a
  // spectator can't affect the session in any way". A rider's page only ever
  // sends PING (handled above) and NEED_DISPLAY — its tap handler returns on
  // `!window.staffCode` and the operator controls are rendered for admins only
  // — so refusing everything else costs a legitimate rider nothing, and the
  // rule stops depending on the client to enforce it.
  if (conn.isStaff !== true && msg !== MESSAGES.MSG_NEED_DISPLAY) {
    return;
  }

  // The live/count snapshot only announces compact structural summaries. A
  // validated map connection asks for the heavy cascade/landing/trail detail
  // once per announced topology version.
  if (
    msg === MESSAGES.MSG_NEED_DISPLAY &&
    messageData.structuralDetails
  ) {
    if (isAdmin && conn.isMapView && session.hasSessionLines) {
      sendStructuralDetailsToMap(session, conn);
    }
    return;
  }

  if (msg === MESSAGES.MSG_TAP) {
    // A TAP is a PERFORMER's action, so it is answered for by a performer's
    // connection — see `canPerform` for what that means and why each part of
    // it is needed. The credentials are re-checked against THIS message, not
    // only against the handshake.
    const credentialsValid =
      password === session.playerPassword || password === session.adminPassword;
    if (!canPerform(conn, session.id, credentialsValid)) {
      return;
    }
    // …and it acts on the line this connection is BOUND to. `lineForConn`
    // falls back to the room's first active line for a connection with no
    // binding, which is the right answer for a display send and the wrong one
    // for a mutation: it would let a socket move a line it was never placed
    // on. A bound connection is what `ensureLineAssignment` guarantees at the
    // handshake, so a legitimate performer always has one.
    const line = session.lines.find(
      (l) => l.id === conn.lineId && l.status !== "retired",
    );
    if (!line) {
      return;
    }
    const { selectedId } = messageData;
    if (
      clientIndex !== line.currentIndex ||
      line.isHolding ||
      line.isBarrierWaiting ||
      line.isGroupWaiting ||
      session.isPause ||
      !Boolean(selectedId)
    ) {
      return;
    }

    // selectedId should have format: nextVoteId#currFileName#aEleIndex —
    // resolved against the frame the line is standing on, and refused outright
    // if it does not name a destination that frame offers.
    const targetIndex = validatedTapTarget(
      session,
      line,
      selectedId,
      messageData.ctx,
    );
    if (targetIndex == null) {
      return;
    }

    const { nextFrameHoldingDur } = messageData;
    line.nextFrameHoldingDur = nextFrameHoldingDur;
    // The window's length comes from the SCORE, not from the tap (see
    // landingVotingDur); the tap's own value is the fallback for a frame the
    // graph cannot answer for.
    const frameVotingDur = landingVotingDur(
      session,
      line,
      messageData.frameVotingDur,
    );
    // Session Lines: a tap on a split frame is a CHOICE — it must always open a
    // choice window (never the instant-advance path), so every device can pick.
    const splitFrame = isSplitFrame(session, line);
    if (
      !splitFrame &&
      (frameVotingDur === "0" ||
        frameVotingDur === "0%" ||
        frameVotingDur === "false" ||
        session.votingDuration === 0)
    ) {
      // STAY resolves to the frame the line is already on. There is no move to
      // make and no window to open, so the instant path is done. (Told apart
      // from a frame that genuinely links to ITSELF, which is an ordinary
      // advance and still plays its landing's hold.)
      if (String(selectedId).split("#")[0] === "stay") {
        return;
      }
      // Session Lines: an instant tap on a session-sub-start link dives (same
      // rule as a voted advance — choosing the link IS the dive).
      const subLink = subLinkForAdvanceTarget(session, line, targetIndex);
      if (subLink) {
        // No hold started here: the dive lands on the sub's START, and
        // enterSubSession starts THAT frame's holding period. This tap speaks
        // for the return landing — the frame the link names, reached only on
        // the way back out.
        await diveViaSubLink(session, line, subLink);
        return;
      }
      line.setCurrIdxTo(targetIndex);
      await session.saveSessionStateToFile();

      emitHistoryToAdmins(session, line);
      // Asked AFTER the move, of the frame the line is now on.
      if (holdsAtLanding(session, line)) {
        await startHoldingForSessionWithDelay(session, line, 0);
      }
      await showLineAfterArrivalIfNeeded(session, line);
      return;
    }

    //change vote of client to new value
    if (!line.isStandby) {
      if (!line.isVoting) {
        // A split's choice window must have a real duration even if the frame
        // declares voting="0"/"false" — fall back to the session default.
        const isZeroDur =
          frameVotingDur === "0" ||
          frameVotingDur === "0%" ||
          frameVotingDur === "false";
        let choiceDur = splitFrame && isZeroDur ? undefined : frameVotingDur;
        // …and never zero-length even when the SESSION default is 0 (decision
        // #2: bounded choice window — every device must get a chance to pick).
        if (
          splitFrame &&
          !(parseCustomDur(session.votingDuration, choiceDur) > 0)
        ) {
          choiceDur = String(DEFAULT_SPLIT_CHOICE_DUR);
        }
        // The tap travels with the window it opens: a split's opening push
        // already carries per-device destinations, and one computed without
        // this vote would tell the tapper it had been auto-assigned elsewhere.
        await startVotingForSessionWithDelay(
          session,
          line,
          100,
          choiceDur,
          false,
          { conn, voteId: selectedId },
        );
      }

      conn.currentVoteTo = selectedId;
      sendUpdateVotingToClient(conn, session, line);
    }
    return;
  }

  if (msg === MESSAGES.MSG_NEED_DISPLAY) {
    // Re-bind the device to its line (a reconnect re-pings then needs display;
    // restores membership via deviceRegistry — one line ⇒ lines[0]).
    const line = await ensureLineAssignment(session, conn, messageData.did);

    // This device may have just made its line populated (empty lines are not
    // waited for), which can make it a group's straggler — and changes who the
    // operator's panel should name. Re-derive + re-push before the banner
    // decision below, so the arriving device is told the truth. (A PLAYER
    // reconnecting matters here: the admin-only push further down fires just
    // for admins, which after a restart left the panel naming whoever happened
    // to have reconnected first.)
    notifyAdminsBarriers(session);

    // …and tell the device which line that is. MSG_LINE_ASSIGNED was only ever
    // sent when a line CHANGED under a device — a split, a rejoin, a
    // structural undo, a rider re-home — so a device that simply joined or
    // reconnected carried `window.lineId === null` for the rest of the session
    // while the operator panel had it placed correctly. Nothing functional
    // reads the global, but it is the first thing anyone reaches for when a
    // live room misbehaves, and a null there sends them hunting a binding bug
    // that does not exist. Riders included: a spectator is bound to the line
    // it watches, and its re-home already reports the same way.
    if (session.hasSessionLines) {
      sendDisplayToClient(session, conn, 0, {
        m: MESSAGES.MSG_LINE_ASSIGNED,
        lineId: line.id,
      });
    }

    // A /map tab is excluded: it renders no frames, keeps no sub view, and
    // tracks `showIdx` only so its own outgoing messages carry one. A snapshot
    // naming a sub would hand it a SUB-relative index to resolve against the
    // main flow — which is exactly why a dived line has always reached it as
    // MSG_SUB_ENTER, a message it ignores. It keeps that answer.
    if (session.hasSessionLines && !conn.isMapView) {
      // ONE authoritative picture, applied in one step by the client.
      //
      // The old answer was a handful of independent messages, each sent only
      // when its state was ON — so everything that was OFF was said by nothing
      // at all, and a reconnecting page kept whatever it had been left
      // holding. Three ways that showed:
      //
      //  - a device that disconnected inside a sub and reconnected after the
      //    line had returned to the main flow got a bare SHOW, which changes
      //    the index without restoring the main frame list — so a main-flow
      //    index was resolved against the sub's frames;
      //  - a device that missed a barrier release reconnected with its
      //    "waiting for other lines…" banner intact, because a release is a
      //    message and no message means "no change";
      //  - a PAUSED room sent no context-bearing message at all, so a page
      //    loaded during a pause had no idea it was mid-dive until the resume
      //    handed it a sub-relative index with no sub loaded.
      //
      // Every field is present on every snapshot, including the nulls and
      // falses — that is what makes it authoritative rather than additive.
      const top = line.subStack[line.subStack.length - 1];
      const straggler = line.stragglerFor
        ? stragglerBanner(session, line)
        : null;
      const waitingBanner =
        line.isBarrierWaiting || line.isGroupWaiting
          ? { role: "parked", frame: frameNameForLine(session, line) }
          : straggler
            ? {
                role: "straggler",
                frame: straggler.frame,
                group: straggler.group,
                barrier: straggler.barrier,
              }
            : null;
      if (line.isVoting) {
        conn.currentVoteTo = -1;
      }
      sendDisplayToClient(session, conn, 0, {
        // Carried on MSG_SHOW rather than a message type of its own: a new
        // constant would have to be published to the page, and the built HTML
        // is shared by vanilla scores, which must stay byte-identical. `snapshot`
        // is what tells the client this SHOW speaks for the whole display —
        // absent everywhere else, so an ordinary SHOW is unchanged.
        m: MESSAGES.MSG_SHOW,
        snapshot: true,
        lineId: line.id,
        // The score the frame index belongs to. `null` is main flow, and it is
        // SENT rather than implied: it is what takes a reconnecting page out
        // of a sub it is no longer in.
        sub: top ? top.score : null,
        showIdx: line.currentIndex,
        isPause: !!session.isPause,
        // The SM hold switch, which is a different thing from a running
        // holding period and has its own indicator.
        isHold: !!line.isHolding,
        holding:
          line.isHolding && line.currentEndHoldTimeStamp
            ? {
                endTime: line.currentEndHoldTimeStamp,
                duration: line.currentHoldingDuration,
              }
            : null,
        voting: line.isVoting
          ? {
              endTime: line.currentEndTimeStamp,
              duration: line.currentVotingDuration,
            }
          : null,
        waiting: waitingBanner,
      });
    } else {
      // Vanilla scores, and the /map tab above: the messages they have always
      // been answered with, unchanged.
      if (!session.isPause) {
        const inSub = session.hasSessionLines && line.subStack.length > 0;
        const top = line.subStack[line.subStack.length - 1];
        sendToClient(
          conn,
          0,
          inSub
            ? {
                m: MESSAGES.MSG_SUB_ENTER,
                sub: top.score,
                showIdx: line.currentIndex,
              }
            : { m: MESSAGES.MSG_SHOW, showIdx: line.currentIndex },
        );
      }

      if (line.isVoting) {
        conn.currentVoteTo = -1;
        sendToClient(conn, 0, {
          m: MESSAGES.MSG_BEGIN_VOTING,
          endTime: line.currentEndTimeStamp,
          duration: line.currentVotingDuration,
        });
      }

      if (line.isHolding) {
        sendToClient(conn, 0, {
          m: MESSAGES.MSG_BEGIN_HOLDING,
          endTime: line.currentEndHoldTimeStamp,
          duration: line.currentHoldingDuration,
        });
      }
    }

    if (isAdmin) {
      const historyPayload = {
        m: MESSAGES.MSG_SELECT_HISTORY,
        history: line.history,
        selectedIdx: line.historyIndex,
      };
      // Session Lines: always available:false — the implicit bound-line rewind
      // is retired, the dropdown is a read-only trail display;
      // room-checkpoint, targeted-line, and structural-split rewinds happen
      // from the score map. Omitted for vanilla scores → message
      // byte-identical to today.
      if (session.hasSessionLines) {
        historyPayload.available = false;
      }
      sendToClient(conn, 0, historyPayload);
      // Restore the admin's barrier force-release panel on reconnect.
      notifyAdminsBarriers(session);
    }

    updateNumberOfConnectionForSession(session);
    // Session Lines: the snapshot above already told the RECONNECTING device
    // its hold switch, its pause state and its frame, in one message and in
    // one revision. These used to be re-broadcast to the whole line as well,
    // which drove every other device's display — an unversioned MSG_PAUSE
    // carries a `showIdx` and repaints on it — because one of their number
    // reloaded a page. Nothing about a reconnect changes what the others are
    // showing, so nothing is sent to them. Vanilla keeps today's session-wide
    // pair exactly.
    if (!session.hasSessionLines) {
      sendToAllClients(session, 0, {
        m: MESSAGES.MSG_CHECK_HOLD,
        isHold: line.isHolding,
      });
      sendToAllClients(session, 0, {
        m: MESSAGES.MSG_PAUSE,
        isPause: session.isPause,
        showIdx: line.currentIndex,
      });
    }
    return;
  }

  // Below are only admin permisison msg
  if (!isAdmin) {
    return;
  }

  if (msg === MESSAGES.MSG_CHECK_HOLD) {
    const { isHold } = messageData;
    // Session Lines (Chunk M): SM hold is global — apply to EVERY line the
    // room still has (pause / global-refresh are already global). A vanilla
    // score has exactly one line, so this reduces to today's behavior.
    //
    // NON-RETIRED, not merely active, for the reason MSG_PAUSE below already
    // gives: a dormant line is one nothing counts as POPULATION stands on, and
    // it can be revived at any moment (#11). Skipping it here left it holding
    // `isHolding` from before a global hold-OFF, with no timer to end it — and
    // the first performer to revive it lands on a line whose taps MSG_TAP
    // drops in silence, with no way out but another toggle. The same
    // stale-hold wedge a mid-hold state restore produces, reached without a
    // restart.
    const targetLines = session.hasSessionLines
      ? nonRetiredLines(session)
      : session.lines;
    for (const line of targetLines) {
      if (line.isHolding && line.holdingTimer != null) {
        await cancelHoldingTimer(session, line, 0);
      }
      line.isHolding = isHold;
    }
    await session.saveSessionStateToFile();
    sendToAllClients(session, 0, {
      m: MESSAGES.MSG_CHECK_HOLD,
      isHold,
    });
    // Track-group hold sync: toggling hold OFF ends occupants' holding
    // periods, which can release a group that was waiting on them
    // (tryReleaseGroupWaits only releases, never parks — safe when toggling
    // ON). A hold-until barrier held open by a parked line's own unfinished
    // hold takes the same edge — and the SM toggle is the documented remedy
    // for a line left holding with no timer (state restored mid-hold).
    if (session.hasSessionLines) {
      await tryReleaseBarriers(session);
      await tryReleaseGroupWaits(session);
    }
    // Admin map: every line's holding flag just flipped without a landing.
    if (session.hasSessionLines) {
      updateNumberOfConnectionForSession(session);
    }
    return;
  }

  if (msg === MESSAGES.MSG_FINISH) {
    await db.sessionTable.forceSessionStop(session);
    sendToAllClientsWithDelay(session, 100, {
      m: MESSAGES.MSG_FINISH,
    });
    return;
  }

  if (msg === MESSAGES.MSG_PAUSE) {
    const line = lineForConn(session, conn);
    const { isPause } = messageData;
    await session.patchState({ isPause }, true);
    // Session Lines: pause is global, but each line must resume on ITS own
    // frame — a session-wide showIdx would yank every line to the admin's.
    //
    // EVERY non-retired line, not just the active ones: a line is "dormant"
    // when nothing on it counts as POPULATION (decision #12), which riders
    // never do — so a merge undo that hands a route back to a performer who
    // has gone home leaves a line carrying only spectators, and addressing the
    // active ones alone left those devices on a placeholder through the next
    // unpause, with no way back until someone joined the line. A dormant line
    // with nobody on it at all is simply a send to no one.
    if (session.hasSessionLines) {
      for (const l of nonRetiredLines(session)) {
        sendToLine(session, l.id, 0, {
          m: MESSAGES.MSG_PAUSE,
          isPause,
          showIdx: l.currentIndex,
        });
      }
    } else {
      sendToAllClients(session, 0, {
        m: MESSAGES.MSG_PAUSE,
        isPause,
        showIdx: line.currentIndex,
      });
    }
    return;
  }

  if (msg === MESSAGES.MSG_SELECT_HISTORY) {
    // One rewind at a time, per room. Every gesture below is a multi-step walk
    // over shared state — `undoStructuralChain`, a convergence, then the line
    // itself — with `await`s in the middle, and `connection.on("message")`
    // dispatches without waiting for the previous message to finish. Two
    // operator tabs clicking at once therefore interleaved: the second gesture
    // found `displayHold` already open, recorded its lines into the FIRST
    // gesture's hold, and then had nothing of its own to flush — so the devices
    // it moved last were never told where they ended up, which is exactly the
    // stranding `flushDisplayHold` exists to prevent, reached through timing
    // instead of ordering. Serialized here rather than inside the hold because
    // the same interleaving also lets one gesture commit between another's
    // validation and its own commit.
    return handleSelectHistory(conn, session, messageData);
  }

  if (msg === MESSAGES.MSG_GLOBAL_REFRESH) {
    sendToAllClients(session, 0, {
      m: MESSAGES.MSG_GLOBAL_REFRESH,
    });
    return;
  }

  // Session Lines (Chunk M): admin barrier force-release (defensive valve,
  // decision #12). The inbound MSG_BARRIER_RELEASED names the stuck barrier's
  // frame (or none → release all waiting barriers); reuses the Chunk J release
  // path. Inert for vanilla scores (no barriers).
  //
  // `{advance: true}` is the opposite resolution: don't let the barrier go
  // without its stragglers — bring the stragglers to the barrier. `{lineIds}`
  // narrows that to named lines, which is what the map's per-line "advance
  // this line" sends.
  //
  // `{eject: true, lineId, sub}` is not a barrier resolution at all — it pops
  // ONE line out of a sub-score onto that dive's return landing, with no
  // barrier involved — but it rides the same admin command, told apart by its
  // payload shape exactly as MSG_SELECT_HISTORY already carries four different
  // rewinds.
  if (msg === MESSAGES.MSG_BARRIER_RELEASED) {
    if (session.hasSessionLines) {
      // On the SAME queue as MSG_SELECT_HISTORY. Everything below is what that
      // message already is — an admin gesture that walks the room's shared
      // state over several `await`s — and the queue was put there because
      // `connection.on("message")` dispatches without waiting for the previous
      // message to finish. Serializing only the rewinds left the other half of
      // the same map's toolbar free to interleave with them:
      // `forceAdvanceStragglers` can reach `applyRecombine` and record a
      // rejoin on the very population a rewind validated its whole chain
      // against a moment earlier, and an eject can move a line out of a sub
      // between a walk's validation and its commit.
      if (messageData.eject) {
        await ejectLineFromSub(session, messageData.lineId, messageData.sub);
      } else if (messageData.advance) {
        await forceAdvanceStragglers(
          session,
          messageData.frame,
          messageData.lineIds,
        );
      } else {
        await forceReleaseBarrier(session, messageData.frame);
      }
      await settleCoLocatedLines(session);
    }
    return;
  }
}

/**
 * Tempo Database
 */

const db = new BMDatabase({ hostaddress });
db.adminUsername = "admin";
db.adminPassword = "g3tn3st3d";

/**
 * Admin data
 */

const adminDataFile = accountDir + "/admin.dat";
if (fs.existsSync(adminDataFile)) {
  var contents = fs.readFileSync(adminDataFile, "utf8");
  var lines = contents.split("\n");

  for (var i = 0; i < lines.length; i++) {
    var id = lines[i].trim();
    var user = lines[i + 1].trim();
    var pass = lines[i + 2].trim();
    var isActive = lines[i + 3].trim();
    i += 3;
    db.admin.add(id, user, pass, isActive);
  }
} else {
  console.log("Cound not find admin.dat. Creating a new one");
  db.admin.add("1", "kip", "123", "1");
  db.admin.dumpToFile(adminDataFile);
}

/**
 * Config
 */

const configDataFile = accountDir + "/db.dat";
if (fs.existsSync(configDataFile)) {
  const contents = fs.readFileSync(configDataFile, "utf8");
  const lines = contents.split("\n");

  db.shouldAutoRedirect = lines[0].trim() == "1" ? true : false;
  db.autoRedirectSession = lines[1].trim();
  db.autoRedirectPassword = lines[2].trim();
} else {
  console.log("Cound not find db.dat. Creating a new one");
  db.shouldAutoRedirect = false;
  db.autoRedirectSession = "";
  db.autoRedirectPassword = "";
  db.dumpToFile(configDataFile);
}

app.set("Database", db);
app.set("sendToAllClients", sendToAllClients);
app.set("sendToAllClientsWithDelay", sendToAllClientsWithDelay);
app.set("resetSessionConnections", resetSessionConnections);
